@namespace MudBlazor
@using MudBlazor.Utilities
@inherits MudComponentBase

@if (HasContent)
{
    <div @attributes="UserAttributes"
         role="separator"
         aria-orientation="@(Vertical ? "vertical" : null)"
         aria-labelledby="@_labelId"
         class="@WrapperClassname"
         style="@Style">
        <hr class="@Classname" aria-hidden="true"/>
        <span class="mud-divider-with-content-text" id="@_labelId">@ChildContent</span>
        <hr class="@Classname" aria-hidden="true"/>
    </div>
}
else
{
    <hr @attributes="UserAttributes" class="@Classname" style="@Style" />
}
