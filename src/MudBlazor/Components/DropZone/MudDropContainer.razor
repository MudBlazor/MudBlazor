@namespace MudBlazor
@inherits MudComponentBase
@typeparam T

<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Name="__MudDropContainerParent" Value="@((object)this)" IsFixed="true">
    	<div @attributes="UserAttributes"
    		 style="@Style"
    		 class="@Classname">
    		@ChildContent
    	</div>
    </CascadingValue>
</CascadingValue>
