@namespace MudBlazor
@inherits MudComponentBase

<MudPopover @ref="@_popover"
            Open="@_openSheetState.Value"
            Class="@PopoverClassname"
            Style="@PopoverStylename"
            AnchorOrigin="@Origin"
            TransformOrigin="@Origin"
            OverflowBehavior="OverflowBehavior.FlipNever"
            RelativeWidth="DropdownWidth.Ignore"
            UserAttributes="@(new Dictionary<string, object> { ["mudsheet"] = true })"
            Paper="false">
            <!-- If sheet is modal focus is brought to firstchild, which will be the sheet handle -->
    <MudFocusTrap DefaultFocus="@(Standard ? DefaultFocus.None : DefaultFocus.FirstChild)">
        <!-- Outer Sheet -->
        @{
            var userAttributes = UserAttributes;
            foreach (var attr in AriaAttributes)
            {
                userAttributes.TryAdd(attr.Key, attr.Value);
            }
        }
        <div id="@ElementId" class="@Classname" style="@Stylename" @attributes="@userAttributes" @onkeydown="@HandleKeyDownAsync">
            <!-- Sheet Handle (Toggle Button and Dragging) -->
            <div class="mud-sheet-handle" @onpointerdown="@HandlePointerDown" @onpointermove="@HandlePointerMove" @onpointerup="@HandlePointerUp">
                @SheetHandleFragment
            </div>
            <!-- Sheet Content -->
            <div class="mud-sheet-content">
                @ChildContent
            </div>
        </div>
    </MudFocusTrap>
</MudPopover>

<!-- Modal mode -->
@if (_openSheetState.Value && !Standard)
{
    <MudOverlay Visible="true"
                Class="@($"mud-{ElementId}")"
                LockScroll="true"
                AutoClose="true"
                Modal="true"
                DarkBackground="true"
                OnClosed="@CloseSheetAsync"/>
}

@code {
    private RenderFragment DefaultHandleFragment => 
        @<MudIconButton Icon="@DragHandle" Class="mud-sheet-handle-button" OnClick="@ToggleSize" aria-controls="@ElementId" />;
}

