@namespace MudBlazor
@typeparam T
@inherits MudComponentBase
@attribute [CascadingTypeParameter(nameof(T))]

<div @attributes="UserAttributes" class="@Classname" style="@Style" role="group">
    <CascadingValue IsFixed="true" Value="this">
        <CascadingValue Name="__MudChipSetParent" IsFixed="true" Value="@((object)this)">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</div>
