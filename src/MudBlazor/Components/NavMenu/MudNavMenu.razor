@namespace MudBlazor
@inherits MudComponentBase

<nav @attributes="UserAttributes"
     id="@NavigationContext?.MenuId"
     class="@Classname"
     style="@Style">
    <CascadingValue Value="@this">
        <CascadingValue Value="@NavigationContext">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</nav>
