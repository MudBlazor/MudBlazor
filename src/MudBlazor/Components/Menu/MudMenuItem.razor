@namespace MudBlazor
@using Microsoft.AspNetCore.Components.Rendering
@inherits MudComponentBase

@if (GetHtmlTag() == "a")
{
    <a class="@Classname"
       style="@Style"
       href="@Href"
       target="@Target"
       role="menuitem"
       @attributes="UserAttributes"
       @onclick="OnClickHandlerAsync"
       tabindex="@(!GetDisabled() ? "0" : "-1")"
       aria-disabled="@(GetDisabled() ? "true" : "false")"
       @onclick:stopPropagation="true"
       @onclick:preventDefault="@GetDisabled()"
       @ref="ElementReference">@{ RenderContent(__builder); }</a>
}
else
{
    <div class="@Classname"
         style="@Style"
         href="@Href"
         target="@Target"
         role="menuitem"
         @attributes="UserAttributes"
         @onclick="OnClickHandlerAsync"
         tabindex="@(!GetDisabled() ? "0" : "-1")"
         aria-disabled="@(GetDisabled() ? "true" : "false")"
         @onclick:stopPropagation="true"
         @onclick:preventDefault="@GetDisabled()"
         @ref="ElementReference">@{ RenderContent(__builder); }</div>
}

@code {
    private void RenderContent(RenderTreeBuilder __builder)
    {
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Class="mud-menu-item-icon"
                     Icon="@Icon"
                     Color="IconColor"
                     Disabled="GetDisabled()" />
        }

        <MudText Class="mud-menu-item-text"
                 Typo="GetTypo()">
            @if (ChildContent is null)
            {
                @Label
            }
            else
            {
                @ChildContent
            }
        </MudText>

        @if (ActivatesSubMenu && !HideSubMenuArrow)
        {
            <MudIcon Class="mud-menu-submenu-icon"
                     Icon="@(RightToLeft ? Icons.Material.Filled.ArrowLeft : Icons.Material.Filled.ArrowRight)"
                     Disabled="GetDisabled()" />
        }
    }
}
