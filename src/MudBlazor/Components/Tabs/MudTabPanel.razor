@namespace MudBlazor
@inherits MudComponentBase
@implements IAsyncDisposable

@if (Parent?.KeepPanelsAlive == true)
{
	<div @attributes="UserAttributes" class="@Classname" style="@Stylename" role="tabpanel" tabindex="0" id="@Parent.GetTabPanelId(this)" aria-labelledby="@Parent.GetTabId(this)">
        @ChildContent
    </div>
}
else
{
    @if (Parent?.ActivePanel == this)
    {
		<div @attributes="UserAttributes" class="@Classname" style="@Stylename" role="tabpanel" tabindex="0" id="@Parent.GetTabPanelId(this)" aria-labelledby="@Parent.GetTabId(this)">
            @ChildContent
        </div>
    }
}
