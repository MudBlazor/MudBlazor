@namespace MudBlazor
@inherits MudComponentBase
@implements IAsyncDisposable

@if (Parent?.KeepPanelsAlive == true)
{
    <div @attributes="UserAttributes" class="@Classname" style="@Stylename" role="tabpanel" tabindex="0">
        @ChildContent
    </div>
}
else
{
    @if (Parent?.ActivePanel == this)
    {
		<div role="tabpanel" tabindex="0">
            @ChildContent
        </div>
    }
}
