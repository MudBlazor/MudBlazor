@namespace MudBlazor
@inherits MudComponentBase

<div @ref="_componentRef" @attributes="UserAttributes" class="@Classname" style="@Style"
     @onpointerdown="OnPointerDown" @onpointerdown:stopPropagation="true"
     @onpointerup="OnPointerUp" @onpointerup:stopPropagation="true"
     @onpointercancel="OnPointerCancel" @onpointercancel:stopPropagation="true"
     @onpointermove="OnPointerMove" @onpointermove:stopPropagation="true"
     @onpointerleave="OnSwipeLeave" @onpointerleave:stopPropagation="true">
    @ChildContent
</div>
