@namespace MudBlazor
@using MudBlazor.Resources
@inherits MudComponentBase
@typeparam T
@inject InternalMudLocalizer Localizer

<MudToolBar @attributes="UserAttributes" Class="@Classname" Style="@Style">
    <div class="mud-table-pagination-spacer"></div>
    @if (PageSizeSelector)
    {
        <MudText Typo="Typo.body2" Class="mud-table-pagination-caption" id="@_rowsPerPageLabelId">
            @RowsPerPageString
        </MudText>
        <MudSelect T="int" ValueChanged="@SetRowsPerPageAsync" Value="@(DataGrid?.RowsPerPage ?? 0)" Class="mud-table-pagination-select" Underline="false" Dense="true" Disabled="@Disabled" SelectionOnEnter="true" aria-labelledby="@_rowsPerPageLabelId">
            @foreach (int pageSize in PageSizeOptions)
            {
                if (pageSize == int.MaxValue)
                {
                    <MudSelectItem T="int" Value="@pageSize">@AllItemsText</MudSelectItem>
                }
                else 
                {
                    <MudSelectItem T="int" Value="@pageSize">@pageSize.ToString().ToUpper()</MudSelectItem>
                }
            }
        </MudSelect>
    }

    @if (ShowPageNumber)
    {
        <MudText Typo="Typo.body2" Class="mud-table-pagination-caption" translate="no">
            @Info
        </MudText>
    }
    
    @if (ShowNavigation)
    {
        <div class="mud-table-pagination-actions">
            <MudPagination Class="@PaginationClassname"
                           ShowFirstButton="true"
                           ShowLastButton="true"
                           ShowPageButtons="@ShowPageButtons"
                           Count="@PageCount"
                           Selected="@CurrentPageNumber"
                           SelectedChanged="@(pageNumber => DataGrid?.NavigateTo(pageNumber - 1))"
                           Variant="@PaginationVariant"
                           Size="@PaginationSize"
                           Color="@PaginationColor"
                           Disabled="@Disabled"
                           FirstButtonAriaLabel="@Localizer[LanguageResource.MudDataGridPager_FirstPage]"
                           PreviousButtonAriaLabel="@Localizer[LanguageResource.MudDataGridPager_PreviousPage]"
                           NextButtonAriaLabel="@Localizer[LanguageResource.MudDataGridPager_NextPage]"
                           LastButtonAriaLabel="@Localizer[LanguageResource.MudDataGridPager_LastPage]" />
        </div>
    }

</MudToolBar>
