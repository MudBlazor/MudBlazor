@namespace MudBlazor
@inherits MudComponentBase
@typeparam T
@using System.Diagnostics.CodeAnalysis
@using MudBlazor.Utilities

<tr class="mud-table-row">
    <td class="@GroupClassname" colspan="1000" style="@GroupStylename">
        <div style="display:flex; align-items:center;">
            <MudIconButton Icon="@(Expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                           OnClick="@(() => { Expanded = !Expanded; GroupDefinition.Expanded = Expanded; StateHasChanged(); })" />
            @if (GroupDefinition.GroupTemplate == null)
            {
                <span style="font-weight:bold">@GroupDefinition.Title: @Items.Key</span>
            }
            else
            {
                @GroupDefinition.GroupTemplate(GroupDefinition)
            }
        </div>
    </td>
</tr>

@if (Expanded)
{
    <!-- The last group will have items, otherwise we need the next group row -->
    @if (GroupDefinition.InnerGroup != null)
    {
        <DataGridGroupRow T="T" Items="@GroupDefinition.InnerGroup.Grouping"
                          GroupDefinition="GroupDefinition.InnerGroup"
                          GroupClass="@GroupClass"
                          GroupStyle="@GroupStyle"
                          GroupClassFunc="@GroupClassFunc"
                          GroupStyleFunc="@GroupStyleFunc"
                          DataGrid="@DataGrid" />
    }
    <!-- Show the items -->
    else
    {
                <DataGridVirtualizeRow T="T" 
                                       DataGrid="@DataGrid"
                                       GroupedItems="@GroupDefinition.Grouping" />
        <!-- Group Footer -->
        <tr class="mud-table-row">
            @DataGrid.FooterCells(Items)
        </tr>
    }
}
