@namespace MudBlazor
@inherits MudComponentBase

<MudButtonGroup Class="@Classname"
                Style="@Style"
                Tag="@Tag"
                UserAttributes="@UserAttributes"
                Color="@Color"
                Size="@Size"
                Variant="@Variant"
                DropShadow="@DropShadow"
                FullWidth="@FullWidth">
    <MudButton Class="mud-split-button-primary"
               StartIcon="@StartIcon"
               EndIcon="@EndIcon"
               ButtonType="@ButtonType"
               Href="@Href"
               Target="@Target"
               Rel="@Rel"
               Disabled="@Disabled"
               Ripple="@Ripple"
               DropShadow="@DropShadow"
               OnClick="@OnClick">
        @if (ButtonContent is not null)
        {
            @ButtonContent
        }
        else
        {
            @Label
        }
    </MudButton>
    <MudMenu Class="mud-split-button-toggle"
             Icon="@ToggleIcon"
             AriaLabel="@ToggleAriaLabel"
             Color="@Color"
             Size="@Size"
             Variant="@Variant"
             Disabled="@(Disabled || ToggleDisabled)"
             Ripple="@Ripple"
             DropShadow="@DropShadow"
             Dense="@Dense"
             AnchorOrigin="@AnchorOrigin"
             TransformOrigin="@TransformOrigin"
             PopoverClass="@PopoverClass"
             ListClass="@ListClass"
             Open="@_openState.Value"
             OpenChanged="@OnMenuOpenChangedAsync">
        @ChildContent
    </MudMenu>
</MudButtonGroup>
