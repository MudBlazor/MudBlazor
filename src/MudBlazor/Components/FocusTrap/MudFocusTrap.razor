@namespace MudBlazor
@inherits MudComponentBase

<div @ref="_root"
     @attributes="UserAttributes"
     class="@Classname"
     style="@Style"
     tabindex="-1">

    <div @ref="_top" class="fixed pointer-events-none" tabindex="@TrapTabIndex">
    </div>

    <div @ref="_firstBumper"
         class="fixed pointer-events-none"
         tabindex="@TrapTabIndex">
    </div>

    <div @ref="_fallback"
         class="fixed pointer-events-none"
         tabindex="-1">
    </div>

    <div class="mud-focus-trap-child-container outline-none"
         tabindex="-1">
        @ChildContent
    </div>

    <div @ref="_lastBumper"
         class="fixed pointer-events-none"
         tabindex="@TrapTabIndex">
    </div>

    <div @ref="_bottom" class="fixed pointer-events-none" tabindex="@TrapTabIndex">
    </div>
</div>
