@namespace MudBlazor
@typeparam T
@inherits MudComponentBase
@implements IDisposable

<button type="button"
        @onclick="ToggleSortDirection"
        disabled="@(!Enabled)"
        class="@Classname"
        style="@Style"
        @attributes="@UserAttributes">
    @if (!AppendIcon)
    {
        @ChildContent
    }
    @if (Enabled)
    {
        <MudIcon Icon="@SortIcon" Class="@SortIconClassname" />
    }
    @if (AppendIcon)
    {
        @ChildContent
    }
</button>
