@namespace MudBlazor
@inherits MudComponentBase
@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]

<div @attributes="GetUserAttributes()"
     class="@Classname"
     style="@Style">
    <CascadingValue Value="@this" IsFixed="true">
        <CascadingValue Name="__MudListParent" Value="@((object)this)" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
</div>
