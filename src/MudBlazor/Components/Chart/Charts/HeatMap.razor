@namespace MudBlazor.Charts
@using System.Globalization;
@inherits MudCategoryChartBase
<svg @attributes="UserAttributes" class="mud-chart-heat mud-ltr" width="@MudChartParent?.Width" height="@MudChartParent?.Height" viewBox="0 0 650 350">
    @if (_options?.EnableSmoothGradient ?? false)
    {
        <defs>
            @* 4-point gradients for each cell *@
            @for (int row = 0; row < _series.Count; row++)
            {
                for (int col = 0; col < _series[row].Data.Length; col++)
                {
                    var cell = _heatmapCells.FirstOrDefault(c => c.Row == row && c.Column == col);
                    var color = GetColorForValue(cell?.Value);

                    // Define each gradient for 4 directions

                    <linearGradient id="gradient-topcenter-@row-@col" x1="50%" y1="0%" x2="50%" y2="50%">
                        <stop offset="0%" style="stop-color:@GetColorForValue(GetNeighborValue(row - 1, col))" />
                        <stop offset="100%" style="stop-color:@color" />
                    </linearGradient>

                    <linearGradient id="gradient-right-@row-@col" x1="100%" y1="50%" x2="50%" y2="50%">
                        <stop offset="0%" style="stop-color:@GetColorForValue(GetNeighborValue(row, col + 1))" />
                        <stop offset="100%" style="stop-color:@color" />
                    </linearGradient>

                    <linearGradient id="gradient-bottomcenter-@row-@col" x1="50%" y1="100%" x2="50%" y2="50%">
                        <stop offset="0%" style="stop-color:@GetColorForValue(GetNeighborValue(row + 1, col))" />
                        <stop offset="100%" style="stop-color:@color" />
                    </linearGradient>

                    <linearGradient id="gradient-left-@row-@col" x1="0%" y1="50%" x2="50%" y2="50%">
                        <stop offset="0%" style="stop-color:@GetColorForValue(GetNeighborValue(row, col - 1))" />
                        <stop offset="100%" style="stop-color:@color" />
                    </linearGradient>
                }
            }
        </defs>
    }

    @for (int row = 0; row < _series.Count; row++)
    {
        var padding = PaddingAll;
        if (_options?.EnableSmoothGradient ?? false)
        {
            padding = 0;
        }
        if (!_series[row].Visible) continue;
        var rowLabel = _series[row].Name;
        var rowHeight = Math.Max(MinSize, 
            (BoundHeight - VerticalStartSpace - VerticalEndSpace - (padding * (RowCount - 1))) 
            / 
            (RowCount + (_options?.ShowLegend == true ? 1 : 0)));
        var y = (row * (rowHeight + padding)) + VerticalStartSpace;

        <g transform="translate(5, @(y + rowHeight / 2))">
            <text x="0" y="0" dominant-baseline="middle" fill="black" font-size="12">@rowLabel</text>
        </g>

        @for (int col = 0; col < _series[row].Data.Length; col++)
        {
            var cell = _heatmapCells.FirstOrDefault(c => c.Row == row && c.Column == col);
            var cellWidth = Math.Max(MinSize, (BoundWidth - HorizontalStartSpace - HorizontalEndSpace - padding * (SeriesLength - 1)) / SeriesLength);
            var x = (col * (cellWidth + padding)) + HorizontalStartSpace;

            // Gradient Overlays
            @if (_options?.EnableSmoothGradient ?? false)
            {
                // Apply the 4 gradient overlays with partial opacity
                <rect x="@x" y="@y" width="@cellWidth" height="@rowHeight" fill="url(#gradient-topcenter-@row-@col)" opacity="0.25" />
                <rect x="@x" y="@y" width="@cellWidth" height="@rowHeight" fill="url(#gradient-right-@row-@col)" opacity="0.25" />
                <rect x="@x" y="@y" width="@cellWidth" height="@rowHeight" fill="url(#gradient-bottomcenter-@row-@col)" opacity="0.25" />
                <rect x="@x" y="@y" width="@cellWidth" height="@rowHeight" fill="url(#gradient-left-@row-@col)" opacity="0.25" />
            }

            // Cell with solid background, text label if needed and tooltip if needed
            <g>
                <rect x="@x" y="@y" width="@cellWidth" height="@rowHeight" 
                    fill="@(_options?.EnableSmoothGradient ?? false ? "transparent" : GetColorForValue(cell?.Value))" />

                @if (_options?.ShowToolTips ?? false && cell?.Value != null)
                {
                    <title>@cell.Value.ToString()</title>
                }

                @if (_options?.ShowLabels ?? false && cell?.Value != null)
                {
                    @((MarkupString)GetTextLabel(x + cellWidth / 2, y + rowHeight / 2, cell?.Value))
                }
            </g>

            @if (row == 0 && _options?.XAxisLabelPosition == XAxisLabelPosition.Top && col < XAxisLabels.Length)
            {
                <g transform="translate(@(x + cellWidth / 2), @(y - 15))">
                    <text x="0" y="0" text-anchor="middle" fill="black" font-size="12">@XAxisLabels[col]</text>
                </g>
            }
            else if (row == RowCount - 1 && _options?.XAxisLabelPosition == XAxisLabelPosition.Bottom && col < XAxisLabels.Length)
            {
                <g transform="translate(@(x + cellWidth / 2), @(y + rowHeight + 15))">
                    <text x="0" y="0" text-anchor="middle" fill="black" font-size="12">@XAxisLabels[col]</text>
                </g>
            }
        }
    }
    @if (_options?.ShowLegend ?? false)
    {
        <g transform="translate(480, 330)">
            <text x="0" y="0" dx="-8" dominant-baseline="middle" fill="black" font-size="7.2">Less</text> 
            @for (int i = 0; i < _legends.Count; i++)
            {
                var x = 16 + (i * 13); 
                <g>
                    <title>@_legends[i].value</title>
                    <rect x="@x" y="-8" width="12" height="12" fill="@_legends[i].color" />
                    @if (_options?.ShowLabels ?? false)
                    {
                        <g transform="translate(@x, 0)">
                            <text x="0" y="0" dominant-baseline="middle" text-anchor="middle" fill="black" font-size="7.2">
                                @(FormatValueForDisplay(_legends[i].value))
                            </text>
                        </g>
                    }
                </g>
            }
            <text x="@(16 + (_legends.Count * 13) + 8)" y="0" dominant-baseline="middle" fill="black" font-size="7.2">More</text>
        </g>
    }
</svg>
<br/>
RowCount: @RowCount
<br />
SeriesLength: @SeriesLength