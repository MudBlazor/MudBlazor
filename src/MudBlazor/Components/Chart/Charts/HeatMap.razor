@namespace MudBlazor.Charts
@using System.Globalization;
@inherits MudCategoryChartBase

<svg width="@BoundWidth" height="@BoundHeight">
    <!-- Loop through each row in the heatmap -->
    @for (int row = 0; row < _series.Count; row++)
    {
        var rowLabel = _series[row].Name; // Row label for the current series
        var y = row * (BoundHeight / _series.Count) + VerticalStartSpace;

        <!-- Row Label -->
        <g transform="translate(0, @y)">
            <rect x="0" y="0" width="30" height="20" fill="lightgray" />
            <text x="5" y="15" fill="black" font-size="12">@rowLabel</text>
        </g>

        <!-- Loop through each cell in the row -->
        @for (int col = 0; col < _series[row].Data.Length; col++)
        {
            var cell = _heatmapCells.FirstOrDefault(c => c.Row == row && c.Column == col);
            var cellColor = GetColorForValue(cell?.Value);
            var cellWidth = BoundWidth / _series[row].Data.Length;
            var cellHeight = BoundHeight / _series.Count;
            var x = col * cellWidth + HorizontalStartSpace;

            <!-- Draw each heatmap cell as a colored rectangle -->
            <rect x="@x" y="@y" width="@cellWidth" height="@cellHeight" fill="@cellColor" />
        }
    }

    <!-- Optional Column Labels -->
    @if (_options?.ShowLegend ?? false)
    {
        @for (int col = 0; col < XAxisLabels.Length; col++)
        {
            var colLabel = XAxisLabels[col];
            var x = col * (BoundWidth / _verticalValues.Count) + HorizontalStartSpace;

            <!-- Draw column label -->
            <g transform="translate(@x, @BoundHeight)">
                <rect x="0" y="0" width="30" height="20" fill="lightgray" />
                <text x="5" y="15" fill="black" font-size="12" text-anchor="middle">@colLabel</text>
            </g>
        }
    }
</svg>
