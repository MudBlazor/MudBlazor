@namespace MudBlazor.Charts
@inherits MudRadialChartBase<PieChartOptions>

<div class="@(MudChartParent is null ? Classname : string.Empty)">
    <BaseRadialChart TChartOptions="PieChartOptions"
                     ElementRefChanged="SetElementReference"
                     Width="@(MudChartParent?.Width ?? Width)"
                     Height="@(MudChartParent?.Height ?? Height)"
                     Radius="@CalculatedRadius"
                     ChartClass="mud-chart-pie"
                     ChartSeries="@ChartSeries"
                     ChartLabels="@ChartLabels"
                     ChartOptions="@ChartOptions"
                     Paths="@_paths"
                     CustomGraphics="@(MudChartParent?.CustomGraphics ?? CustomGraphics)"
                     HoveredSegment="@_hoveredSegment"
                     UserAttributes="@UserAttributes"
                     TooltipTemplate="@(MudChartParent?.TooltipTemplate ?? TooltipTemplate)"
                     TooltipPositionFunc="@(MudChartParent?.TooltipPositionFunc ?? TooltipPositionFunc)"
                     OnPathClick="async (i) => await SetSelectedIndexAsync(i)"
                     OnMouseOver="(x) => OnSegmentMouseOver(x.Args, x.Segment)"
                     OnMouseOut="() => OnSegmentMouseOut()" />

    <Legend Data="@_legends" ShowLegend="@ChartOptions?.ShowLegend" CanHideSeries="@CanHideSeries"
            ChartPalette="@ChartOptions?.ChartPalette" OnLegenedSelected="async (i) => await SetSelectedIndexAsync(i)" />
</div>
