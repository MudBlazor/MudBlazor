@namespace MudBlazor.Charts

@typeparam TChartOptions where TChartOptions : IRadialChartOptions, new()

@{
    var style = HoveredSegment is not null ? "overflow: visible;" : "";
}

<svg @ref="_svgRef" @attributes="UserAttributes" class="@ChartClass" width="@MudChartParent?.Width" height="@MudChartParent?.Height" viewBox="0 0 @(ToS(Radius * 2)) @(ToS(Radius * 2))" style="@style">
    <Filters />

    <g transform="translate(@Radius.ToS(), @Radius.ToS())">
        @foreach (var item in Paths)
        {
            <path @onclick="() => OnPathClick.InvokeAsync(item.Index)"
            class="mud-chart-serie"
            fill="@GetColor(item.Index)"
            d="@item.Data"
            @onmouseover="() => OnMouseOver.InvokeAsync(item)"
            @onmouseout="() => OnMouseOut.InvokeAsync()">
            </path>
        }
    </g>

    @MudChartParent?.CustomGraphics

    @if (HoveredSegment is not null && MudChartParent?.ChartOptions?.ShowToolTips is true)
    {
        var color = GetColor(HoveredSegment.Index);

        var (tooltipX, tooltipY) = TooltipPositionFunc?.Invoke(HoveredSegment) is { } pos
                ? (pos.X, pos.Y)
                : (HoveredSegment.LabelX + Radius, HoveredSegment.LabelY + Radius);

        if (TooltipPositionFunc is not null)
        {
            var tooltipPosition = TooltipPositionFunc.Invoke(HoveredSegment);
            tooltipX = tooltipPosition.X;
            tooltipY = tooltipPosition.Y;
        }


        if (TooltipTemplate is not null)
        {
            <g class="mud-chart-tooltip" transform="translate(@tooltipX.ToS(), @tooltipY.ToS())">
                @TooltipTemplate((HoveredSegment, color))
            </g>
        }
        else
        {
            <ChartTooltip Title="@TooltipFormat.title"
                          Subtitle="@TooltipFormat.subtitle"
                          Color="@color"
                          X="@tooltipX"
                          Y="@tooltipY" />
        }
    }
</svg>

<Legend Data="@Legends" />

@code {
    private ElementReference _svgRef;

    [CascadingParameter] 
    private MudChart MudChartParent { get; set; }
    
    [Parameter]
    [EditorRequired]
    public double Radius { get; set; }
    
    [Parameter] 
    public string ChartClass { get; set; }

    [Parameter] 
    public SvgPath HoveredSegment { get; set; }
    
    [Parameter] 
    [EditorRequired]
    public List<SvgPath> Paths { get; set; } = [];
    
    [Parameter] 
    public List<SvgLegend> Legends { get; set; } = [];
    
    [Parameter] 
    public Dictionary<string, object> UserAttributes { get; set; } = [];

    [Parameter]
    public (string title, string subtitle) TooltipFormat { get; set; }

    [Parameter] 
    public EventCallback OnMouseOut { get; set; }
    
    [Parameter] 
    public EventCallback<int> OnPathClick { get; set; }
    
    [Parameter] 
    public EventCallback<SvgPath> OnMouseOver { get; set; }
    
    [Parameter] 
    public EventCallback<ElementReference> ElementRefChanged { get; set; }

    [Parameter]
    public RenderFragment<(SvgPath Segment, string Color)> TooltipTemplate { get; set; }

    [Parameter]
    public Func<SvgPath, (double X, double Y)> TooltipPositionFunc { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ElementRefChanged.InvokeAsync(_svgRef);
    }

    private string GetColor(int index) =>
        MudChartParent?.ChartOptions.ChartPalette
            .GetValue(index % MudChartParent.ChartOptions.ChartPalette.Length)?
            .ToString() ?? string.Empty;
}
