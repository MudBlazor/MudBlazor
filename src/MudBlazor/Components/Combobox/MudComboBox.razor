@namespace MudBlazor
@inherits MudComponentBase
@typeparam T
<!--  TODO: Implement Bottom Sheets for XS screens -->
<!-- Material 3 ComboBox specificiations from menu:  https://m3.material.io/components/menus/  -->
<MudTextField @ref="_searchField"
			  Disabled="@Disabled"
              ReadOnly="@ReadOnly"
			  ValueChanged="ComboBoxValueChanged"
			  Value="@_comboBoxValueState.Value"
			  Variant="@Variant"
			  Immediate="@Immediate"
			  @onfocus="@FocusOnEnterAsync"
			  @onblur="@BlurredAsync"
			  Placeholder="@PlaceHolder"
              ShrinkLabel="@ShrinkLabel"
              HelperTextOnFocus="@HelperTextOnFocus"
			  Label="@Label"
			  FullWidth="false"
              Margin="@(Dense ? Margin.Dense : MudGlobal.InputDefaults.Margin)"
			  OnKeyDown="@KeyDown"
			  HelperText="@HelperText"
			  Adornment="Adornment.End"
			  AdornmentIcon="@(_comboBoxValueState.Value.Length > 0 ? Icons.Material.Filled.Clear : string.Empty)"
			  OnAdornmentClick="@ComboBoxValueClear" />

@if (_openItemListState)
{
    <MudPopover Open="_openItemListState" Class="@PopoverClass" MaxHeight="@MaxHeight"
                AnchorOrigin="@AnchorOrigin" TransformOrigin="@TransformOrigin" 
                Fixed="DropdownSettings.Fixed" OverflowBehavior="DropdownSettings.OverflowBehavior" 
                RelativeWidth="@RelativeWidth">
        <CascadingValue Value="this">
            @if (BeforeItemsTemplate is not null)
            {
                <div class="mud-combobox-before-items pa-1">
                    @BeforeItemsTemplate;
                </div>
            }
            <MudList Class="mud-combobox-list" T="T" Dense="@Dense" SelectionMode="@MultiSelection">
                @if (FilteredItems.Count > 0)
                {
                    @foreach (var item in FilteredItems)
                    {
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(item);
                        }
                        <MudListItem OnClick="@(() =>ComboBoxToggleItem(@item))" 
                                     Text="@item!.ToString()" />
                    }
                }
            </MudList>
            @if (NoRecords is not null)
            {
                @NoRecords
            }
        </CascadingValue>
    </MudPopover>
    @if (Overlay)
    {
        <MudOverlay Visible="@_openItemListState.Value" AutoClose="true" OnClick="@(async () => await _openItemListState.SetValueAsync(false))"></MudOverlay>
    }
}
