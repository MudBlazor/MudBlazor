@namespace MudBlazor
@using MudBlazor.Components.Combobox
@inherits MudBaseInput<T>
@typeparam T
<!--  TODO: Implement Bottom Sheets for XS screens -->
<!--  TODO: Implement Styling by Color.??? will need to make sure the proper Color.Inherit's are set. -->
<!--  TODO: Implement proper FullWidth / FitWidth / Width parameter -->
<!--  TODO: hide methods inherited that aren't used -->
<!--  TODO: Finish sorting parameters that have not been verified -->
<!--  TODO: Look at _activatorEvents and improve using Debounce , perhaps have a minimum 50 debounce value -->
<!--  TODO: Look at the Select/SelectRange methods in this style do we want full selection of text -->
<!-- Material 3 ComboBox specifications from menu:  https://m3.material.io/components/menus/  -->
<CascadingValue Name="SubscribeToParentForm" Value="false" IsFixed="true">
    <div class="@OuterClassname" id="@_elementId" @onfocusout="@OnFocusOutAsync" @onclick:stopPropagation @onmousedown:stopPropagation>
        <MudInputControl Label="@Label"
                         Variant="@Variant"
                         HelperId="@GetHelperId()"
                         HelperText="@HelperText"
                         HelperTextOnFocus="@HelperTextOnFocus"
                         FullWidth="@FullWidth"
                         Margin="@Margin"
                         Class="@Classname"
                         Style="@Style"
                         Error="@HasErrors"
                         ErrorId="@ErrorId"
                         ErrorText="@GetErrorText()"
                         Disabled="@GetDisabledState()"
                         Required="@Required"
                         ForId="@InputElementId"
                         @onmousedown="@HandleMouseDown">
            <InputContent>
                <MudInput @ref="_elementReference"
                          InputType="@(CanRenderValue || (Strict && !IsValueInList) ? InputType.Hidden : InputType.Text)"
                          Class="@InputClassname"
                          Margin="@Margin"
                          Placeholder="@Placeholder"
                          Label="@Label"
                          Variant="@Variant"
                          Typo="@Typo"
                          TextUpdateSuppression="false"
                          Value="@(Strict && !IsValueInList ? null : Text)"
                          Underline="@Underline"
                          Disabled="@GetDisabledState()"
                          ReadOnly="true"
                          Error="@Error"
                          ErrorId="@ErrorId"
                          HelperId="@GetHelperId()"
                          HelperText="@HelperText"
                          AdornmentText="@AdornmentText"
                          AdornmentIcon="@_currentIcon"
                          Adornment="@Adornment"
                          AdornmentColor="@AdornmentColor"
                          IconSize="@IconSize"
                          AdornmentAriaLabel="@AdornmentAriaLabel"
                          OnAdornmentClick="@OnAdornmentClick"
                          Clearable="@(Clearable && !GetReadOnlyState())"
                          ClearIcon="@ClearIcon"
                          OnClearButtonClick="@(async (e) => await SelectClearButtonClickHandlerAsync(e))"
                          @attributes="UserAttributes"
                          OnBlur="@OnBlurAsync"
                          ShrinkLabel="@ShrinkLabel"
                          InputId="@InputElementId"
                          Required="@Required">
                @GetSelectedValuePresenter()
                @if (ShowClearButton)
                {
                    <MudIconButton Class="@ClearButtonClassname"
                    Color="@Color.Inherit"
                    Icon="@ClearIcon"
                    Size="@Size.Small"
                    OnClick="@ClearButtonClickHandlerAsync"
                    aria-label="@Localizer[Resources.LanguageResource.MudInput_Clear]"
                    tabindex="-1" @onmousedown:stopPropagation />
                }
                @if (ShowAddButton)
                {
                    <MudIconButton Class="@ClearButtonClassname"
                    Color="@Color.Success"
                    Icon="@AddIcon"
                    Size="@Size.Small"
                    OnClick="@AddButtonClickHandlerAsync"
                    aria-label="@Localizer[Resources.LanguageResource.MudInput_Add]"
                    tabindex="-1" @onmousedown:stopPropagation />
                }
            </MudInput>

            <!-- Progress Indicator -->
            @if (ShowProgressIndicator && _isLoadingState.Value)
            {
                @if (ProgressIndicatorTemplate is not null)
                {
                    @ProgressIndicatorTemplate
                }
                else
                {
                    <div class="@CircularProgressClassname">
                        <MudProgressCircular Color="ProgressIndicatorColor" Indeterminate="true" Size="Size.Small" tabindex="-1" />
                    </div>
                }
            }
            </InputContent>
        </MudInputControl>
        <!-- TODO look again after overlay bug has been merged -->
        <!-- Dropdown/Popover for the List and List Items Must be inside MudField or you can't click anywhere in MudField when it's open -->
            <MudPopover Open="_openItemListState.Value" Class="@PopoverClass" MaxHeight="@MaxHeight"
                        AnchorOrigin="@AnchorOrigin" TransformOrigin="@TransformOrigin"
                        Fixed="DropdownSettings.Fixed" OverflowBehavior="DropdownSettings.OverflowBehavior"
                        RelativeWidth="@RelativeWidth">
                <CascadingValue Value="this">
                    <MudList Class="mud-combobox-list" T="T" Dense="@(Margin == Margin.Dense ? true : false)">

                        @if (BeforeItemsTemplate is not null)
                        {
                            <MudListSubheader>
                                <div class="mud-combobox-before-items pa-1">
                                    @BeforeItemsTemplate
                                </div>
                            </MudListSubheader>
                        }

                        @if (FilteredItems.Count > 0)
                        {
                            var displayedItems = FilteredItems.Take(_filteredTake).ToList();
                            <!-- TODO: Enable Grouping with GroupByFunc? -->
                            @foreach (var item in displayedItems)
                            {
                                var isSelected = _selectedItemsState.Value!.Contains(item);
                                var isDisabled = ItemDisabledFunc?.Invoke(item) ?? false;
                                var index = FilteredItems.IndexOf(item);
                                var isHovered = index == _selectedComboBoxIndex;
#nullable enable
                                Func<Task>? task = GetReadOnlyState() || GetDisabledState() ? null : async () => await ComboBoxToggleItem(item, AutoClose);
                                var itemContext = new ComboBoxItem<T>(item, isSelected, isDisabled, isHovered, task);
                                @if (ItemTemplate != null)
                                {
                                    <MudListItem T="T" @key="@index" id="@GetListItemId(index)">
                                        @ItemTemplate(itemContext);
                                    </MudListItem>
                                }
                                else
                                {
                                    <MudListItem T="T" @key="@index" id="@GetListItemId(index)" Value="@itemContext.Item"
                                                 OnClick="@(async () => await itemContext.ToggleSelectedItem())"
                                                 OnClickPreventDefault="true"
                                                 Disabled="@itemContext.IsDisabled"
                                                 Icon="@(itemContext.IsSelected ? Icons.Material.Filled.Check : "")"
                                                 Class="@GetListItemClassname(itemContext)">
                                        @GetItemString(itemContext.Item)
                                    </MudListItem>
                                }
                            }

                            @if (_filteredTake < FilteredItems.Count)
                            {
                                <MudDivider />
                                <MudListItem OnClick="NextFilteredPage" Class="mud-underline mud-theme-info">More...</MudListItem>
                            }
                        }

                        @if (NoRecords is not null)
                        {
                            <MudListSubheader>
                                @NoRecords
                            </MudListSubheader>
                        }

                    </MudList>
                </CascadingValue>
            </MudPopover>
    </div>
</CascadingValue>

<!-- Overlay for the Popover, optional -->
@if (Overlay && _openItemListState.Value)
{
    <MudOverlay Visible="@true" AutoClose="true" OnClick="@(async () => await CloseListAsync())"></MudOverlay>
}
