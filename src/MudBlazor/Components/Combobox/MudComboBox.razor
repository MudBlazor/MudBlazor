@namespace MudBlazor
@using MudBlazor.Components.Combobox
@inherits MudBaseInput<T>
@typeparam T
<!--  TODO: Implement Bottom Sheets for XS screens -->
<!-- Material 3 ComboBox specifications from menu:  https://m3.material.io/components/menus/  -->

<CascadingValue Name="SubscribeToParentForm" Value="false" IsFixed="true">
    <div class="@ComboBoxClassname">
        <MudField Class="@Classname"
                  ContentShrink="@(ShouldLabelShrink)"                                    
                  Disabled="@GetDisabledState()"
                  Error="@HasErrors"
                  FullWidth="@FullWidth"
                  HelperText="@HelperText"                  
                  Label="@Label"
                  Margin="@Margin"
                  Style="@Style"
                  Variant="@Variant"
                  Adornment="@Adornment" AdornmentAriaLabel="@AdornmentAriaLabel" OnAdornmentClick="@AdornmentClickHandlerAsync"
                  AdornmentIcon="@GetDropDownIcon" AdornmentColor="@AdornmentColor" AdornmentText="@AdornmentText"
                  @onmousedown="@OnInputClickedAsync">
                  <!-- TODO SelectedItemsTemplate not SelectedItemTemplate, need it out of the for loop.  -->
            <MudStack Row Wrap="Wrap.Wrap" Class="@($"mud-combobox-input {(Variant == Variant.Filled ? "align-self-end" : "")}")" Spacing="2" AlignItems="AlignItems.Center">
                @if (SelectedItemsCount > 0)
                {
                    var items = _selectedItemsState.Value!.ToList();
                    @foreach (var item in items)
                    {
                        var isDisabled = ItemDisabledFunc?.Invoke(item) ?? false;
                        var itemContext = new ComboBoxItem<T>(item, true, isDisabled, () => ComboBoxToggleItem(item, false));
                        @if (SelectedItemsTemplate != null)
                        {
                            @SelectedItemsTemplate(itemContext)
                        }
                        else
                        {
                                            <MudChip T="string" @key="@itemContext" Class="mud-combobox-selected-items" Color="Color.Inherit" CloseIcon="@Icons.Material.Filled.Cancel" 
                                                     Size="Size.Small" Disabled="@itemContext.IsDisabled" OnClose="@itemContext.ToggleSelectedItem" @onmousedown:stopPropagation>
                                @GetItemString(itemContext.Item)                                 
                                            </MudChip> 
                        }
                    }
                }
                @* TODO: @onblur="@OnBlurredAsync" onblur is set in javascript  *@
                    <input @ref="@_elementReference" @key="_elementKey" id="@InputElementId"
                           @attributes="UserAttributes" autocomplete="@GetAutocomplete()"
                           @onfocus="@OnInputFocusedAsync"
                           @oninput="OnInput"
                           @onkeydown="@OnInputKeyDownAsync"
                           @onkeyup="@OnInputKeyUpAsync"
                           @onkeydown:preventDefault="KeyDownPreventDefault"
                           @onkeyup:preventDefault="@KeyUpPreventDefault"
                           aria-describedby="@GetAriaDescribedByString()"
                           aria-invalid="@Error.ToString().ToLowerInvariant()"
                           aria-required="@Required.ToString().ToLowerInvariant()"
                           class="@InputClassname"
                           disabled=@GetDisabledState()
                           inputmode="@(InputType.Text.ToDescriptionString())"
                           pattern="@Pattern"
                           placeholder="@Placeholder"
                           readonly="@(GetReadOnlyState() || !Filterable)"
                           required="@Required"
                           type="@(InputType.Text.ToDescriptionString())"
                           value="@Text" />
                @if (ShowClearButton)
                {
                            <MudIconButton Class="@ClearButtonClassname"
                                           Color="@Color.Inherit"
                                           Icon="@ClearIcon"
                                           Size="@Size.Small"
                                           OnClick="@HandleClearButtonAsync"
                                           aria-label="@Localizer[Resources.LanguageResource.MudInput_Clear]"
                                           tabindex="-1" @onmousedown:stopPropagation />
                }
                @if (ShowAddButton)
                {
                            <MudIconButton Class="@ClearButtonClassname"
                                           Color="@Color.Inherit"
                                           Icon="@AddIcon"
                                           Size="@Size.Small"
                                           OnClick="@AddButtonClickHandlerAsync"
                                           aria-label="@Localizer[Resources.LanguageResource.MudInput_Add]"
                                           tabindex="-1" @onmousedown:stopPropagation />
                }
            </MudStack>

            <!-- Progress Indicator -->
            @if (ShowProgressIndicator && _isLoadingState.Value)
            {
                @if (ProgressIndicatorTemplate is not null)
                {
                    @ProgressIndicatorTemplate
                }
                else
                {
                            <div class="@CircularProgressClassname">
                                <MudProgressCircular Color="ProgressIndicatorColor" Indeterminate="true" Size="Size.Small" />
                            </div>
                }
            }
            <!-- TODO look again after overlay bug has been merged -->
            <!-- Dropdown/Popover for the List and List Items Must be inside MudField or you can't click anywhere in MudField when it's open -->
            @if (_openItemListState.Value)
            {
                    <MudPopover Open="true" Class="@PopoverClass" MaxHeight="@MaxHeight"
                                AnchorOrigin="@AnchorOrigin" TransformOrigin="@TransformOrigin"
                                Fixed="DropdownSettings.Fixed" OverflowBehavior="DropdownSettings.OverflowBehavior"
                                RelativeWidth="@RelativeWidth">
                        <CascadingValue Value="this">
                            <MudList Class="mud-combobox-list" T="T" Dense="@(Margin == Margin.Dense ? true : false)">

                            @if (BeforeItemsTemplate is not null)
                            {
                                        <MudListSubheader>
                                            <div class="mud-combobox-before-items pa-1">
                                        @BeforeItemsTemplate
                                            </div>
                                        </MudListSubheader>
                            }

                            @if (FilteredItems.Count > 0)
                            {
                                var displayedItems = FilteredItems.Take(_filteredTake).ToList();

                                @foreach (var item in displayedItems)
                                {
                                    var isSelected = _selectedItemsState.Value!.Contains(item);
                                    var isDisabled = ItemDisabledFunc?.Invoke(item) ?? false;
                                    var index = FilteredItems.IndexOf(item);
                                    var itemContext = new ComboBoxItem<T>(item, isSelected, isDisabled, () => ComboBoxToggleItem(item, AutoClose));
                                    @if (ItemTemplate != null)
                                    {
                                                        <MudListItem T="T" @key="@index" id="@GetListItemId(index)">
                                            @ItemTemplate(itemContext);
                                                        </MudListItem>
                                    }
                                    else
                                    {
                                                        <MudListItem T="T" @key="@index" id="@GetListItemId(index)" Value="@itemContext.Item"
                                                                     OnClick="@(async () => await itemContext.ToggleSelectedItem())"
                                                                     OnClickPreventDefault="true"
                                                                     Disabled="@itemContext.IsDisabled"
                                                                     Icon="@(itemContext.IsSelected ? Icons.Material.Filled.Check : "")"
                                                                     Class="@GetListItemClassname(itemContext.IsSelected)">
                                            @GetItemString(itemContext.Item)
                                                        </MudListItem>
                                    }
                                }

                                @if (_filteredTake < FilteredItems.Count)
                                {
                                                <MudDivider />
                                                <MudListItem OnClick="NextFilteredPage" Class="mud-underline mud-theme-info">More...</MudListItem>
                                }
                            }

                            @if (NoRecords is not null)
                            {
                                        <MudListSubheader>
                                    @NoRecords
                                        </MudListSubheader>
                            }

                            </MudList>
                        </CascadingValue>
                    </MudPopover>
            }
        </MudField>   
    </div>
</CascadingValue>

<!-- Overlay for the Popover, optional -->
@if (Overlay && _openItemListState.Value)
{
        <MudOverlay Visible="@true" AutoClose="true" OnClick="@(async () => await CloseListAsync())"></MudOverlay>
}

