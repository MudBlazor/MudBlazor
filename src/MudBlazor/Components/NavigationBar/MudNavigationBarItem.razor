@namespace MudBlazor
@using MudBlazor.Extensions
@inherits MudComponentBase

<div @ref="_elementReference" class="@Classname" style="@Style" @attributes="@UserAttributes" tabindex="@(Disabled ? "-1" : "0")" @onclick="HandleClickAsync" @onkeydown="@HandleKeyDownAsync" role="@(string.IsNullOrEmpty(Href) ? "button" : "link")" aria-disabled="@(Disabled ? "true" : null)">
    <MudBadge Class="@BadgeClassname" Dot="@BadgeParameters.Dot" Content="@BadgeParameters.Content" Overlap="@BadgeParameters.Overlap" Visible="@(BadgeParameters.Dot || BadgeParameters.Content != null)" Color="@BadgeParameters.Color">
        @if (Icon != null)
        {
            <MudIcon Icon="@Icon" Color="@GetColor()" />
        }
        <div class="mud-nav-bar-item-content">
            <MudText Color="@GetColor()" Typo="@(Parent?.GetState(x => x.Typo) ?? Typo.subtitle2)">@Text</MudText>
            @ChildContent
        </div>
    </MudBadge>
</div>
