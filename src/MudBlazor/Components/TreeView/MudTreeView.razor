@namespace MudBlazor
@inherits MudComponentBase
@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]

<ul @attributes="UserAttributes" class="@Classname" style="@Stylename">
    @* Nested trees and their items already receive the root from the root tree's cascade. *@
    @if (MudTreeRoot == this)
    {
        <CascadingValue Value="@MudTreeRoot" IsFixed="true">
            @RenderItems
        </CascadingValue>
    }
    else
    {
        @RenderItems
    }
</ul>

@code {
    private void RenderItems(RenderTreeBuilder __builder)
    {
        @if (ItemTemplate != null && Items != null)
        {
            @foreach (var item in Items)
            {
                // The data node lets ItemTemplate-created items keep their server-loading state on the tree root instead of the component instance.
                <CascadingValue Name="@MudTreeViewCascadingValues.ItemData" Value="item" IsFixed="true">
                    @ItemTemplate(item)
                </CascadingValue>
            }
        }
        else if (ChildContent != null)
        {
            // Hand-written children must not inherit the data node of an enclosing ItemTemplate item.
            <CascadingValue Name="@MudTreeViewCascadingValues.ItemData" Value="default(ITreeItemData<T>)" IsFixed="true">
                @ChildContent
            </CascadingValue>
        }
    }
}
