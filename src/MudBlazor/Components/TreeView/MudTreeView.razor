@namespace MudBlazor
@inherits MudComponentBase
@typeparam T
@attribute [CascadingTypeParameter(nameof(T))]

<ul @attributes="UserAttributes" class="@Classname" style="@Stylename">
    <CascadingValue Value="@MudTreeRoot" IsFixed="true">
        @* Expose the current data node to ItemTemplate-created MudTreeViewItem instances so
           per-node server-loading state can live on the tree root instead of the component instance. *@
        <CascadingValue Name="@MudTreeViewCascadingValues.ItemData" Value="default(ITreeItemData<T>)" IsFixed="true">
            @if (IsVirtualized)
            {
                <MudVirtualize Items="@GetVisibleItems()" Enabled="true" SpacerElement="li" Context="itemContext">
                    <CascadingValue Name="@MudTreeViewCascadingValues.ItemData" Value="itemContext.Item" IsFixed="true">
                        <CascadingValue Name="@MudTreeViewCascadingValues.ItemDepth" Value="(int?)itemContext.Depth" IsFixed="true">
                            @ItemTemplate(itemContext.Item)
                        </CascadingValue>
                    </CascadingValue>
                </MudVirtualize>
            }
            else if (ItemTemplate != null && Items != null)
            {
                @foreach (var item in Items)
                {
                    <CascadingValue Name="@MudTreeViewCascadingValues.ItemData" Value="item" IsFixed="true">
                        @ItemTemplate(item)
                    </CascadingValue>
                }
            }
            else if (ChildContent != null)
            {
                @ChildContent
            }
        </CascadingValue>
    </CascadingValue>
</ul>
