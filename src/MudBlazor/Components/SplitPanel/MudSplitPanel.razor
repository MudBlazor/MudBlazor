@namespace MudBlazor
@inherits MudComponentBase;

<div id="@_containerId" style="@Style" class="@Classname" @attributes="@UserAttributes">
    <div style="@StylenameFirstPanel" class="@ClassnameFirstPanel">
        @FirstPanel
    </div>
    <div class="@ClassnameDivider" tabindex="0" role="separator" aria-label="Resize panels"></div>
    <div style="@StylenameSecondPanel" class="@ClassnameSecondPanel">
        @SecondPanel
    </div>
</div>
