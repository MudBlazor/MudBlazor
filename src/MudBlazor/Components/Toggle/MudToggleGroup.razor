@namespace MudBlazor
@attribute [CascadingTypeParameter(nameof(T))]
@inherits MudComponentBase
@typeparam T

<CascadingValue Value="this" IsFixed="true">
    <CascadingValue Name="__MudToggleGroupParent" Value="@((object)this)" IsFixed="true">
        <div role="group" class="@Classname" style="@Stylename" @attributes="UserAttributes">
            @ChildContent
        </div>
    </CascadingValue>
</CascadingValue>
