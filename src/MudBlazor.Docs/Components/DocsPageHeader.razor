@*html head (for server prerendering)*@
<PageTitle>@(GetTitle())</PageTitle>
<HeadContent>
    <meta Name="keywords" Content="@GetKeywords()" />
    <meta Property="og:title" Content="@GetTitle()" />
    <meta Name="twitter:title" Content="@GetTitle()" />
    @if (!string.IsNullOrEmpty(SubTitle))
    {
        <meta Name="description" Content="@SubTitle" />
        <meta Property="og:description" Content="@SubTitle" />
        <meta Name="twitter:description" Content="@SubTitle" />
    }
    <link rel="canonical" href="@GetCanonicalUri()" />
</HeadContent>

@if (Page.Type != null)
{
    @if (Page.IsApi)
    {
        <ApiBreadcrumbs Title="@Title" Type="@Page.Type" />
    }
    else
    {
        <ComponentBreadcrumbs Title="@Title" Type="@Page.Type" />
    }
}

@if (SpecialHeaderContent != null)
{
    <div class="docs-page-header my-16">
        @SpecialHeaderContent
        <DocsRenderBenchmark />
    </div>
}
else
{
    <div class="docs-page-header">
        <MudText Typo="@Typo.h4">@Title</MudText>
        <ApiText Typo="@Typo.subtitle1" Text="@GetSubTitle()" />
        <MudText Typo="@Typo.body1">@Description</MudText>
        <DocsRenderBenchmark />
    </div>
}

@if (Page.Type != null)
{
    <MudGrid>
        <MudItem xs="4">
            @if(Page.IsApi)
            {
                @if (HasExamplePage())
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Outlined" Href="@Page.Type.ComponentUrl">Examples</MudButton>
                }
            }
            else
            {
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" Href="@Page.Type.ApiUrl">Documentation</MudButton>
            }
        </MudItem>
        <MudItem xs="8"></MudItem>
    </MudGrid>
}
