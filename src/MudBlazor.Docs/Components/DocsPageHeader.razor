@*html head (for server prerendering)*@
<PageTitle>@(GetTitle())</PageTitle>
<HeadContent>
    <meta Name="keywords" Content="@GetKeywords()" />
    <meta Property="og:title" Content="@GetTitle()" />
    <meta Name="twitter:title" Content="@GetTitle()" />
    @if (!string.IsNullOrEmpty(SubTitle))
    {
        <meta Name="description" Content="@SubTitle" />
        <meta Property="og:description" Content="@SubTitle" />
        <meta Name="twitter:description" Content="@SubTitle" />
    }
    <link rel="canonical" href="@GetCanonicalUri()" />
</HeadContent>

@if (SpecialHeaderContent != null)
{
    <div class="docs-page-header my-16">
        @SpecialHeaderContent
        <DocsRenderBenchmark />
    </div>
}
else
{
    <div class="docs-page-header">
        <MudText Typo="@Typo.h4">@Title</MudText>
        <ApiText Typo="@Typo.subtitle1" Text="@GetSubTitle()" />
        <MudText Typo="@Typo.body1">@Description</MudText>
        <DocsRenderBenchmark />
    </div>
}

@if (!IsApi && DocumentedType != null)
{
    <div class="docs-page-apilinks">
        <MudChipSet T="string" Variant="Variant.Outlined" Size="Size.Small">
            <MudChip T="string" Icon="@Icons.Material.Outlined.Api" Color="Color.Primary" Href="@(DocumentedType.ApiUrl.ToLowerInvariant())">
                @Component
            </MudChip>
                
            @if (Example != null && Example.ChildTypes != null)
            {
                @foreach (var childType in Example.ChildTypes)
                {
                    <MudChip T="string" Icon="@Icons.Material.Outlined.AccountTree" Color="Color.Secondary" Href="@($"api/{childType.Name.ToLowerInvariant()}")">
                        @childType.Name.Replace("`1", "")
                    </MudChip>
                }
            }

            <MudChip T="string" Icon="@Icons.Custom.Brands.GitHub" Href="https://github.com/MudBlazor/MudBlazor" Target="_blank">
                Source
            </MudChip>

            <MudChip T="string" Icon="@Icons.Material.Outlined.Feedback" Href="https://github.com/MudBlazor/MudBlazor/issues" Target="_blank">
                Feedback
            </MudChip>
        </MudChipSet>
    </div>
}
@if (IsApi && Example != null)
{
    <DocsPageSection api-link-section>
        <SectionHeader Title="Pages" />
        <MudAlert Severity="Severity.Info" Class="mt-6">
            For examples and details on the usage of this component, visit the <MudLink Href="@($"/components/{Example.Link.ToLowerInvariant()}")" Typo="Typo.inherit">@Example.Name</MudLink> page.
        </MudAlert>
    </DocsPageSection>
}