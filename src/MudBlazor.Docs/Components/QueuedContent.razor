@inject IRenderQueueService RenderQueue

@if (Visible)
{
    @ChildContent
}

@code {
    private bool Visible { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    protected override void OnInitialized()
    {
        RenderQueue.Enqueue(this);
    }

    /// <summary>
    /// Displays this section.
    /// </summary>
    /// <param name="token">The token for if rendering is canceled.</param>
    public async Task ShowAsync(CancellationToken token = default)
    {
        if (!Visible && !token.IsCancellationRequested)
        {
            Visible = true;
            await InvokeAsync(StateHasChanged);
        }
    }
}
