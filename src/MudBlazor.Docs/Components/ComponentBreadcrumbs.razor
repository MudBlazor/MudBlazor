<MudBreadcrumbs Items="Items">
    <ItemTemplate Context="Item">
        @if (Item.Href == null)
        {
            <MudText Typo="Typo.subtitle2">@Item.Text</MudText>
        }
        else
        {
            <MudLink Href="@Item.Href" Typo="Typo.subtitle2">
                @Item.Text
            </MudLink>
        }
    </ItemTemplate>
</MudBreadcrumbs>