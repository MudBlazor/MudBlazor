@namespace MudBlazor.Docs.Examples

<MudPaper Width="300px" Square="true" Class="pa-4 d-flex flex-column gap-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary">Sign in with email</MudButton>
    <MudDivider>or</MudDivider>
    <MudButton Variant="Variant.Outlined">Sign in with a passkey</MudButton>
</MudPaper>

<MudPaper Width="300px" Square="true" Class="py-4 mt-4">
    <MudText Class="px-4">Can we move the meeting?</MudText>
    <MudDivider DividerType="DividerType.Middle" Class="my-2">Today</MudDivider>
    <MudText Class="px-4">Sure, how about 3 PM?</MudText>
</MudPaper>

<MudPaper Width="300px" Height="100px" Square="true" Class="d-flex justify-space-around align-center mt-4">
    <MudButton Variant="Variant.Outlined">Delivery</MudButton>
    <MudDivider Vertical="true">or</MudDivider>
    <MudButton Variant="Variant.Outlined">Pickup</MudButton>
</MudPaper>
