@page "/components/divider"

<DocsPage>
    <DocsPageHeader Title="Divider" Component="@nameof(MudDivider)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="List Dividers">
                <Description></Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DividerListExample)">
                <DividerListExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Inset Dividers">
                <Description>Adds a margin to the left side of the divider.</Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DividerInsertExample)">
                <DividerInsertExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Middle Dividers">
                <Description>Middle dividers have margin on both left and right side.</Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DividerMiddleExample)" ShowCode="false">
                <DividerMiddleExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Vertical Dividers">
                <Description>Vertical dividers can be used inside parents with a set height. If the parent doesn't have a set height but is displayed with flex, use the <CodeInline>Flexitem</CodeInline> property.</Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DividerVerticalExample)">
                <DividerVerticalExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Content within Dividers">
                <Description>
                    Place any content inside a <CodeInline>MudDivider</CodeInline> to display it centered between two lines.
                    <CodeInline>DividerType</CodeInline>, <CodeInline>Vertical</CodeInline>, <CodeInline>Light</CodeInline>, <CodeInline>Absolute</CodeInline> and <CodeInline>FlexItem</CodeInline> still apply.
                    When content is set, <CodeInline>Class</CodeInline>, <CodeInline>Style</CodeInline> and any other attributes are applied to the wrapper element instead of the <CodeInline>hr</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DividerChildContentExample)">
                <DividerChildContentExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
