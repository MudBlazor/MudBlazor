@page "/components/sheet"

<DocsPage>
    <DocsPageHeader Title="Sheet" Component="@nameof(MudSheet)" />
    <DocsPageContent>

        <DocsPageSection>
            <MudAlert Class="mt-4" Severity="Severity.Warning">
                <b>Warning:</b> This component is currently under development.
                <br />
                <br />
                Breaking changes such as updates to the API, look and feel, or CSS classes, may occur even in minor patch releases.
                Please use it only if you are prepared to adapt your code accordingly and provide feedback or contribute code.
            </MudAlert>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Basic Usage">
                <Description>
                    <CodeInline Tag="true">MudSheet</CodeInline> is used to show content from the screen edges:
                    <ul class="mt-2" style="list-style: initial; padding-left: 1.5rem;">
                        <li><CodeInline>Standard</CodeInline>: Defaults to <strong>true</strong> (non-modal); Set to <c>false</c> for Modal.</li>
                        <li><CodeInline>EnableDragToSize</CodeInline>: Draggable via the handle if true, (vertical or horizontal based on <CodeInline>Position</CodeInline>).</li>
                        <li><b>CSS</b>: Top/Bottom sheets have a default max width of 640px — override via CSS.</li>
                    </ul>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBasicUsageExample)" ShowCode="false">
                <SheetBasicUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Two Way Bind">
                <Description>
                    You can two-way bind both the <CodeInline>Open</CodeInline> property as well as the <CodeInline>CurrentSize</CodeInline> property.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBindExample)" ShowCode="false">
                <SheetBindExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Appearance">
                <Description>
                    There are many Appearance properties that can be used to customize the look and feel of 
                    the sheet, see the API for all of the options. Two examples shown here are <CodeInline>BorderRadius</CodeInline> or <CodeInline>AriaLabel</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetAppearanceExample)" ShowCode="false">
                <SheetAppearanceExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Behavior">
                <Description>
                    There are many Behavior properties that can be used to customize the way the sheet works, 
                    see the API for all of the options. Two examples shown here are <CodeInline>CoverAppBar</CodeInline> and <CodeInline>CloseOnEscapeKey</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBehaviorExample)" ShowCode="false">
                <SheetBehaviorExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
