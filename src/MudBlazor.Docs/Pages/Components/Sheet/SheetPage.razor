@page "/components/sheet"

<DocsPage>
    <DocsPageHeader Title="Sheet" Component="@nameof(MudSheet)" />
    <DocsPageContent>

        <DocsPageSection>
            <MudAlert Class="mt-4" Severity="Severity.Warning">
                <b>Warning:</b> This component is currently under development.
                <br />
                <br />
                Breaking changes such as updates to the API, look and feel, or CSS classes, may occur even in minor patch releases.
                Please use it only if you are prepared to adapt your code accordingly and provide feedback or contribute code.
            </MudAlert>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Basic Usage">
                <Description>
                    The <CodeInline Tag="true">MudSheet</CodeInline> component is versatile for displaying content coming from the edges of the screen. Default MaxWidth for a Top
                    or bottom sheet is 640px. 
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBasicUsageExample)">
                <SheetBasicUsageExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
