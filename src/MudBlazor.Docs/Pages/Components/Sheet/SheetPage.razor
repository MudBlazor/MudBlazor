@page "/components/sheet"

<DocsPage>
    <DocsPageHeader Title="Sheet" Component="@nameof(MudSheet)" />
    <DocsPageContent>

        <DocsPageSection>
            <MudAlert Class="mt-4" Severity="Severity.Warning">
                <b>Warning:</b> This component is currently under development.
                <br />
                <br />
                Breaking changes such as updates to the API, look and feel, or CSS classes, may occur even in minor patch releases.
                Please use it only if you are prepared to adapt your code accordingly and provide feedback or contribute code.
            </MudAlert>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Basic Usage">
                <Description>
                    <CodeInline Tag="true">MudSheet</CodeInline> is used to show content from the screen edges:
                    <ul class="mt-2" style="list-style: initial; padding-left: 1.5rem;">
                        <li><CodeInline>Standard</CodeInline>: Defaults to <strong>true</strong> (non-modal); Set to <c>false</c> for Modal.</li>
                        <li><CodeInline>EnableDragToSize</CodeInline>: Draggable via the handle if true, (vertical or horizontal based on <CodeInline>Position</CodeInline>).</li>
                        <li><b>CSS</b>: Top/Bottom sheets have a default max width of 640px — override via CSS.</li>
                    </ul>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBasicUsageExample)" ShowCode="false">
                <SheetBasicUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Primary Controls">
                <Description>
                    You can two-way bind both the <CodeInline>Open</CodeInline> and <CodeInline>CurrentSize</CodeInline> properties.
                    With <CodeInline>SnapMode</CodeInline> enabled, the sheet will snap to the nearest value in
                    <CodeInline>PresetSizes</CodeInline> when dragging ends. You can also control the sheet programmatically using
                    <CodeInline>ToggleSizeAsync</CodeInline>, <CodeInline>OpenSheetAsync</CodeInline>, and
                    <CodeInline>CloseSheetAsync</CodeInline>.
                </Description>

            </SectionHeader>
            <SectionContent Code="@nameof(SheetBindExample)" ShowCode="false">
                <SheetBindExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Appearance">
                <Description>
                    Customize the sheet's appearance using various properties—see the API for all options.
                    Examples include <CodeInline>BorderRadius</CodeInline> and <CodeInline>AriaLabel</CodeInline>.
                    By default, <CodeInline>MudSheet</CodeInline> uses <CodeInline>MudPaper</CodeInline>.
                    Here, the <b>Left</b> and <b>Top</b> sheets have Paper disabled; <b>Bottom</b> and <b>Right</b> use the default.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetAppearanceExample)" ShowCode="false">
                <SheetAppearanceExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Behavior">
                <Description>
                    Customize the sheet's behavior using various properties—see the API for all options.
                    Examples include <CodeInline>CoverAppBar</CodeInline> which allows you to cover the 
                    appbar in Standard or not cover the appbar in Modal modes. <CodeInline>CloseOnEscapeKey</CodeInline> 
                    allows the Escape Key to close the sheet so long as any part of it has focus.
                    Below are two common use cases for the <CodeInline>Sheet</CodeInline> component.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SheetBehaviorExample)" ShowCode="false">
                <SheetBehaviorExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
