@namespace MudBlazor.Docs.Examples

<MudSplitPanel Class="mud-width-full mud-height-full" TransparentBackground="true" Horizontal="true" StyleSecondPanel="@BackgroundColor">
    <FirstPanel>
        <MudSplitPanel Class="mud-width-full mud-height-full" StyleFirstPanel="@BackgroundColor" StyleSecondPanel="@BackgroundColor">
            <FirstPanel>
                <MudStack Style="height: 100%; min-height: 200px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudText Typo="Typo.h6">Content 1</MudText>
                </MudStack>
            </FirstPanel>
            <SecondPanel>
                <MudStack Style="height: 100%; min-height: 200px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudText Typo="Typo.h6">Content 2</MudText>
                </MudStack>
            </SecondPanel>
        </MudSplitPanel>
    </FirstPanel>
    <SecondPanel>
        <MudStack Style="height: 100%; min-height: 200px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudText Typo="Typo.h6">Content 3</MudText>
        </MudStack>
    </SecondPanel>
</MudSplitPanel>

@code {
    private const string BackgroundColor = "background-color: var(--mud-palette-background-gray);";
}
