@namespace MudBlazor.Docs.Examples

<MudStack Class="mud-width-full mud-height-full" Justify="Justify.Center" AlignItems="AlignItems.Center" Style="height: 500px;">
    <MudSwitch @bind-Value="_horizontal" Label="Horizontal" />
    <MudSplitPanel Class="mud-width-full mud-height-full" Horizontal="_horizontal" StylePanel="background-color: var(--mud-palette-background-gray);">
        <FirstPanel>
            <MudStack Justify="Justify.Center">
                <MudText Typo="Typo.h6">First Panel</MudText>
                <MudButton>Some Button</MudButton>
            </MudStack>
        </FirstPanel>
        <SecondPanel>
            <MudStack Justify="Justify.Center">
                <MudText Typo="Typo.h6">Second Panel</MudText>
                <MudSwitch T="bool" Label="A switch"></MudSwitch>
            </MudStack>
        </SecondPanel>
    </MudSplitPanel>
</MudStack>

@code {
    private bool _horizontal;
}
