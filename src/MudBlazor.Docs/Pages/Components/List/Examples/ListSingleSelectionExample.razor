@namespace MudBlazor.Docs.Examples

<MudPaper Width="300px">
<MudList T="string" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode" ReadOnly="@ReadOnly" Color="@Color.Info">
        <MudListSubheader>
            Your drink:
        <MudChip Color="@Color.Info">
            @(SelectedValue ?? "You are dry")
        </MudChip>
        </MudListSubheader>
        <MudListItem Value='"Milk"'>Milk</MudListItem>
        <MudListItem Value='"Carbonated H²O"'>Sparkling Water</MudListItem>
        <MudListItem Value='"Teas"'>
            <ChildContent>Teas</ChildContent>
            <NestedList>
                <MudListItem Value='"Earl Grey"'>English Tea</MudListItem>
                <MudListItem Value='"Gunpowder Tea"'>Chinese Tea</MudListItem>
                <MudListItem Value='"Bubble Tea"'>Bubble Tea</MudListItem>
            </NestedList>
        </MudListItem>
        <MudListItem Value='"Coffees"'>
            <ChildContent>Coffees</ChildContent>
            <NestedList>
                <MudListItem Value='"Irish Coffee"'>Irish Coffee</MudListItem>
                <MudListItem Value='"Double Espresso"'>Double Espresso</MudListItem>
                <MudListItem Value='"Cafe Latte"'>Cafe Latte</MudListItem>
            </NestedList>
        </MudListItem>
    </MudList>
</MudPaper>

<MudStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <MudRadioGroup @bind-Value="SelectionMode">
        <MudRadio Value="SelectionMode.SingleSelection" Color="Color.Primary">SingleSelection</MudRadio>
        <MudRadio Value="SelectionMode.ToggleSelection" Color="Color.Primary">ToggleSelection</MudRadio>
    </MudRadioGroup>
    <MudChipSet T="string" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode" Color="Color.Info" Variant="Variant.Text">
        <MudChip Value='"Milk"' />
        <MudChip Value='"Carbonated H²O"' />
        <MudChip Value='"Earl Grey"' />
        <MudChip Value='"Gunpowder Tea"' />
        <MudChip Value='"Bubble Tea"' />
        <MudChip Value='"Irish Coffee"' />
        <MudChip Value='"Double Espresso"' />
        <MudChip Value='"Cafe Latte"' />
    </MudChipSet>
    <MudSwitch @bind-Value="ReadOnly" Color="Color.Primary">ReadOnly</MudSwitch>    
</MudStack>



@code
{
    public string SelectedValue = "Milk";
    public SelectionMode SelectionMode = SelectionMode.SingleSelection;
    public bool ReadOnly;
}
