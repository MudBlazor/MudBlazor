@namespace MudBlazor.Docs.Examples

<MudPaper Width="300px">
    <MudList T="string">
        <MudListItem Value='"Inbox"' Icon="@Icons.Material.Filled.Inbox">Inbox</MudListItem>
        <MudListItem Value='"Sent"' Icon="@Icons.Material.Filled.Send">Sent</MudListItem>
        <MudListItem Value='"Drafts"' Disabled="true" IconColor="Color.Info" Icon="@Icons.Material.Filled.Drafts">Drafts</MudListItem>
        <MudDivider />
        <MudListItem Value='"Trash"'>
            Trash
            <br />
            <MudText Class="mud-list-item-secondary-text" Typo="Typo.subtitle2">Removed e-mails</MudText>
        </MudListItem>
        <MudListItem Value='"Spam"'>
            Spam
            <br />
            <MudText Class="mud-list-item-secondary-text" Typo="Typo.subtitle2">E-mails from common providers</MudText>
        </MudListItem>
    </MudList>
</MudPaper>
