        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.h6">First column</MudText>
            <MudText Typo="Typo.body2">This card content is laid out as a grid.</MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudText Typo="Typo.h6">Second column</MudText>
            <MudText Typo="Typo.body2">MudItem children are placed directly inside the content.</MudText>
        </MudItem>
    </MudCardContent>
