@namespace MudBlazor.Docs.Examples

<MudTextField Value="@SampleText" Label="Tabs" Variant="Variant.Outlined" Lines="3" EnableTab="_enabledTab" TabSpaces="_tabSpaces"/>
<MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudSwitch Label="Enable tab" @bind-Value="_enabledTab" Color="Color.Primary"/>
    <MudNumericField Label="Tab spaces" @bind-Value="_tabSpaces" Min="0" Class="flex-grow-0"/>
</MudStack>

@code {
    private const string SampleText = "Lorem ipsum dolor sit amet,\nconsectetur adipiscing elit,\nsed do eiusmod tempor incididunt ut labore et dolore magna aliqua.";

    private bool _enabledTab;
    private int _tabSpaces = 4;
}
