@namespace MudBlazor.Docs.Examples

@using MudBlazor

<MudStack Row Spacing="3" Style="height: 300px;">
    <MudTextField T="string"
                  Label="Fixed"
                  Variant="Variant.Text"
                  Lines="3"
                  Sizing="InputSizing.Fixed"
                  @bind-Text="_fixedText"
                  HelperText="Sizing = Fixed: Fixed height based on Lines" />

    <MudTextField T="string"
                  Label="Auto"
                  Variant="Variant.Text"
                  Lines="3"
                  Sizing="InputSizing.Auto"
                  @bind-Text="_autoText"
                  HelperText="Sizing = Auto: Grows with content up to MaxLines" />

    <MudTextField T="string"
                  Label="Fill"
                  Variant="Variant.Text"
                  Sizing="InputSizing.Fill"
                  @bind-Text="_fillText"
                  HelperText="Sizing = Fill: Fills the available height" />
</MudStack>

@code {
    private string _fixedText = "Fixed\n\n(does not auto-grow)";
    private string _autoText = "Auto\n\n(type more lines)";
    private string _fillText = "Fill\n\n(fills container height)";
}
