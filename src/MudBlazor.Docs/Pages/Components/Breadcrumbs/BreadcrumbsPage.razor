@page "/components/breadcrumbs"

<DocsPage>
    <DocsPageHeader Title="Breadcrumbs" Component="@nameof(MudBreadcrumbs)">
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Basic Breadcrumbs">
                <Description></Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsBasicExample)">
                <BreadcrumbsBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Accessible Names">
                <Description>
                    Use <CodeInline>AriaLabel</CodeInline> to give each breadcrumb navigation landmark a meaningful, distinct name when a page contains multiple trails.
                    When <CodeInline>AriaLabel</CodeInline> is <CodeInline>null</CodeInline>, the localized <CodeInline>Breadcrumb</CodeInline> label is used.
                    <CodeInline>UserAttributes</CodeInline>, including <CodeInline>aria-label</CodeInline>, apply to the inner ordered list.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsAriaLabelExample)" ShowCode="true">
                <BreadcrumbsAriaLabelExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Custom Separator">
                <Description></Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsSeparatorExample)">
                <BreadcrumbsSeparatorExample />
            </SectionContent>
        </DocsPageSection>
        
        <DocsPageSection>
            <SectionHeader Title="Render Fragments">
                <Description>It is also possible to provide a <CodeInline>RenderFragment</CodeInline> as a template.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsSeparatorTemplateExample)">
                <BreadcrumbsSeparatorTemplateExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Item Icons">
                <Description></Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsItemIconsExample)">
                <BreadcrumbsItemIconsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Item Template">
                <Description>If you use the <CodeInline>ItemTemplate</CodeInline> parameter, MudBlazor doesn't wrap the content in anchors.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsItemTemplateExample)">
                <BreadcrumbsItemTemplateExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Collapsed">
                <Description>You can set the <CodeInline>MaxItems</CodeInline> parameter in order to automatically collapse the breadcrumbs when it exceeds a number of items.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(BreadcrumbsCollapsedExample)">
                <BreadcrumbsCollapsedExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
