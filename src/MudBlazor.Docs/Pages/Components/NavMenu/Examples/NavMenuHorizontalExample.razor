@namespace MudBlazor.Docs.Examples

<MudAppBar Class="py-4" Color="Color.Default" Elevation="0" Fixed="false" Gutters>
    <MudNavMenu Horizontal="true" Rounded="true" Color="Color.Info" Margin="Margin.Normal" Bordered>
        <MudText Typo="Typo.h6" Class="px-4">My Application</MudText>
        <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Home" IconColor="Color.Inherit">Home</MudNavLink>
        <MudNavLink Href="/components/navmenu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage" IconColor="Color.Inherit">Servers</MudNavLink>
        <MudNavLink Href="/billing" Disabled="true">Billing</MudNavLink>
        <MudSpacer />
        <MudNavLink Href="/about">About</MudNavLink>
        <MudNavGroup Icon="@Icons.Material.Filled.Settings" Class="gap-0">
            <MudNavGroup Title="Level 1" Icon="@Icons.Material.Filled.AdminPanelSettings">
                <MudNavGroup Title="Level 2" Icon="@Icons.Material.Filled.People">
                    <MudNavGroup Title="Level 3" Icon="@Icons.Material.Filled.Lock">
                        <MudNavLink Href="/delete" Icon="@Icons.Material.Filled.DeleteForever">Delete Password</MudNavLink>
                    </MudNavGroup>
                </MudNavGroup>
            </MudNavGroup>
        </MudNavGroup>
    </MudNavMenu>
</MudAppBar>
