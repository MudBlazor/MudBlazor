@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid T="Element" Items="_elements" DragDropColumnReordering="true" ColumnsPanelReordering="true" ColumnResizeMode="ResizeMode.Container" ShowMenuIcon="true" ColumnOrderChanged="OnColumnOrderChanged">
    <Columns>
        <SelectColumn T="Element" />
        <PropertyColumn Property="x => x.Number" Title="Nr" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Element" />
    </PagerContent>
</MudDataGrid>

<MudText Class="mt-2" Typo="Typo.body2">@_status</MudText>

@code {
    private IEnumerable<Element> _elements = new List<Element>();

    private string _status = "Use a header drag, or use the columns panel to reorder columns.";

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private void OnColumnOrderChanged(DataGridColumnOrderChangedEventArgs<Element> args)
    {
        _status = $"{GetColumnLabel(args.Column)} moved from {args.PreviousIndex} to {args.CurrentIndex}.";
    }

    private static string GetColumnLabel(Column<Element> column)
    {
        return column.Tag?.ToString() switch
        {
            "select-column" => "Select Column",
            "hierarchy-column" => "Hierarchy Column",
            _ when !string.IsNullOrWhiteSpace(column.Title) => column.Title,
            _ when column is TemplateColumn<Element> => "Template Column",
            _ => column.PropertyName ?? "Column"
        };
    }
}
