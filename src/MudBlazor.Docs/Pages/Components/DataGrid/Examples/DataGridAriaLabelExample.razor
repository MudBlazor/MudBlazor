@namespace MudBlazor.Docs.Examples

<MudDataGrid T="string" Items="@_items" TableAttributes="TableAttributes" Hover="true" Breakpoint="Breakpoint.Sm">
    <Columns>
        <PropertyColumn Property="@(fruit => fruit)" Title="Fruit"/>
    </Columns>
</MudDataGrid>

@code {
    private readonly string[] _items = new[] { "Apple", "Banana", "Cherry" };
    
    private Dictionary<string, object> TableAttributes { get; set; } = new()
    {
        ["aria-label"] = "Fruits table"
    };
}
