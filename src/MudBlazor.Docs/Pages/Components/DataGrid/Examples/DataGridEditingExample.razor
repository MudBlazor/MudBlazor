@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid T="Student" Items="@_students" ReadOnly="@_readOnly" EditMode="@(_isCellEditMode ? DataGridEditMode.Cell : DataGridEditMode.Form)"
             StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges"
             Bordered="true" Dense="true" EditTrigger="@(_editTriggerRowClick ? DataGridEditTrigger.OnRowClick : DataGridEditTrigger.Manual)">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Nr" Editable="false" />
        <PropertyColumn Property="x => x.Age" />
        <PropertyColumn Property="x => x.Foreign" />
        <PropertyColumn Property="x => x.Graduated" />
        <PropertyColumn Property="x => x.Degree">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Degree" Label="Degree" Variant="Variant.Outlined" Margin="@Margin.Dense">
                    <MudSelectItem Value="@Degree.Bachelor">Bachelor</MudSelectItem>
                    <MudSelectItem Value="@Degree.Master">Master</MudSelectItem>
                    <MudSelectItem Value="@Degree.PhD">PhD</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Position">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Position" Required RequiredError="You must select a Position!!!" Label="Position" Variant="Variant.Outlined" Margin="@Margin.Dense">
                    <MudSelectItem T="int?" Value="0">zero</MudSelectItem>
                    <MudSelectItem T="int?" Value="1">one</MudSelectItem>
                    <MudSelectItem T="int?" Value="17">seventeen</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Hidden="@(_isCellEditMode || _readOnly || _editTriggerRowClick)" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="_readOnly" Color="Color.Primary">Read Only</MudSwitch>
    <div class="d-flex justify-start align-center">
        <p class="mud-typography mud-typography-body1 mud-inherit-text mr-2">Form</p>
        <MudSwitch @bind-Value="_isCellEditMode" Color="Color.Primary">Cell</MudSwitch>
    </div>
    <div class="d-flex justify-start align-center">
        <p class="mud-typography mud-typography-body1 mud-inherit-text mr-2">Manual</p>
        <MudSwitch @bind-Value="_editTriggerRowClick" Color="Color.Primary">On Row Click</MudSwitch>
    </div>
</div>

<MudExpansionPanels Style="flex:1">
    <MudExpansionPanel Text="Show Events">
        @foreach (var message in _events)
        {
            <MudText Typo="@Typo.body2">@message</MudText>
        }
        @if(_events.Count > 0) 
        {
            <div class="d-flex">
                <MudSpacer/>
                <MudButton Class="mt-3" ButtonType="ButtonType.Button" Variant="Variant.Filled" OnClick="@(() => _events.Clear())">Clear</MudButton>
            </div>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {

    private IEnumerable<Element> Elements = new List<Element>();
    private List<Student> _students = new();
    private bool _readOnly;
    private bool _isCellEditMode;
    private List<string> _events = new();
    private bool _editTriggerRowClick;

    protected override void OnInitialized()
    {
        _students.Add(new Student() { Name = "John", Age = 25, Foreign = true, Graduated = false, Degree = Degree.Bachelor });
        _students.Add(new Student() { Name = "Mary", Age = 27, Foreign = false, Graduated = null,  Degree = Degree.Master });
        _students.Add(new Student() { Name = "Angelina", Age = 32, Foreign = false, Graduated = true, Degree = Degree.PhD });
    }

    // events
    private void StartedEditingItem(Student item)
    {
        _events.Insert(0, $"Event = StartedEditingItem, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private void CanceledEditingItem(Student item)
    {
        _events.Insert(0, $"Event = CanceledEditingItem, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private void CommittedItemChanges(Student item)
    {
        _events.Insert(0, $"Event = CommittedItemChanges, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private class Student
    {
        public string Name { get; set; }
        public int Age { get; set; }
        public bool Foreign { get; set; }
        public bool? Graduated { get; set; }
        public Degree Degree { get; set; }
        public int? Position { get; set; }
    }

    private enum Degree
    {
        Bachelor,
        Master,
        PhD
    }
}
