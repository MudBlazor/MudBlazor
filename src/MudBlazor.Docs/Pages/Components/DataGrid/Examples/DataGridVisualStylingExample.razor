@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<style>
    .datagrid-row-italic {
        font-style: italic;
    }

    .datagrid-cell-element-1 {
        background-color: #8CED8C;
    }

    .datagrid-cell-element-2 {
        background-color: #E5BDE5;
    }

    .datagrid-cell-element-3 {
        background-color: #EACE5D;
    }

    .datagrid-cell-element-4 {
        background-color: #F1F165;
    }

    .datagrid-cell-heavy-molar {
        font-weight: bold;
    }
</style>

<MudDataGrid Items="@Elements.Take(4)" Hover="@_hover" Dense="@_dense" Striped="@_striped" Bordered="@_bordered"
    RowClassFunc="@_rowClassFunc">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" CellClassFunc="@_cellClassFunc" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
    </Columns>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch @bind-Value="_hover" Color="Color.Primary">Hover</MudSwitch>
    <MudSwitch @bind-Value="_dense" Color="Color.Secondary">Dense</MudSwitch>
    <MudSwitch @bind-Value="_striped" Color="Color.Tertiary">Striped</MudSwitch>
    <MudSwitch @bind-Value="_bordered" Color="Color.Warning">Bordered</MudSwitch>
</div>

@code {
    private IEnumerable<Element> Elements = new List<Element>();
    private bool _hover;
    private bool _dense;
    private bool _striped;
    private bool _bordered;
    // apply an italic class to rows where the Element.Position == 0.
    private Func<Element, int, string> _rowClassFunc => (x, i) =>
        x.Position == 0 ? "datagrid-row-italic" : string.Empty;
    // apply classes to cells according to the element's number and molar mass.
    private Func<Element, string> _cellClassFunc => x =>
    {
        var classes = new List<string>();

        classes.Add(x.Number switch
        {
            1 => "datagrid-cell-element-1",
            2 => "datagrid-cell-element-2",
            3 => "datagrid-cell-element-3",
            4 => "datagrid-cell-element-4",
            _ => string.Empty
        });

        if (x.Molar > 5)
            classes.Add("datagrid-cell-heavy-molar");

        return string.Join(" ", classes.Where(c => c.Length > 0));
    };

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
