@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid Items="@_elements" Filterable="true" FilterMode="DataGridFilterMode.Simple">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
        <PropertyColumn Property="x => x.Group" Title="Category">
            <FilterTemplate>
                <MudStack Row Spacing="1" Style="width: 100%">
                    <MudSelect @bind-Value="context.FilterDefinition!.Operator" FullWidth="true" Dense="true" Margin="@Margin.Dense" 
                               Class="filter-operator" Label="Operator">
                        @foreach (var value in context.FilterDefinition.Column!.GetFilterOperators(context.FilterDefinition.FieldType))
                        {
                            <MudSelectItem Value="@value">@value</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" MultiSelection="true" 
                               SelectedValues="@GetFilterValues(context.FilterDefinition)" 
                               SelectedValuesChanged="@(values => SetFilterValues(context.FilterDefinition, values))" 
                               FullWidth="true" Dense="true" Margin="@Margin.Dense" 
                               Class="filter-input category-filter" 
                               Label="Value" Clearable="true" Placeholder="Select categories">
                        @foreach (var category in _categories)
                        {
                            <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                        }
                    </MudSelect>
                </MudStack>
            </FilterTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Element" />
    </PagerContent>
</MudDataGrid>

@code {
    private IEnumerable<Element> _elements = new List<Element>();
    private readonly List<string> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable") ?? new List<Element>();
        _categories.AddRange(_elements.Select(x => x.Group).Distinct().OrderBy(x => x).ToList());
    }

    private IReadOnlyCollection<string> GetFilterValues(IFilterDefinition<Element> context)
    {
        return context.Value as IReadOnlyCollection<string> ?? Array.Empty<string>();
    }

    private void SetFilterValues(IFilterDefinition<Element> context, IEnumerable<string> values)
    {
        var selectedValues = values?.ToList() ?? [];
        context.Value = selectedValues.Count > 0 ? selectedValues : null;

        // Set custom FilterFunction to handle multiple values
        if (context is FilterDefinition<Element> filterDef)
        {
            if (selectedValues.Count > 0)
            {
                filterDef.FilterFunction = item => selectedValues.Contains(item.Group);
            }
            else
            {
                filterDef.FilterFunction = null;
            }
        }
    }
}
