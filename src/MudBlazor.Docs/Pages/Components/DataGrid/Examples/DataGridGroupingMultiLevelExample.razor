@using System.Net.Http.Json
@using System.Threading
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient HttpClient

<MudDataGrid @ref="_dataGrid" T="Company"
             ServerData="ServerReload"
             Groupable
             FixedHeader
             Height="500px">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Company Org</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="OnSearch" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Department" Title="Department" Grouping GroupExpanded />
        <PropertyColumn Property="x => x.Team" Title="Team" Grouping GroupByOrder="1" GroupExpanded />
        <PropertyColumn Property="x => x.Role" Title="Role" Grouping GroupByOrder="2" GroupExpanded />
        <PropertyColumn Property="x => x.Name" Title="Name" Groupable="false" />
        <PropertyColumn Property="x => x.Score" Title="Score" Groupable="false" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Company" />
    </PagerContent>
</MudDataGrid>

@code {
#nullable enable
    private IReadOnlyCollection<Company> _org = [];

    private MudDataGrid<Company> _dataGrid = null!;
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        _org = await HttpClient.GetFromJsonAsync<List<Company>>("webapi/company") ?? [];
    }

    private Task<GridData<Company>> ServerReload(GridState<Company> state, CancellationToken _)
    {
        var data = _org.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var c = StringComparison.OrdinalIgnoreCase;
            var n = string.Empty;
            data = data.Where(x =>
                (x.Department ?? n).Contains(_search, c)
                || (x.Team ?? n).Contains(_search, c)
                || (x.Role ?? n).Contains(_search, c)
                || (x.Name ?? n).Contains(_search, c));
        }

        IOrderedEnumerable<Company>? ordered = null;
        foreach (var s in state.SortDefinitions)
        {
            Func<Company, object?> key = s.SortBy switch
            {
                nameof(Company.Department) => x => x.Department,
                nameof(Company.Team) => x => x.Team,
                nameof(Company.Role) => x => x.Role,
                nameof(Company.Name) => x => x.Name,
                nameof(Company.Score) => x => x.Score,
                _ => x => x.Name
            };

            ordered = ordered is null
                ? (s.Descending ? data.OrderByDescending(key) : data.OrderBy(key))
                : (s.Descending ? ordered.ThenByDescending(key) : ordered.ThenBy(key));
        }

        if (ordered is not null)
        {
            data = ordered;
        }

        var list = data.ToList();
        return Task.FromResult(new GridData<Company>
        {
            TotalItems = list.Count,
            Items = list.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray()
        });
    }

    private Task OnSearch(string value)
    {
        _search = value;
        return _dataGrid.ReloadServerData();
    }
}
