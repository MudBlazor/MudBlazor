@using System.Threading
@namespace MudBlazor.Docs.Examples

<MudDataGrid @ref="_dataGrid" T="Company"
             ServerData="ServerReload"
             Groupable
             FixedHeader
             Height="500px">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Company Org</MudText>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="OnSearch" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Department" Title="Department" Grouping GroupExpanded />
        <PropertyColumn Property="x => x.Team" Title="Team" Grouping GroupByOrder="1" GroupExpanded />
        <PropertyColumn Property="x => x.Role" Title="Role" Grouping GroupByOrder="2" GroupExpanded />
        <PropertyColumn Property="x => x.Name" Title="Name" Groupable="false" />
        <PropertyColumn Property="x => x.Score" Title="Score" Groupable="false" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Company" />
    </PagerContent>
</MudDataGrid>

@code {
#nullable enable
    private static readonly IReadOnlyCollection<Company> _org = Company.GetRecords();

    private MudDataGrid<Company> _dataGrid = null!;
    private string? _search;

    private Task<GridData<Company>> ServerReload(GridState<Company> state, CancellationToken _)
    {
        var data = _org.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var c = StringComparison.OrdinalIgnoreCase;
            var n = string.Empty;
            data = data.Where(x =>
                (x.Department ?? n).Contains(_search, c)
                || (x.Team ?? n).Contains(_search, c)
                || (x.Role ?? n).Contains(_search, c)
                || (x.Name ?? n).Contains(_search, c));
        }

        var s = state.SortDefinitions.FirstOrDefault();
        if (s is not null)
        {
            var d = s.Descending ? SortDirection.Descending : SortDirection.Ascending;
            data = s.SortBy switch
            {
                nameof(Company.Department) => data.OrderByDirection(d, x => x.Department),
                nameof(Company.Team) => data.OrderByDirection(d, x => x.Team),
                nameof(Company.Role) => data.OrderByDirection(d, x => x.Role),
                nameof(Company.Name) => data.OrderByDirection(d, x => x.Name),
                nameof(Company.Score) => data.OrderByDirection(d, x => x.Score),
                _ => data
            };
        }

        var total = data.Count();
        return Task.FromResult(new GridData<Company>
        {
            TotalItems = total,
            Items = data.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray()
        });
    }

    private Task OnSearch(string value)
    {
        _search = value;
        return _dataGrid.ReloadServerData();
    }
}
