@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid @ref="_dataGrid" T="Element" Items="@_elements" Hover="true" RowStyle="cursor: pointer;" RowClick="OnRowClickAsync">
    <Columns>
        <HierarchyColumn T="Element" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
    </Columns>
    <ChildRowContent>
        <MudText>@context.Item.Name is element number @context.Item.Number.</MudText>
    </ChildRowContent>
    <PagerContent>
        <MudDataGridPager T="Element" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<Element> _dataGrid = null!;
    private IEnumerable<Element> _elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private Task OnRowClickAsync(DataGridRowClickEventArgs<Element> args)
    {
        return _dataGrid.ToggleHierarchyVisibilityAsync(args.Item);
    }
}
