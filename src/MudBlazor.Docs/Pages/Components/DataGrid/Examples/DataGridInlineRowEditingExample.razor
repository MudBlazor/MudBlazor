@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudDataGrid @ref="_dataGrid"
             T="Element"
             Items="@_elements"
             ReadOnly="false"
             EditMode="DataGridEditMode.Inline"
             EditTrigger="DataGridEditTrigger.Manual"
             StartedEditingItem="@StartedEditingItem"
             CanceledEditingItem="@CanceledEditingItem"
             CommittedItemChanges="@CommittedItemChanges"
             Bordered="true"
             Dense="true"
             Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Inline Row Editing</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        @* Non-editable column - always shows plain text *@
        <PropertyColumn Property="x => x.Number" Title="Nr" Editable="false" />

        @* Editable columns using EditTemplate to show inputs only when row is being edited *@
        <PropertyColumn Property="x => x.Sign" Title="Sign">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Sign"
                              Margin="Margin.Dense"
                              Variant="Variant.Text"
                              Required="true"
                              Immediate="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Name" Title="Name">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name"
                              Margin="Margin.Dense"
                              Variant="Variant.Text"
                              Required="true"
                              Immediate="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Position" Title="Position">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Position"
                           Margin="Margin.Dense"
                           Variant="Variant.Text"
                           Dense="true">
                    <MudSelectItem Value="0">zero</MudSelectItem>
                    <MudSelectItem Value="1">one</MudSelectItem>
                    <MudSelectItem Value="2">two</MudSelectItem>
                    <MudSelectItem Value="17">seventeen</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Molar" Title="Molar Mass" Format="F2">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Molar"
                                 Margin="Margin.Dense"
                                 Variant="Variant.Text"
                                 Immediate="true" />
            </EditTemplate>
        </PropertyColumn>

        @* Actions column - shows Edit button or Save/Cancel buttons based on edit state *@
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                @if (context.IsEditing)
                {
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Check"
                                   Color="Color.Success"
                                   AriaLabel="Save changes"
                                   OnClick="@context.Actions.CommitEditingItemAsync" />
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Error"
                                   AriaLabel="Cancel editing"
                                   OnClick="@context.Actions.CancelEditingItemAsync" />
                }
                else
                {
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Outlined.Edit"
                                   Disabled="@_isEditing"
                                   AriaLabel="Edit row"
                                   OnClick="@context.Actions.StartEditingItemAsync" />
                    <MudIconButton Size="Size.Small"
                                   Icon="@Icons.Material.Outlined.Delete"
                                   Disabled="@_isEditing"
                                   AriaLabel="Delete row"
                                   OnClick="@(() => DeleteItem(context.Item))" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<MudExpansionPanels Class="mt-4" Style="flex:1">
    <MudExpansionPanel Text="Show Events">
        @foreach (var message in _events)
        {
            <MudText Typo="@Typo.body2">@message</MudText>
        }
        @if (_events.Count > 0)
        {
            <div class="d-flex">
                <MudSpacer />
                <MudButton Class="mt-3" ButtonType="ButtonType.Button" Variant="Variant.Filled" OnClick="@(() => _events.Clear())">Clear</MudButton>
            </div>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private MudDataGrid<Element> _dataGrid = default!;
    private List<Element> _elements = [];
    private List<string> _events = [];
    private bool _isEditing;

    protected override async Task OnInitializedAsync()
    {
        var elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
        _elements = elements?.Take(5).ToList() ?? [];
    }

    private void StartedEditingItem(Element item)
    {
        _isEditing = true;
        _events.Insert(0, $"Started editing: {item.Name}");
    }

    private void CanceledEditingItem(Element item)
    {
        _isEditing = false;
        _events.Insert(0, $"Canceled editing: {item.Name}");
    }

    private Task<DataGridEditFormAction> CommittedItemChanges(Element item)
    {
        // Perform validation
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            _events.Insert(0, "Validation failed: Name is required");
            return Task.FromResult(DataGridEditFormAction.KeepOpen);
        }

        if (string.IsNullOrWhiteSpace(item.Sign))
        {
            _events.Insert(0, "Validation failed: Sign is required");
            return Task.FromResult(DataGridEditFormAction.KeepOpen);
        }

        if (item.Molar < 0)
        {
            _events.Insert(0, "Validation failed: Molar mass must be non-negative");
            return Task.FromResult(DataGridEditFormAction.KeepOpen);
        }

        _isEditing = false;
        _events.Insert(0, $"Saved: {item.Name} (Sign={item.Sign}, Position={item.Position}, Molar={item.Molar:F2})");
        return Task.FromResult(DataGridEditFormAction.Close);
    }

    private void DeleteItem(Element item)
    {
        _elements.Remove(item);
        _events.Insert(0, $"Deleted: {item.Name}");
    }
}
