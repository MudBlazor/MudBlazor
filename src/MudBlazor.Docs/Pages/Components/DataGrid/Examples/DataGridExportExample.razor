            workbookStylesPart1.Stylesheet = stylesheet1;
        }

    }
     
    /// <summary>
    /// Renders components to strings 
    /// </summary>
    /// <typeparam name="T"></typeparam>
    public class BlazorRenderer
    {
        private readonly HtmlRenderer _htmlRenderer;
        public BlazorRenderer(HtmlRenderer htmlRenderer)
        {
            _htmlRenderer = htmlRenderer;
        }

        public BlazorRenderer(IServiceProvider serviceProvider, ILoggerFactory loggerFactory)
        {
            _htmlRenderer = new HtmlRenderer(serviceProvider, loggerFactory);
        }

        // Renders a component T which doesn't require any parameters
        public Task<string> RenderComponent<T>() where T : IComponent
            => RenderComponent<T>(ParameterView.Empty);

        // Renders a component T using the provided dictionary of parameters
        public Task<string> RenderComponent<T>(Dictionary<string, object?> dictionary) where T : IComponent
            => RenderComponent<T>(ParameterView.FromDictionary(dictionary));

        private Task<string> RenderComponent<T>(ParameterView parameters) where T : IComponent
        {
            // Use the default dispatcher to invoke actions in the context of the
            // static HTML renderer and return as a string
            return _htmlRenderer.Dispatcher.InvokeAsync(async () =>
            {
                HtmlRootComponent output = await _htmlRenderer.RenderComponentAsync<T>(parameters);
                return output.ToHtmlString();
            });
        }

        public async Task<string> RenderComponent<T>(RenderFragment<T> fragment, T value)
            => await RenderComponent(fragment.Invoke(value));

        public async Task<string> RenderComponent(RenderFragment fragment)
        {
            return await _htmlRenderer.Dispatcher.InvokeAsync(async () =>
            {
                var parameters = ParameterView.FromDictionary(new Dictionary<string, object?> { { nameof(BaseComponentRenderer.ChildContent), fragment } });

                return await RenderComponent<BaseComponentRenderer>(parameters);
            });
        }

        /// <summary>
        /// Accepts a renderfragment to render as a component
        /// </summary>
        private class BaseComponentRenderer : ComponentBase
        {
            [Parameter, EditorRequired]
            public required RenderFragment ChildContent { get; set; }

            protected override void BuildRenderTree(RenderTreeBuilder __builder)
            {
                __builder.AddContent(0, ChildContent);
                base.BuildRenderTree(__builder);
            }
        }
    }

