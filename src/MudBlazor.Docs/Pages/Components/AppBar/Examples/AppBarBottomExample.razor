@layout IframeLayout
@namespace MudBlazor.Docs.Examples
@page "/iframe/docs/examples/appbar/bottom"

<MudLayout>
    <MudMainContent Class="pt-0">
        <MudList T="string">
            <MudListItem Value='"App Bookmark Item 1"' Icon="@Icons.Material.Filled.Bookmark">App Bookmark Item 1</MudListItem>
            <MudListItem Value='"App Bookmark Item 2"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Primary">App Bookmark Item 2</MudListItem>
            <MudListItem Value='"App Bookmark Item 3"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Secondary">App Bookmark Item 3</MudListItem>
            <MudListItem Value='"App Bookmark Item 4"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Tertiary">App Bookmark Item 4</MudListItem>
            <MudListItem Value='"App Bookmark Item 5"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Info">App Bookmark Item 5</MudListItem>
            <MudListItem Value='"App Bookmark Item 6"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Success">App Bookmark Item 6</MudListItem>
            <MudListItem Value='"App Bookmark Item 7"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Warning">App Bookmark Item 7</MudListItem>
            <MudListItem Value='"App Bookmark Item 8"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Error">App Bookmark Item 8</MudListItem>
            <MudListItem Value='"App Bookmark Item 9"' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Dark">App Bookmark Item 9</MudListItem>
        </MudList>
    </MudMainContent>
    <MudAppBar Bottom="true" Fixed="true" Color="Color.Primary" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Inherit" Edge="Edge.End" />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </MudAppBar>
</MudLayout>


@code{
    bool open = false;

    void ToggleDrawer()
    {
        open = !open;
    }
}
