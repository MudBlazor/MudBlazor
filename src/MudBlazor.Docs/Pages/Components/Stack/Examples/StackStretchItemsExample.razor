@namespace MudBlazor.Docs.Examples

<MudPaper Outlined Class="border-dashed">
    <MudStack StretchItems="@stretch" Row>
        <MudPaper Class="pa-3 mud-theme-primary">Item 1</MudPaper>
        <MudPaper Class="pa-3 mud-theme-primary">Item 2</MudPaper>
        <MudPaper Class="pa-3 mud-theme-primary">Item 3</MudPaper>
    </MudStack>
</MudPaper>

<MudChipSet @bind-SelectedValue="@stretch" Class="mt-12" >
    <MudChip Value="StretchItems.None" SelectedColor="Color.Primary">Do Not Stretch</MudChip>
    <MudChip Value="StretchItems.Start" SelectedColor="Color.Primary" Default="true">Stretch First</MudChip>
    <MudChip Value="StretchItems.StartAndEnd" SelectedColor="Color.Primary">Stretch First and Last</MudChip>
    <MudChip Value="StretchItems.End" SelectedColor="Color.Primary">Stretch Last</MudChip>
    <MudChip Value="StretchItems.Middle" SelectedColor="Color.Primary">Stretch Middle</MudChip>
    <MudChip Value="StretchItems.All" SelectedColor="Color.Primary">Stretch All</MudChip>
</MudChipSet>

@code {
    StretchItems stretch = StretchItems.Start;
}