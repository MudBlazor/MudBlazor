@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid Class="pa-4">
    <MudItem xs="12" md="6">
        <MudAutocomplete T="string" Label="Search actions"
                         @bind-Value="_value"
                         SearchFunc="SearchAsync"
                         DebounceInterval="_debounce"
                         Clearable="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         HelperText="Adjust debounce to change call rate" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Debounce interval (ms)</MudText>
            <MudSlider T="int" @bind-Value="_debounce" Min="0" Max="800" Step="50" Color="Color.Primary" />
            <MudText Typo="Typo.caption">Interval: @_debounce ms</MudText>
            <MudText Typo="Typo.caption">Search calls: @_searchCalls</MudText>
            <MudText Typo="Typo.caption">Last input: @(_lastSearch ?? "None")</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _value;
    private int _debounce;
    private int _searchCalls;
    private string _lastSearch;

    private readonly string[] _items =
    [
        "Alignment", "Annotation", "Calibration", "Cataloging",
        "Clustering", "Correlation", "Decoding", "Deconvolve",
        "Detection", "Extraction", "Filtering", "Fitting",
        "Indexing", "Inversion", "Mapping", "Matching",
        "Normalization", "Optimization", "Reconstruction", "Regression",
        "Sampling", "Scheduling", "Simulation", "Smoothing",
        "Stacking", "Streaming", "Tracking", "Validation"
    ];

    private async Task<IEnumerable<string>> SearchAsync(string value, CancellationToken token)
    {
        _searchCalls++;
        _lastSearch = value ?? string.Empty;
        await InvokeAsync(StateHasChanged);

        if (string.IsNullOrWhiteSpace(value))
        {
            return _items;
        }

        return _items.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
}
