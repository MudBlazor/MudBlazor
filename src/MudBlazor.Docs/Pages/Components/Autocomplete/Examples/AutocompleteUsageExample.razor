@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="string" Label="Feature"
                         @bind-Value="_feature"
                         SearchFunc="SearchAll"
                         DebounceInterval="0"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         HelperText="Shows all items when empty" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="string" Label="Type at least 2 letters"
                         @bind-Value="_featureTyped"
                         SearchFunc="SearchTyped"
                         DebounceInterval="0"
                         MinCharacters="2"
                         Clearable="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Secondary"
                         HelperText="Only opens after typing" />
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudChip T="string">Primary: @(_feature ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Secondary">Typed: @(_featureTyped ?? "None")</MudChip>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private string _feature;
    private string _featureTyped;

    private readonly string[] _features =
    [
        "Accounts", "Activity", "Alerts", "Analytics",
        "Approvals", "Archives", "Billing", "Calendar",
        "Chat", "Dashboard", "Exports", "Files",
        "Imports", "Insights", "Invoices", "Notes",
        "Notifications", "Profile", "Projects", "Reports",
        "Search", "Security", "Settings", "Tags",
        "Tasks", "Teams", "Timeline", "Uploads",
        "Users", "Workflows"
    ];

    private Task<IEnumerable<string>> SearchAll(string value, CancellationToken token)
    {
        IEnumerable<string> result = _features;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = _features.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> SearchTyped(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            return Task.FromResult<IEnumerable<string>>(Array.Empty<string>());
        }

        var result = _features.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult(result);
    }
}
