@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="string" Label="More items"
                         @bind-Value="_moreItems"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         MaxItems="5"
                         Clearable="true">
            <MoreItemsTemplate>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="px-4 py-2">
                    Only the first 5 results are shown
                </MudText>
            </MoreItemsTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="string" Label="No results"
                         @bind-Value="_noItems"
                         SearchFunc="SearchEmpty"
                         DebounceInterval="0"
                         Clearable="true">
            <NoItemsTemplate>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="px-4 py-2">
                    No matches found
                </MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="string" Label="Custom header/footer"
                         @bind-Value="_decorated"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         Clearable="true">
            <BeforeItemsTemplate>
                <MudText Typo="Typo.caption" Class="px-4 py-2">Popular commands</MudText>
            </BeforeItemsTemplate>
            <AfterItemsTemplate>
                <MudDivider />
                <MudText Typo="Typo.caption" Class="px-4 py-2">Tip: press Enter to select</MudText>
            </AfterItemsTemplate>
        </MudAutocomplete>
    </MudItem>
</MudGrid>

@code {
    private string _moreItems;
    private string _noItems;
    private string _decorated;

    private readonly string[] _commands =
    [
        "Add", "Archive", "Assign", "Build", "Clone", "Commit",
        "Deploy", "Draft", "Merge", "Publish", "Rebase", "Release",
        "Review", "Revert", "Sync", "Tag", "Test", "Update"
    ];

    private Task<IEnumerable<string>> Search(string value, CancellationToken token)
    {
        IEnumerable<string> result = _commands;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = _commands.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> SearchEmpty(string value, CancellationToken token)
        => Task.FromResult<IEnumerable<string>>(Array.Empty<string>());
}
