@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 mud-width-full" Elevation="3">
            <MudStack Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">Debounce feel</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Type quickly and watch the call count change.</MudText>
                </MudStack>
                <MudAutocomplete T="string" Label="Search cities" @bind-Value="_value"
                                 SearchFunc="@Search"
                                 DebounceInterval="@_debounceMs"
                                 Clearable="true"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                <MudStack Row Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                    <MudChip T="string" Variant="Variant.Outlined">Value: @(_value ?? "None")</MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Calls: @_searchCalls</MudChip>
                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Last query: @(_lastQuery ?? "-")</MudChip>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 mud-width-full" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Debounce interval</MudText>
                <MudText Typo="Typo.caption">Milliseconds</MudText>
                <MudSlider T="int" @bind-Value="_debounceMs" Min="0" Max="500" Step="50" />
                <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                    <MudChip T="string" Variant="Variant.Outlined">0 = instant</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined">300+ = calmer</MudChip>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _value;
    private int _debounceMs = 300;
    private int _searchCalls;
    private string _lastQuery;

    private readonly string[] _cities =
    {
        "Amsterdam", "Austin", "Bangkok", "Barcelona", "Berlin", "Boston",
        "Chicago", "Copenhagen", "Dubai", "Dublin", "Helsinki", "Kyoto",
        "Lisbon", "London", "Los Angeles", "Melbourne", "Miami", "Montreal",
        "New York", "Oslo", "Paris", "Prague", "Rome", "San Diego",
        "San Francisco", "Seoul", "Singapore", "Stockholm", "Sydney", "Tokyo",
        "Toronto", "Vancouver", "Vienna", "Zurich"
    };

    private async Task<IEnumerable<string>> Search(string value, CancellationToken token)
    {
        _searchCalls++;
        _lastQuery = value ?? string.Empty;

        var results = string.IsNullOrWhiteSpace(value)
            ? _cities
            : _cities.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));

        await InvokeAsync(StateHasChanged);
        return results;
    }
}
