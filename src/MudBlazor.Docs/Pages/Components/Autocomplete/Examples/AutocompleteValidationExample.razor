@namespace MudBlazor.Docs.Examples
@using System.ComponentModel.DataAnnotations
@using System.Threading

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudAutocomplete T="string" Label="Team (EditForm)"
                             @bind-Value="_choice.Team"
                             For="@(() => _choice.Team)"
                             SearchFunc="SearchAsync"
                             DebounceInterval="0"
                             Required="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="_coerceValue"
                             Clearable="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Primary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ValidateEditForm">
                Validate
            </MudButton>
            @if (_editValid)
            {
                <MudText Color="Color.Success" Typo="Typo.caption">Valid selection</MudText>
            }
        </EditForm>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudForm @ref="_mudForm">
            <MudAutocomplete T="string" Label="Team (MudForm)"
                             @bind-Value="_manualTeam"
                             SearchFunc="SearchAsync"
                             DebounceInterval="0"
                             Required="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="_coerceValue"
                             Clearable="true"
                             Validation="@(new Func<string, IEnumerable<string>>(ValidateTeam))"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Secondary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="@(() => _mudForm.Validate())">
                Validate
            </MudButton>
            <MudText Typo="Typo.caption">IsValid: @(_mudForm?.IsValid ?? false)</MudText>
        </MudForm>
    </MudItem>
    <MudItem xs="12">
        <MudSwitch @bind-Value="_coerceValue" Color="Color.Tertiary">Coerce Value</MudSwitch>
    </MudItem>
</MudGrid>

@code {
    private MudForm _mudForm;
    private bool _coerceValue;
    private bool _editValid;
    private Choice _choice = new();
    private EditContext _editContext;
    private string _manualTeam;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_choice);
    }

    private static readonly string[] Teams =
    [
        "Design", "Development", "Documentation", "Engineering",
        "Finance", "Operations", "People", "Product",
        "Quality", "Research", "Security", "Support"
    ];

    private Task<IEnumerable<string>> SearchAsync(string value, CancellationToken token)
    {
        IEnumerable<string> result = Teams;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = Teams.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    private void ValidateEditForm()
    {
        _editValid = _editContext.Validate();
    }

    private IEnumerable<string> ValidateTeam(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "Team is required";
            yield break;
        }

        if (!Teams.Any(team => team.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
        {
            yield return "Select a team from the list";
        }
    }

    public class Choice
    {
        [Required]
        [Team]
        public string Team { get; set; }
    }

    [AttributeUsage(AttributeTargets.Property | AttributeTargets.Field | AttributeTargets.Parameter)]
    public sealed class TeamAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext validationContext)
        {
            if (value is not string team ||
                !Teams.Any(item => item.Equals(team, StringComparison.InvariantCultureIgnoreCase)))
            {
                return new ValidationResult("Select a team from the list", new[] { validationContext.MemberName });
            }

            return ValidationResult.Success;
        }
    }
}
