@namespace MudBlazor.Docs.Examples
@using System.ComponentModel.DataAnnotations
@using System.Threading

<MudGrid>
    <MudItem xs="12" sm="6">
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudAutocomplete T="string" Label="State (EditForm)"
                             @bind-Value="_choice.State"
                             For="@(() => _choice.State)"
                             SearchFunc="SearchAsync"
                             DebounceInterval="0"
                             Required="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="_coerceValue"
                             Clearable="true"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Primary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ValidateEditForm">
                Validate
            </MudButton>
            @if (_editValid)
            {
                <MudText Color="Color.Success" Typo="Typo.caption">Valid selection</MudText>
            }
        </EditForm>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudForm @ref="_mudForm">
            <MudAutocomplete T="string" Label="State (MudForm)"
                             @bind-Value="_manualState"
                             SearchFunc="SearchAsync"
                             DebounceInterval="0"
                             Required="true"
                             ResetValueOnEmptyText="true"
                             CoerceValue="_coerceValue"
                             Clearable="true"
                             Validation="@(new Func<string, IEnumerable<string>>(ValidateState))"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             AdornmentColor="Color.Secondary" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="@(() => _mudForm.Validate())">
                Validate
            </MudButton>
            <MudText Typo="Typo.caption">IsValid: @(_mudForm?.IsValid ?? false)</MudText>
        </MudForm>
    </MudItem>
    <MudItem xs="12">
        <MudSwitch @bind-Value="_coerceValue" Color="Color.Tertiary">Coerce Value</MudSwitch>
    </MudItem>
</MudGrid>

@code {
    private MudForm _mudForm;
    private bool _coerceValue;
    private bool _editValid;
    private Choice _choice = new();
    private EditContext _editContext;
    private string _manualState;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_choice);
    }

    private static readonly string[] States =
    [
        "Alabama", "Alaska", "American Samoa", "Arizona",
        "Arkansas", "California", "Colorado", "Connecticut",
        "Delaware", "District of Columbia", "Federated States of Micronesia",
        "Florida", "Georgia", "Guam", "Hawaii", "Idaho",
        "Illinois", "Indiana", "Iowa", "Kansas", "Kentucky",
        "Louisiana", "Maine", "Marshall Islands", "Maryland",
        "Massachusetts", "Michigan", "Minnesota", "Mississippi",
        "Missouri", "Montana", "Nebraska", "Nevada",
        "New Hampshire", "New Jersey", "New Mexico", "New York",
        "North Carolina", "North Dakota", "Northern Mariana Islands", "Ohio",
        "Oklahoma", "Oregon", "Palau", "Pennsylvania", "Puerto Rico",
        "Rhode Island", "South Carolina", "South Dakota", "Tennessee",
        "Texas", "Utah", "Vermont", "Virgin Island", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming",
    ];

    private Task<IEnumerable<string>> SearchAsync(string value, CancellationToken token)
    {
        IEnumerable<string> result = States;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = States.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    private void ValidateEditForm()
    {
        _editValid = _editContext.Validate();
    }

    private IEnumerable<string> ValidateState(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            yield return "State is required";
            yield break;
        }

        if (!States.Any(state => state.Equals(value, StringComparison.InvariantCultureIgnoreCase)))
        {
            yield return "Select a state from the list";
        }
    }

    public class Choice
    {
        [Required]
        [State]
        public string State { get; set; }
    }

    [AttributeUsage(AttributeTargets.Property | AttributeTargets.Field | AttributeTargets.Parameter)]
    public sealed class StateAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext validationContext)
        {
            if (value is not string state ||
                !States.Any(item => item.Equals(state, StringComparison.InvariantCultureIgnoreCase)))
            {
                return new ValidationResult("Select a state from the list", new[] { validationContext.MemberName });
            }

            return ValidationResult.Success;
        }
    }
}
