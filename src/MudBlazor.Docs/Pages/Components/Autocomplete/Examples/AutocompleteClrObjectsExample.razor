@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="Location" Label="Location"
                         @bind-Value="_location"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         ToStringFunc="@(location => location?.DisplayName)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="Location" Label="Template"
                         @bind-Value="_templated"
                         SearchFunc="Search"
                         DebounceInterval="0">
            <ItemTemplate Context="location">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body1">@location.Name</MudText>
                    <MudText Typo="Typo.caption">@location.Zone</MudText>
                </MudStack>
            </ItemTemplate>
            <ItemSelectedTemplate Context="location">
                <MudText>@location.DisplayName</MudText>
            </ItemSelectedTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="Location" Label="Disable smaller locations"
                         @bind-Value="_disabled"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         ItemDisabledFunc="@(location => location.Capacity < 700)">
            <ItemDisabledTemplate Context="location">
                <MudText Color="Color.Secondary">@location.DisplayName (too small)</MudText>
            </ItemDisabledTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudChip T="string">Default: @(_location?.DisplayName ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Primary">Templated: @(_templated?.DisplayName ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Secondary">Disabled: @(_disabled?.DisplayName ?? "None")</MudChip>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private Location _location;
    private Location _templated;
    private Location _disabled;

    private readonly Location[] _locations =
    [
        new("Harbor", "Zone A", 920),
        new("Meadow", "Zone B", 640),
        new("Oakridge", "Zone C", 780),
        new("Pinecrest", "Zone D", 610),
        new("Riverside", "Zone E", 560),
        new("Stonegate", "Zone F", 840),
        new("Summit", "Zone G", 730)
    ];

    private Task<IEnumerable<Location>> Search(string value, CancellationToken token)
    {
        IEnumerable<Location> result = _locations;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = _locations.Where(location =>
                location.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
                location.Zone.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    public record Location(string Name, string Zone, int Capacity)
    {
        public string DisplayName => $"{Name} - {Zone}";
        public override string ToString() => DisplayName;
    }
}
