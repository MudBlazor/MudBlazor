@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@using System.Threading
@namespace MudBlazor.Docs.Examples
@inject HttpClient httpClient

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline">Objects with ToString</MudText>
            <MudAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value1"
                             SearchFunc="@Search" ToStringFunc="@(e => e == null ? null : $"{e.Name} ({e.Sign})")"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Science" />
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline">Custom item templates</MudText>
            <MudAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value2"
                             SearchFunc="@Search" ToStringFunc="@(e => e == null ? null : $"{e.Name} ({e.Sign})")"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.EmojiObjects">
                <ItemTemplate Context="e">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudAvatar Color="Color.Primary" Size="Size.Small">@e.Sign</MudAvatar>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">@e.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">#@e.Number - @e.Group</MudText>
                        </MudStack>
                    </MudStack>
                </ItemTemplate>
                <ItemSelectedTemplate Context="e">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudAvatar Color="Color.Success" Size="Size.Small">@e.Sign</MudAvatar>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">@e.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Selected</MudText>
                        </MudStack>
                    </MudStack>
                </ItemSelectedTemplate>
            </MudAutocomplete>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline">Disabled items</MudText>
            <MudAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value3"
                             SearchFunc="@Search" ItemDisabledFunc="@((Element e) => (e.Name.Contains("H")))"
                             ToStringFunc="@(e => e == null ? null : $"{e.Name} ({e.Sign})")"
                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Block">
                <ItemDisabledTemplate>
                    <MudText Class="mud-text-disabled">Not available: @context.ToString()</MudText>
                </ItemDisabledTemplate>
            </MudAutocomplete>
        </MudStack>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.caption" Class="mr-2">Selected</MudText>
            <MudChip T="string" Variant="Variant.Outlined">@(value1?.ToString() ?? "None")</MudChip>
            <MudChip T="string" Variant="Variant.Outlined">@(value2?.ToString() ?? "None")</MudChip>
            <MudChip T="string" Variant="Variant.Outlined">@(value3?.ToString() ?? "None")</MudChip>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private Element value1, value2, value3;

    private async Task<IEnumerable<Element>> Search(string value, CancellationToken token)
    {
        return  await httpClient.GetFromJsonAsync<List<Element>>($"webapi/periodictable/{value}", token);
    }
}
