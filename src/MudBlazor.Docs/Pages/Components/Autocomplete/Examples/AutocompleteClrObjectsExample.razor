@namespace MudBlazor.Docs.Examples
@using System.Threading

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="City" Label="City"
                         @bind-Value="_city"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         ToStringFunc="@(city => city?.DisplayName)" />
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="City" Label="Template"
                         @bind-Value="_templated"
                         SearchFunc="Search"
                         DebounceInterval="0">
            <ItemTemplate Context="city">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body1">@city.Name</MudText>
                    <MudText Typo="Typo.caption">@city.State</MudText>
                </MudStack>
            </ItemTemplate>
            <ItemSelectedTemplate Context="city">
                <MudText>@city.DisplayName</MudText>
            </ItemSelectedTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudAutocomplete T="City" Label="Disable smaller cities"
                         @bind-Value="_disabled"
                         SearchFunc="Search"
                         DebounceInterval="0"
                         ItemDisabledFunc="@(city => city.Population < 700000)">
            <ItemDisabledTemplate Context="city">
                <MudText Color="Color.Secondary">@city.DisplayName (too small)</MudText>
            </ItemDisabledTemplate>
        </MudAutocomplete>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudChip T="string">Default: @(_city?.DisplayName ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Primary">Templated: @(_templated?.DisplayName ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Secondary">Disabled: @(_disabled?.DisplayName ?? "None")</MudChip>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private City _city;
    private City _templated;
    private City _disabled;

    private readonly City[] _cities =
    [
        new("Austin", "TX", 965000),
        new("Boston", "MA", 675000),
        new("Denver", "CO", 716000),
        new("Nashville", "TN", 703000),
        new("Portland", "OR", 652000),
        new("Raleigh", "NC", 469000),
        new("Seattle", "WA", 749000)
    ];

    private Task<IEnumerable<City>> Search(string value, CancellationToken token)
    {
        IEnumerable<City> result = _cities;

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = _cities.Where(city =>
                city.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
                city.State.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(result);
    }

    public record City(string Name, string State, int Population)
    {
        public string DisplayName => $"{Name}, {State}";
        public override string ToString() => DisplayName;
    }
}
