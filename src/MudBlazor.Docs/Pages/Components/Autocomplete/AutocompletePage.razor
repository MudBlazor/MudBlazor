@page "/components/autocomplete"

<DocsPage>
    <DocsPageHeader Title="Autocomplete" Component="@nameof(MudAutocomplete<T>)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Quick start">
                <Description>
                    Use a local list for instant filtering.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteUsageExample)">
                <AutocompleteUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Debouncing search">
                <Description>
                    Debounce controls how often <CodeInline>SearchFunc</CodeInline> runs while typing.
                    Keep it at 0 for local data, raise it (200-400ms) to reduce remote calls.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompletePlaygroundExample)">
                <AutocompletePlaygroundExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Text, value, and strictness">
                <Description>
                    Bind both <CodeInline>Value</CodeInline> and <CodeInline>Text</CodeInline> to see how
                    <CodeInline>Strict</CodeInline>, <CodeInline>CoerceText</CodeInline>, and <CodeInline>CoerceValue</CodeInline> affect behavior.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteStrictFalseExample)">
                <AutocompleteStrictFalseExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Objects and templates">
                <Description>
                    Use objects with <CodeInline>ToStringFunc</CodeInline> or render fragments for rich list items.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteClrObjectsExample)">
                <AutocompleteClrObjectsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="List extras">
                <Description>
                    Customize the list with <CodeInline Tag="true">MoreItemsTemplate</CodeInline>,
                    <CodeInline Tag="true">NoItemsTemplate</CodeInline>, and header/footer templates.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompletePresentationExtrasExample)">
                <AutocompletePresentationExtrasExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Validation">
                <Description>
                    Autocomplete works with EditForm and MudForm. Use <CodeInline>CoerceValue</CodeInline> when you want typed text to be validated.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteValidationExample)">
                <AutocompleteValidationExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Progress indicator">
                <Description>
                    When your search is async, show progress with a spinner or custom templates.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteProgressExample)">
                <AutocompleteProgressExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Cancellation token">
                <Description>
                    Forward the cancellation token to cancel in-flight requests when the user keeps typing.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteCancellationTokenExample)">
                <AutocompleteCancellationTokenExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keyboard navigation">
                <Description>
                    <MudText><CodeInline>Enter</CodeInline> or <CodeInline>ArrowDown</CodeInline> opens the list, <CodeInline>Escape</CodeInline> closes it.</MudText>
                    <MudText><CodeInline>ArrowUp</CodeInline>/<CodeInline>ArrowDown</CodeInline> move selection, <CodeInline>Enter</CodeInline> selects.</MudText>
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteUsageExample)">
                <AutocompleteUsageExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
