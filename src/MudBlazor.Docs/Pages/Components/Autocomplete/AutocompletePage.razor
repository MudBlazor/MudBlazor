@page "/components/autocomplete"

<DocsPage>
    <DocsPageHeader Title="Autocomplete" Component="@nameof(MudAutocomplete<T>)">
        <Description>
            Autocomplete gives you type-ahead search with your own data source. Bind a value, provide a search function, and the component handles filtering, selection, and async requests.
        </Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Quick Start">
                <Description>
                    Start with <CodeInline>SearchFunc</CodeInline> and <CodeInline>@@bind-Value</CodeInline>. Return a full list for open-on-focus behavior, or return an empty list until the user types. For local data, <CodeInline>DebounceInterval="0"</CodeInline> keeps it instant.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteUsageExample)">
                <AutocompleteUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Style Playground">
                <Description>
                    Dial in variants, density, and popover behavior while keeping search instant. This is a fast way to feel how <CodeInline>MinCharacters</CodeInline>, <CodeInline>OpenOnFocus</CodeInline>, and <CodeInline>Clearable</CodeInline> change the experience.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompletePlaygroundExample)">
                <AutocompletePlaygroundExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Objects and Templates">
                <Description>
                    When <CodeInline>T</CodeInline> is an object, Autocomplete uses <CodeInline>ToString()</CodeInline> for display. Override it with <CodeInline>ToStringFunc</CodeInline> or build rich rows with <CodeInline Tag="true">ItemTemplate</CodeInline>, <CodeInline Tag="true">ItemSelectedTemplate</CodeInline>, and <CodeInline Tag="true">ItemDisabledTemplate</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteClrObjectsExample)">
                <AutocompleteClrObjectsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="List Extras">
                <Description>
                    Control the list edges with <CodeInline Tag="true">NoItemsTemplate</CodeInline>, <CodeInline Tag="true">MoreItemsTemplate</CodeInline>, <CodeInline Tag="true">BeforeItemsTemplate</CodeInline>, and <CodeInline Tag="true">AfterItemsTemplate</CodeInline>. <CodeInline>MaxItems</CodeInline> decides when the "more items" state appears.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompletePresentationExtrasExample)">
                <AutocompletePresentationExtrasExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Validation">
                <Description>
                    Use Autocomplete inside <CodeInline Tag="true">EditForm</CodeInline> or <CodeInline Tag="true">MudForm</CodeInline> with standard validation. When users type custom text, <CodeInline>CoerceValue</CodeInline> lets you validate what they typed instead of only matched items.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteValidationExample)">
                <AutocompleteValidationExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Debouncing">
                <Description>
                    Debounce is a tradeoff: <CodeInline>0</CodeInline> feels instant for local lists, while <CodeInline>200-400</CodeInline> ms cuts network chatter. Pair it with <CodeInline>MinCharacters</CodeInline> when you want fewer calls and calmer UI.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteDebounceExample)">
                <AutocompleteDebounceExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Async Loading and Progress">
                <Description>
                    For remote searches, use <CodeInline>ShowProgressIndicator</CodeInline> and customize it with <CodeInline>ProgressIndicatorTemplate</CodeInline> or <CodeInline>ProgressIndicatorInPopoverTemplate</CodeInline>. <CodeInline>ProgressIndicatorColor</CodeInline> makes it match your theme.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteProgressExample)">
                <AutocompleteProgressExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Strict Mode">
                <Description>
                    Set <CodeInline>Strict="false"</CodeInline> to keep searching without reusing the current <CodeInline>Text</CodeInline> as the next query. Make sure <CodeInline>T</CodeInline> implements equality (record or overrides <CodeInline>Equals</CodeInline>/<CodeInline>GetHashCode</CodeInline>).
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteStrictFalseExample)">
                <AutocompleteStrictFalseExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Cancellation Token">
                <Description>
                    <CodeInline>SearchFunc</CodeInline> receives a <CodeInline>CancellationToken</CodeInline>. Forward it to your API calls so stale requests stop when the user keeps typing.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteCancellationTokenExample)">
                <AutocompleteCancellationTokenExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keyboard Shortcuts">
                <Description>
                    Autocomplete supports full keyboard navigation for search and selection.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false">
                <MudPaper Class="pa-4 mud-width-full" Elevation="2">
                    <MudList T="string" Dense="true">
                        <MudListItem><CodeInline>ArrowDown</CodeInline>/<CodeInline>ArrowUp</CodeInline> opens and moves through results</MudListItem>
                        <MudListItem><CodeInline>Enter</CodeInline> selects the highlighted item</MudListItem>
                        <MudListItem><CodeInline>Escape</CodeInline> or <CodeInline>Alt+ArrowUp</CodeInline> closes the list</MudListItem>
                        <MudListItem><CodeInline>Tab</CodeInline> selects when <CodeInline>SelectValueOnTab</CodeInline> is enabled</MudListItem>
                    </MudList>
                </MudPaper>
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
