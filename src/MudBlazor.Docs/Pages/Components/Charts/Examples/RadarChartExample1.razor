@namespace MudBlazor.Docs.Examples
@using MudBlazor.Charts

<MudChart ChartType="ChartType.Radar" ChartSeries="@_series" ChartLabels="@_chartLabels" @bind-SelectedIndex="_selectedIndex" ChartOptions="@_options" Width="650px" Height="400px">
    <CustomGraphics>
        <text class="mud-chart-selected-text" 
              x="300"
              y="30"
              dominant-baseline="middle"
              text-anchor="middle"
              fill="@_options.ChartPalette[Math.Max(0, _selectedIndex)]">@(_selectedIndex >= 0 ? $"Selected: {_chartLabels[_selectedIndex]}" : "")
        </text>
    </CustomGraphics>
</MudChart>

@code {
    private int _selectedIndex = -1;
    private string[] _chartLabels = { "Category A", "Category B", "Category C", "Category D", "Category E" };
    private List<ChartSeries> _series = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Development", Data = new double[] { 90, 80, 60, 70, 85 } },
    };

    private RadarChartOptions _options = new RadarChartOptions
    {
        ShowDataMarkers = true,
        DataPointRadius = 4,
        ShowAxisLabels = true,
        FillOpacity = 0.3,
        AngleOffset = 0,
        TooltipTitleFormat = "{{Y_VALUE}}",
        AggregationOption = AggregationOption.GroupByDataSet,
    };
}
