@namespace MudBlazor.Docs.Examples
@using MudBlazor.Charts

<MudChart @ref="_chart" ChartType="ChartType.Radar" ChartSeries="@_series" ChartLabels="@_chartLabels" ChartOptions="@_options" Width="650px" Height="400px">
    <CustomGraphics>
        <text class="mud-chart-selected-text" 
              x="300"
              y="30"
              dominant-baseline="middle"
              text-anchor="middle"
              fill="@_options.ChartPalette[0]">@(_selectedIndex >= 0 ? $"Selected: {_chartLabels[_selectedIndex]}" : "")
        </text>
    </CustomGraphics>
</MudChart>

@code {
    private MudChart _chart;
    private int _selectedIndex => (_chart?.ChartReference as Radar)?.SelectedPointIndex ?? -1;
    private string[] _chartLabels = { "Category A", "Category B", "Category C", "Category D", "Category E" };
    private List<ChartSeries> _series = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Development", Data = new double[] { 90, 80, 60, 70, 85 } },
    };

    private RadarChartOptions _options = new RadarChartOptions
    {
        ShowDataMarkers = true,
        DataPointRadius = 4,
        ShowAxisLabels = true,
        FillOpacity = 0.3,
        AngleOffset = 0,
        TooltipTitleFormat = "{{X_VALUE}}",
    };
}
