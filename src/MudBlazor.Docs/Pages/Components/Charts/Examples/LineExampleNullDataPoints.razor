@namespace MudBlazor.Docs.Examples

<div>
    <MudChart ChartType="ChartType.Line" ChartSeries="@Series" ChartLabels="@ChartLabels" Width="100%" Height="350px" ChartOptions="_options"></MudChart>

    <MudCheckBox T="bool" ValueChanged="(v) => _options.ConnectNullPoints = v" Label="Connect Null Points"></MudCheckBox>
</div>

@code {
    private LineChartOptions _options = new LineChartOptions()
    {
        YAxisTitle = "Visitors",
        XAxisTitle = "Date",
        ConnectNullPoints = false // default value
    };
    public List<ChartSeries<double>> Series = new List<ChartSeries<double>>()
    {
        new ChartSeries<double>() { Name = "2024", Data = new double[] { 180, 215, 195, 260, 240, 275, 290, 250, 285 } },
        new ChartSeries<double>() { Name = "2025", Data = new double?[] { 145, 190, null, 230, 210, 265, 280, 295, 270 } },
    };
    public string[] ChartLabels = { "Feb 27", "Feb 28", "Feb 29", "Mar 1", "Mar 2", "Mar 3", "Mar 4", "Mar 5", "Mar 6" };

}
