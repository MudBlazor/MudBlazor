@namespace MudBlazor.Docs.Examples

<MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <MudChip Value='"gray"' Variant="Variant.Text" Color="Color.Default">Default</MudChip>
    <MudChip Value='"purple"' Variant="Variant.Text" Color="Color.Primary">Primary</MudChip>
    <MudChip Value='"pink"' Variant="Variant.Text" Color="Color.Secondary">Secondary</MudChip>
    <MudChip Value='"blue"' Variant="Variant.Text" Color="Color.Info">Info</MudChip>
    <MudChip Value='"green"' Variant="Variant.Text" Color="Color.Success">Success</MudChip>
    <MudChip Value='"orange"' Variant="Variant.Text" Color="Color.Warning">Warning</MudChip>
    <MudChip Value='"red"' Variant="Variant.Text" Color="Color.Error">Error</MudChip>
    <MudChip Value='"black"' Variant="Variant.Text" Color="Color.Dark">Dark</MudChip>
</MudChipSet>
<MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <MudChip Value='"gray"' Variant="Variant.Outlined" Color="Color.Default">Default</MudChip>
    <MudChip Value='"purple"' Variant="Variant.Outlined" Color="Color.Primary">Primary</MudChip>
    <MudChip Value='"pink"' Variant="Variant.Outlined" Color="Color.Secondary">Secondary</MudChip>
    <MudChip Value='"blue"' Variant="Variant.Outlined" Color="Color.Info">Info</MudChip>
    <MudChip Value='"green"' Variant="Variant.Outlined" Color="Color.Success">Success</MudChip>
    <MudChip Value='"orange"' Variant="Variant.Outlined" Color="Color.Warning">Warning</MudChip>
    <MudChip Value='"red"' Variant="Variant.Outlined" Color="Color.Error">Error</MudChip>
    <MudChip Value='"black"' Variant="Variant.Outlined" Color="Color.Dark">Dark</MudChip>
</MudChipSet>
<MudChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <MudChip Value='"gray"' Variant="Variant.Filled" Color="Color.Default">Default</MudChip>
    <MudChip Value='"purple"' Variant="Variant.Filled" Color="Color.Primary">Primary</MudChip>
    <MudChip Value='"pink"' Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudChip>
    <MudChip Value='"blue"' Variant="Variant.Filled" Color="Color.Info">Info</MudChip>
    <MudChip Value='"green"' Variant="Variant.Filled" Color="Color.Success">Success</MudChip>
    <MudChip Value='"orange"' Variant="Variant.Filled" Color="Color.Warning">Warning</MudChip>
    <MudChip Value='"red"' Variant="Variant.Filled" Color="Color.Error">Error</MudChip>
    <MudChip Value='"black"' Variant="Variant.Filled" Color="Color.Dark">Dark</MudChip>
</MudChipSet>
<MudCheckBox @bind-Value="_checkMark">Check marks</MudCheckBox>


@code
{
    private bool _checkMark = true;
}

