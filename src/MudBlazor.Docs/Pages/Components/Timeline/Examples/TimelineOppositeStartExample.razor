@namespace MudBlazor.Docs.Examples

<MudTimeline TimelinePosition="TimelinePosition.Start">
    <MudTimelineItem Color="Color.Success">
        <ItemOpposite><MudText Color="Color.Success">13:37</MudText></ItemOpposite>
        <ItemContent><MudText>Reactor at optimum temperature</MudText></ItemContent>
    </MudTimelineItem>
    <MudTimelineItem Color="Color.Error">
        <ItemOpposite><MudText Color="Color.Error">15:00</MudText></ItemOpposite>
        <ItemContent><MudText>Meltdown is imminent</MudText></ItemContent>
    </MudTimelineItem>
</MudTimeline>
