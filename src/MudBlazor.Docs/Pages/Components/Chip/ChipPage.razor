@page "/components/chips"

<DocsPage>
    <DocsPageHeader Title="Chips" Component="@nameof(MudChip<T>)">
        <Description><br />See also: <MudLink Href="/components/chipset">ChipSet</MudLink></Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Filled Chips">
                <Description>Filled chips use the main color. When disabled, their opacity is reduced instead of changing color, making them visually distinct but still readable.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipBasicExample)" Block="true">
                <ChipBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Text Chips">
                <Description>Text chips have a translucent background with visible text, providing a lighter visual style than filled chips.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipTextExample)" Block="true">
                <ChipTextExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Outlined Chips">
                <Description>Outlined chips display a border and a subtle background, offering a distinct look from filled and text chips.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipOutlinedExample)" Block="true">
                <ChipOutlinedExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Closable">
                <Description>Closable chips show a close icon, which can be customized with the <CodeInline>CloseIcon</CodeInline> property.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipClosableExample)">
                <ChipClosableExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Clickable">
                <Description>
                    Chips can be made clickable by handling the <CodeInline>OnClick</CodeInline> event, allowing custom actions when the chip is pressed.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipClickableExample)">
                <ChipClickableExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Icons">
                <Description>Chips can display icons to the left or right of their content for added context or branding.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipIconExample)">
                <ChipIconExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Avatars">
                <Description>Chips can include avatars, such as user images or initials, to visually represent an entity.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipAvatarExample)">
                <ChipAvatarExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Label">
                <Description>Label chips use the theme's default border-radius and are ideal for displaying tags or categories.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipLabelExample)">
                <ChipLabelExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Sizes">
                <Description>Chips are available in different sizes to fit various UI needs.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipSizeExample)">
                <ChipSizeExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Link Chip">
                <Description>
                    Set <CodeInline>Href</CodeInline> to render a chip as a link. If <CodeInline>Target == "_blank"</CodeInline>, <CodeInline>rel="noopener"</CodeInline> is added for security. Link chips do not support close or <CodeInline>OnClick</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(ChipLinkExample)" ShowCode="false">
                <ChipLinkExample />
            </SectionContent>

            <SectionSubGroups>
                <DocsPageSection>
                    <SectionHeader Title="Custom Rel Content">
                        <Description>
                            Use the <CodeInline>Rel</CodeInline> property to set the link relationship. This overrides the default <CodeInline>rel="noopener"</CodeInline> for <CodeInline>Target="_blank"</CodeInline> and allows custom values.
                        </Description>
                    </SectionHeader>
                    <SectionContent Code="@nameof(ChipLinkRelExample)" ShowCode="false">
                        <ChipLinkRelExample />
                    </SectionContent>
                </DocsPageSection>
            </SectionSubGroups>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
