@page "/components/chips"

<DocsPage>
    <DocsPageHeader Title="Chips" Component="@nameof(MudChip<T>)">
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Filled Chips">
                <Description>Filled chips use the main color. When disabled, their opacity is reduced instead of changing color, keeping them distinct yet readable.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipBasicExample)" Block="true">
                <ChipBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Text Chips">
                <Description>Text chips have a translucent background and clear text, offering a lighter look than filled chips.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipTextExample)" Block="true">
                <ChipTextExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Outlined Chips">
                <Description>Outlined chips feature a border and subtle background, making them visually distinct from filled and text chips.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipOutlinedExample)" Block="true">
                <ChipOutlinedExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Chip Sets">
                <Description>Use chip sets to manage multiple chips together.</Description>
            </SectionHeader>

            <SectionSubGroups>
                <DocsPageSection>
                    <SectionHeader Title="Single selection">
                        <Description>
                            Select one chip at a time. Use <CodeInline>SelectionMode.SingleSelection</CodeInline> (default) or <CodeInline>SelectionMode.ToggleSelection</CodeInline> to allow deselection. Bind with <CodeInline>@@bind-SelectedValue</CodeInline>.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(ChipSetBasicExample)" Block="true">
                        <ChipSetBasicExample />
                    </SectionContent>
                </DocsPageSection>

                <DocsPageSection>
                    <SectionHeader Title="Multi selection">
                        <Description>
                            Select multiple chips using <CodeInline>SelectionMode="MultiSelection"</CodeInline>. Bind with <CodeInline>@@bind-SelectedValues</CodeInline>. Set <CodeInline>CheckMark="true"</CodeInline> to show check marks.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(ChipSetMultiselectionExample)" Block="true">
                        <ChipSetMultiselectionExample />
                    </SectionContent>
                </DocsPageSection>

                <DocsPageSection>
                    <SectionHeader Title="Adding and removing chips">
                        <Description>
                            Add chips and remove them by clicking the close button.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(ChipSetAddRemoveExample)" Block="true">
                        <ChipSetAddRemoveExample />
                    </SectionContent>
                </DocsPageSection>

                <DocsPageSection>
                    <SectionHeader Title="Default Selection">
                        <Description>
                            Chips with <CodeInline>Default="true"</CodeInline> are selected by default.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(ChipSetDefaultChipsExample)" Block="true">
                        <ChipSetDefaultChipsExample />
                    </SectionContent>
                </DocsPageSection>
            </SectionSubGroups>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Clickable">
                <Description>
                    Make chips clickable by handling the <CodeInline>OnClick</CodeInline> event. This lets you run custom actions when a chip is pressed.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipClickableExample)">
                <ChipClickableExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Closable">
                <Description>Closable chips display a close icon, which you can customize with the <CodeInline>CloseIcon</CodeInline> property.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipClosableExample)">
                <ChipClosableExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Icons">
                <Description>Chips can show icons on the left or right of their content for extra context or branding.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipIconExample)">
                <ChipIconExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Avatars">
                <Description>Chips can include avatars, such as user images or initials, to visually represent an entity.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipAvatarExample)">
                <ChipAvatarExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Label">
                <Description>Label chips use the theme's default border-radius and are ideal for tags or categories.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipLabelExample)">
                <ChipLabelExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Sizes">
                <Description>Chips come in different sizes to fit your UI needs.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipSizeExample)">
                <ChipSizeExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Link Chip">
                <Description>
                    Set <CodeInline>Href</CodeInline> to render a chip as a link. If <CodeInline>Target == "_blank"</CodeInline>, <CodeInline>rel="noopener"</CodeInline> is added for security. Link chips do not support close or <CodeInline>OnClick</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(ChipLinkExample)" ShowCode="false">
                <ChipLinkExample />
            </SectionContent>

            <SectionSubGroups>
                <DocsPageSection>
                    <SectionHeader Title="Custom Rel Content">
                        <Description>
                            Use the <CodeInline>Rel</CodeInline> property to set the link relationship. This overrides the default <CodeInline>rel="noopener"</CodeInline> for <CodeInline>Target="_blank"</CodeInline> and lets you specify custom values.
                        </Description>
                    </SectionHeader>
                    <SectionContent Code="@nameof(ChipLinkRelExample)" ShowCode="false">
                        <ChipLinkRelExample />
                    </SectionContent>
                </DocsPageSection>
            </SectionSubGroups>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Accessibility">
                <Description>
                    <MudText Class="mb-2">
                        <CodeInline>MudChip</CodeInline> keyboard shortcuts:
                    </MudText>
                    <MudSimpleTable Outlined="true" Hover="true">
                        <thead>
                            <tr>
                                <th>Keys</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <CodeInline>Space</CodeInline>,
                                    <CodeInline>Enter</CodeInline>,
                                    <CodeInline>NumpadEnter</CodeInline>
                                </td>
                                <td>Select or toggle the focused chip</td>
                            </tr>
                            <tr>
                                <td>
                                    <CodeInline>Backspace</CodeInline>,
                                    <CodeInline>Delete</CodeInline>
                                </td>
                                <td>Remove the focused chip if it is closable</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(ChipKeyboardNavigationExample)">
                <ChipKeyboardNavigationExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
