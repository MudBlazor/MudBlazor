@namespace MudBlazor.Docs.Examples

<MudMatrix ExplicitColumns="ExplicitMatrix.Pattern(2, Units.Fr())">
    <MudMatrixItem ColumnSpan="2">
        <MudSlider @bind-Value="_itemCount" Min="0" Max="18" Color="Color.Primary" Class="mb-6">Item Count: @_itemCount</MudSlider>
    </MudMatrixItem>
    <MudMatrixItem>
        <MudSlider @bind-Value="_columnCount" Min="0" Max="6" Color="Color.Secondary" Class="mb-6">Column Count: @_columnCount</MudSlider>
    </MudMatrixItem>
    <MudMatrixItem>
        <MudSlider @bind-Value="_rowCount" Min="0" Max="6" Color="Color.Tertiary" Class="mb-6">Row Count: @_rowCount</MudSlider>
    </MudMatrixItem>
    <MudMatrixItem>
        <MudText Color="Color.Secondary">ExplicitColumns="ExplicitMatrix.Pattern(@(_columnCount), Units.Fr())"</MudText>
    </MudMatrixItem>
    <MudMatrixItem>
        <MudText Color="Color.Tertiary">ExplicitRows="ExplicitMatrix.Pattern(@(_rowCount), Units.Fr())"</MudText>
    </MudMatrixItem>
</MudMatrix>

<MudMatrix ExplicitColumns="ExplicitMatrix.Pattern(_columnCount, Units.Fr())"
           ExplicitRows="ExplicitMatrix.Pattern(_rowCount, Units.Fr())"
           Style="height: 500px;">

    @for (int i = 0; i < _itemCount; i++)
    {
        int index = i + 1;
        <MudMatrixItem>
            <MudPaper Class="d-flex align-center justify-center mud-width-full mud-height-full">
                <MudText>@index</MudText>
            </MudPaper>
        </MudMatrixItem>
    }
</MudMatrix>

    @code {
    int _columnCount = 3;
    int _rowCount = 3;
    int _itemCount = 5;
}
