@namespace MudBlazor.Docs.Examples

<MudSlider @bind-Value="columnAmount" Min="0" Max="6" Color="Color.Info" Class="mb-6"># of columns: @columnAmount</MudSlider>
<MudSlider @bind-Value="rowAmount" Min="0" Max="6" Color="Color.Info" Class="mb-6"># of rows: @rowAmount</MudSlider>

<MudMatrix ExplicitColumns="ExplicitMatrix.Pattern(columnAmount, Units.Fr())"
           ExplicitRows="ExplicitMatrix.Pattern(rowAmount, Units.Fr())"
           Style="height: 500px;">

    @for (int i = 0; i < columnAmount * rowAmount; i++)
    {
        int index = i + 1;
        <MudMatrixItem>
            <MudPaper Class="d-flex align-center justify-center mud-width-full mud-height-full">#@index</MudPaper>
        </MudMatrixItem> 
    }
</MudMatrix>

@code {
    int columnAmount = 3;
    int rowAmount = 3;
}
