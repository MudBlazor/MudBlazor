@namespace MudBlazor.Docs.Examples

@using MudBlazor.Components.Grid


@* Tip: fr units require the grid to have a defined size on that axis to divide up the space.
        Width is usually fine since MudGrid is a block element and automatically fills its container,
        but height must be set explicitly when using fr for rows. *@

<MudGrid Template="true"
            RowTemplate="GridTemplate.Fixed(GridSpan.Rem(4), GridSpan.Fr())"
            Style="height: 500px;">

    <MudItem>
        <MudSlider Min="1" Max="16" Immediate="true" Step="1" @bind-Value="_count">
            Item Count: @_count
        </MudSlider>
    </MudItem>

    <MudItem>
        <MudGrid Template="true" RowTemplate="GridTemplate.Fixed(GridSpan.Fr())" Style="height: 100%;">
            @for (int i = 0; i < _count; i++)
            {
                int index = i + 1;
                <MudItem>
                    <MudPaper Class="d-flex align-center justify-center pa-4" Style="height: 100%;">
                        <MudText>Row @index</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudItem>

</MudGrid>

@code {
    int _count = 4;
}
