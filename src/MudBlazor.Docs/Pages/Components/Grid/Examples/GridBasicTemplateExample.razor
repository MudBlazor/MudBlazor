@namespace MudBlazor.Docs.Examples

<MudGrid Template="true" Columns="3" Rows="4" Style="height: 500px;">
    <MudItem ColumnSpan="1">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">ColumsSpan=1</MudPaper>
    </MudItem>
    <MudItem ColumnSpan="2">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">ColumsSpan=2</MudPaper>
    </MudItem>
    <MudItem ColumnSpan="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full py-8">ColumsSpan=3</MudPaper>
    </MudItem>
    <MudItem RowSpan="2" ColumnSpan="3">
        <MudPaper Class="d-flex align-center justify-center mud-width-full mud-height-full py-8">RowSpan=2 + ColumnSpan=3</MudPaper>
    </MudItem>
</MudGrid>
