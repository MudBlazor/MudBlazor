@page "/components/treeview"

<DocsPage>
    <DocsPageHeader Title="Tree View" Component="@nameof(MudTreeView<T>)">
        <Description>
            A highly‑customizable tree component that supports selection, lazy‑loading and templating.
        </Description>
    </DocsPageHeader>

    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Basic">
                <Description>
                    <p>
                        <strong>MudTreeView</strong> visualizes <em>hierarchical</em> data. Every item can have a
                        <CodeInline>Text</CodeInline> label and an optional <CodeInline>Value</CodeInline> of type
                        <CodeInline>T</CodeInline>.
                    </p>
                    <ul>
                        <li>If <CodeInline>T</CodeInline> is <CodeInline>string</CodeInline> and no
                            <CodeInline>Value</CodeInline> is supplied, the <CodeInline>Text</CodeInline> is also used
                            as the value.</li>
                        <li>If only <CodeInline>Value</CodeInline> is supplied the text is generated from the value.</li>
                        <li>You can supply both to display a label that differs from the stored value.</li>
                    </ul>
                    <p>
                        In this demo <CodeInline>ReadOnly</CodeInline> is <code>true</code>; therefore no item can be
                        selected.
                    </p>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewBasicExample)">
                <TreeViewBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Usage">
                <Description>
                    <ul>
                        <li><CodeInline>Hover</CodeInline> – highlights an item when the pointer is over it.</li>
                        <li><CodeInline>Ripple</CodeInline> – shows a ripple on click (ignored when
                            <CodeInline>ExpandOnDoubleClick</CodeInline> is <code>true</code>).</li>
                        <li><CodeInline>Dense</CodeInline> – reduces vertical padding for a compact look.</li>
                        <li><CodeInline>Disabled</CodeInline> – disables all user interaction.</li>
                        <li><CodeInline>ExpandOnClick</CodeInline> – single‑click expands/collapses a subtree.</li>
                        <li><CodeInline>ExpandOnDoubleClick</CodeInline> – double‑click expands/collapses a subtree and
                            raises <CodeInline>OnDoubleClick</CodeInline>.</li>
                    </ul>
                    <MudAlert Severity="Severity.Info" Class="my-3">
                        <CodeInline>ExpandOnDoubleClick</CodeInline> overrides
                        <CodeInline>ExpandOnClick</CodeInline> when both are set.
                    </MudAlert>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewUsageExample)" ShowCode="false">
                <TreeViewUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Icons">
                <Description>
                    Customize each node with <CodeInline>Icon</CodeInline> and <CodeInline>IconColor</CodeInline>.
                    The <CodeInline>ExpandButtonIcon</CodeInline> property changes the expand/collapse button, and
                    <CodeInline>IconExpanded</CodeInline> lets you show an alternate icon when the node is open.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewIconExample)" ShowCode="false">
                <TreeViewIconExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Single Selection">
                <Description>
                    <p>
                        Set <CodeInline>SelectionMode</CodeInline> to <CodeInline>SelectionMode.SingleSelection</CodeInline>
                        to allow exactly one selected value.
                    </p>
                    <ul>
                        <li>Use <CodeInline>SelectionMode.ToggleSelection</CodeInline> to toggle the single selection off
                            by clicking the selected item again.</li>
                        <li>Bind <CodeInline>@@bind-SelectedValue</CodeInline> to read or change the selection.
                        </li>
                        <li>Change the highlight with the <CodeInline>Color</CodeInline> property.</li>
                    </ul>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewSingleSelectionExample)" ShowCode="false">
                <TreeViewSingleSelectionExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Multi Selection">
                <Description>
                    <p>
                        With <CodeInline>SelectionMode.MultiSelection</CodeInline> users can pick multiple values.
                    </p>
                    <ul>
                        <li>Bind <CodeInline>@@bind-SelectedValues</CodeInline> (note the trailing <em>s</em>) to read or
                            change the selection.</li>
                        <li>Customize checkbox color using <CodeInline>CheckBoxColor</CodeInline>.</li>
                    </ul>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewMultiSelectionExample)" ShowCode="false">
                <TreeViewMultiSelectionExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Binding Items Directly">
                <Description>
                    You may bind <CodeInline>Selected</CodeInline> and <CodeInline>Expanded</CodeInline> directly on
                    individual <CodeInline Tag>MudTreeViewItem</CodeInline> components. This is especially handy when
                    you build the tree via <CodeInline>ItemTemplate</CodeInline> (next example).
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewBindItemsExample)" ShowCode="false">
                <TreeViewBindItemsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Auto‑Expand">
                <Description>
                    <p>
                        When <CodeInline>AutoExpand</CodeInline> is <code>true</code>, a collapsed branch that becomes
                        selected expands automatically.
                    </p>
                    <p>
                        Call <CodeInline>ExpandAll()</CodeInline> or <CodeInline>CollapseAll()</CodeInline> to expand or
                        collapse the entire tree.
                    </p>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewAutoExpandExample)" ShowCode="false">
                <TreeViewAutoExpandExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Item Template">
                <Description>
                    Build nodes automatically from hierarchical data with <CodeInline>ItemTemplate</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewItemTemplateExample)" ShowCode="false">
                <TreeViewItemTemplateExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Server‑Side Data & Lazy Loading">
                <Description>
                    <p>
                        Load children on demand using the <CodeInline>ServerData</CodeInline> callback.
                    </p>
                    <ul>
                        <li>Show a custom loading icon with <CodeInline>LoadingIcon</CodeInline> and
                            <CodeInline>LoadingIconColor</CodeInline>.</li>
                        <li>Disable lazy‑loading for a specific node by setting <CodeInline>CanExpand</CodeInline> to
                            <code>false</code>.</li>
                    </ul>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewServerExample)" ShowCode="false">
                <TreeViewServerExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Filtering">
                <Description>
                    Provide a <CodeInline>FilterFunc</CodeInline> to decide whether each node should be visible.
                    Call <CodeInline>Filter()</CodeInline> to apply the filter; the method sets the
                    <CodeInline>Visible</CodeInline> flag on every node.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewFilteringExample)" ShowCode="false">
                <TreeViewFilteringExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Custom Look & Behavior">
                <Description>
                    <p>
                        Set the <CodeInline>Content</CodeInline> render fragment on a
                        <CodeInline Tag>MudTreeViewItem</CodeInline> to fully replace its default layout. This allows
                        you to build any behavior you need—for example, the demo below implements non‑standard multi‑
                        selection where parent and child selections are independent.
                    </p>
                    <p>
                        To achieve smooth scrolling like in the demo, constrain the container’s
                        <CodeInline>height</CodeInline> or <CodeInline>max-height</CodeInline> and set
                        <CodeInline>overflow-y</CodeInline> accordingly.
                    </p>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewCustomExample)" ShowCode="false">
                <TreeViewCustomExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Custom Body Content">
                <Description>
                    Use <CodeInline Tag>BodyContent</CodeInline> instead of <CodeInline Tag>Content</CodeInline> if you
                    want to customize the body but keep the built‑in icons and expander buttons.
                </Description>
            </SectionHeader>
            <SectionContent Outlined="true" Code="@nameof(TreeViewBodyContentExample)" ShowCode="false">
                <TreeViewBodyContentExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
