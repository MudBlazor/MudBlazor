@namespace MudBlazor.Docs.Examples

<div class="d-flex flex-column align-center" style="transform: translateZ(0); height: 500px; width: 320px; background-color: var(--mud-palette-gray-lighter)">
    <a id="anchor-first"></a>
    <MudText Style="margin-top: 60px">Anchor First</MudText>
    <MudText Class="mt-8">Selected Item</MudText>
    <MudText Color="Color.Primary">@_selectedId</MudText>
    <a id="anchor-last"></a>
    <MudText Style="margin-top: 60px">Anchor Last</MudText>
    <MudNavigationBar OnSelectionChange="OnSelectionChange" CustomHrefComparisonFunc="@(new Func<string, string, bool>(CustomComparison))">
        <MudNavigationBarItem Id="Layout" Icon="@Icons.Material.Filled.FirstPage" Text="Anchor First" Href="components/navigationbar#anchor-first" />
        <MudNavigationBarItem Id="Nav Bar" Icon="@Icons.Material.Filled.Navigation" Text="Nav Bar" Href="components/navigationbar#navigation-context-with-href" />
        <MudNavigationBarItem Id="Input" Icon="@Icons.Material.Filled.LastPage" Text="Anchor Last" Href="components/navigationbar#anchor-last" />
    </MudNavigationBar>
</div>

@code {
    string _selectedId;

    private void OnSelectionChange(string id)
    {
        _selectedId = id;
    }

    private bool CustomComparison(string location, string href)
    {
        if (location == href)
        {
            return true;
        }
        return false;
    }
}
