@namespace MudBlazor.Docs.Examples

<MudStack>
    <div style="transform: translateZ(0); height: 500px; width: 320px; background-color: var(--mud-palette-gray-lighter)">
        <MudNavigationBar Color="@_color" Ripple="@_ripple" Underline="@_underline" Density="@_density" Typo="@_typo">
            <MudNavigationBarItem Icon="@(_icon ? Icons.Material.Filled.Flight : null)" Text="@(_text ? "Flight" : null)" SelectedClass="@(_customSelection ? "mud-theme-primary" : null)" Disabled="@_disable" />
            <MudNavigationBarItem Icon="@(_icon ? Icons.Material.Filled.Explore : null)" Text="@(_text ? "Explore" : null)" SelectedClass="@(_customSelection ? "mud-theme-secondary mud-border-secondary" : null)" />
            <MudNavigationBarItem Icon="@(_icon ? Icons.Material.Filled.ManageAccounts : null)" Text="@(_text ? "Account" : null)" SelectedClass="@(_customSelection ? "mud-theme-tertiary mud-border-tertiary" : null)" />
        </MudNavigationBar>
    </div>
    <MudStack>
        <MudSelect @bind-Value="@_color" Label="Color" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var item in Enum.GetValues<Color>())
            {
                <MudSelectItem Value="@item">@item.ToDescriptionString()</MudSelectItem>
            }
        </MudSelect>
        <MudSelect @bind-Value="@_typo" Label="Typo" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var item in Enum.GetValues<Typo>())
            {
                <MudSelectItem Value="@item">@item.ToDescriptionString()</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="short" @bind-Value="@_density" Min="@(-5)" Max="5" Label="Density" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudCheckBox @bind-Value="_ripple" Label="Ripple" Color="Color.Primary" Dense="true" />
        <MudCheckBox @bind-Value="_underline" Label="Underline" Color="Color.Primary" Dense="true" />
        <MudCheckBox @bind-Value="_icon" Label="Icon" Color="Color.Primary" Dense="true" />
        <MudCheckBox @bind-Value="_text" Label="Text" Color="Color.Primary" Dense="true" />
        <MudCheckBox @bind-Value="_disable" Label="Disable First Item" Color="Color.Primary" Dense="true" />
        <MudCheckBox @bind-Value="_customSelection" Label="Custom Selected Class" Color="Color.Primary" Dense="true" />
    </MudStack>
</MudStack>

@code {
    Color _color = Color.Primary;
    Typo _typo = Typo.subtitle2;
    bool _ripple = true;
    bool _underline = true;
    bool _icon = true;
    bool _text = true;
    bool _disable = false;
    bool _customSelection = false;
    short _density = 0;
}
