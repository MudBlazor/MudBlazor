@namespace MudBlazor.Docs.Examples

<MudDatePicker
    Label="Not working days, Sunday in red"
    IsDateDisabledFunc="@((DateTime? dt) => dt.HasValue && (int)dt.Value.DayOfWeek > 0 && (int)dt.Value.DayOfWeek < 6)"
    AdditionalDateClassesFunc="@((DateTime? dt) => (dt.HasValue && (int)dt.Value.DayOfWeek == 0) ? "red-text text-accent-4" : "")"/>
