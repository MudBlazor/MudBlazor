@namespace MudBlazor.Docs.Examples

<MudStack Row Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Class="mud-width-full">
    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@context.OpenFilePickerAsync"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                Choose file
            </MudButton>
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <MudFab Color="Color.Secondary"
                    StartIcon="@Icons.Material.Filled.Image"
                    OnClick="@context.OpenFilePickerAsync"
                    Label="Choose photo" />
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <MudFab Color="Color.Success"
                    OnClick="@context.OpenFilePickerAsync"
                    StartIcon="@Icons.Material.Filled.AttachFile" />
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <MudIconButton Color="Color.Info"
                           OnClick="@context.OpenFilePickerAsync"
                           Icon="@Icons.Material.Filled.PhotoCamera">
            </MudIconButton>
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Disabled>
        <CustomContent>
            <MudButton Variant="Variant.Filled"
                       OnClick="@context.OpenFilePickerAsync"
                       Color="Color.Primary">
                Disabled button
            </MudButton>
        </CustomContent>
        <SelectedTemplate />
    </MudFileUpload>

    <MudFileUpload T="IReadOnlyList<IBrowserFile>" 
                Folder="true" 
                FilesWithFolderPathsChanged="HandleFolderUpload"
                Context="fileUploadInstance">
        <CustomContent>
            <MudButton Variant="Variant.Filled"
                    Color="Color.Info"
                    StartIcon="@Icons.Material.Filled.Folder"
                    OnClick="@fileUploadInstance.OpenFilePickerAsync">
                Upload Entire Folder
            </MudButton>
        </CustomContent>
    </MudFileUpload>

    @if (_folderItems.Any())
    {
        <MudText Typo="Typo.subtitle2" Class="mt-4">Uploaded Structures:</MudText>
        <MudList T="string">
            @foreach (var item in _folderItems)
            {
                <MudListItem Icon="@Icons.Material.Filled.InsertDriveFile">
                    <b>@item.File.Name</b> <MudText Color="Color.Secondary" Inline="true">(@item.RelativePath)</MudText>
                </MudListItem>
            }
        </MudList>
    }


</MudStack>

<MudFlexBreak />

@if (_files != null)
{
    <MudText Typo="@Typo.h6">@_files.Count() File@(_files.Count() == 1 ? "" : "s"):</MudText>
    @if (_files.Count > 0)
    {
        <MudFlexBreak />
        <MudList T="string">
            @foreach (var file in _files)
            {
                <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@file">
                    @file.Name <code>@file.Size bytes</code>
                </MudListItem>
            }
        </MudList>
    }
}

@code
{
    private readonly IList<IBrowserFile> _files = new List<IBrowserFile>();

    private void UploadFiles(IBrowserFile file)
    {
        _files.Add(file);
        //TODO upload the files to the server
    }

    private void OnFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _files.Clear();
        foreach (var file in files)
        {
            _files.Add(file);
        }
    }

    private void UploadFolderFiles(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            _files.Add(file);
        }
    }

    private List<MudFilesWithFolderPath> _folderItems = new List<MudFilesWithFolderPath>();

    private void HandleFolderUpload(IReadOnlyList<MudFilesWithFolderPath> args)
    {
        _folderItems.Clear();
        foreach (var item in args)
        {
            _folderItems.Add(item);
        }
    }
}
