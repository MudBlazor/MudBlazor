@page "/components/select"

<DocsPage>
    <DocsPageHeader Title="Select" Component="@nameof(MudSelect<T>)" SubTitle="Pick from a known list." />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Quick Start">
                <Description>
                    A simple list with labels, helper text, and clearable values.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectUsageExample)">
                <SelectUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Multi-Selection">
                <Description>
                    Enable <CodeInline>MultiSelection</CodeInline> to pick more than one option.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(MultiSelectExample)">
                <MultiSelectExample />
            </SectionContent>
            <SectionSubGroups>
                <DocsPageSection>
                    <SectionHeader Title="Custom Selection Text">
                        <Description>
                            Use <CodeInline>MultiSelectionTextFunc</CodeInline> to control the summary text.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(MultiSelectCustomizedExample)">
                        <MultiSelectCustomizedExample />
                    </SectionContent>
                </DocsPageSection>
                <DocsPageSection>
                    <SectionHeader Title="Select All">
                        <Description>
                            Add a top-level toggle with <CodeInline>SelectAll</CodeInline>.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(MultiSelectSelectAllExample)">
                        <MultiSelectSelectAllExample />
                    </SectionContent>
                </DocsPageSection>
                <DocsPageSection>
                    <SectionHeader Title="Complex Objects">
                        <Description>
                            Supply <CodeInline>Comparer</CodeInline> or implement <CodeInline>IEquatable</CodeInline> for complex types.
                        </Description>
                    </SectionHeader>
                    <SectionContent ShowCode="false" Code="@nameof(MultiSelectComplexExample)">
                        <MultiSelectComplexExample />
                    </SectionContent>
                </DocsPageSection>
            </SectionSubGroups>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Value Presentation">
                <Description>
                    Use item templates when you want rich visuals for both the list and the selected value.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectPresentationExample)">
                <SelectPresentationExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Custom Conversion">
                <Description>
                    Use <CodeInline>ToStringFunc</CodeInline> or a custom converter for object types.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectCustomConverterExample)">
                <SelectCustomConverterExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Numeric Collections">
                <Description>
                    For required + clearable numeric selects, prefer nullable numeric types.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectNumericCollectionExample)">
                <SelectNumericCollectionExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Placement">
                <Description>
                    Control the popover position with <CodeInline>AnchorOrigin</CodeInline> and <CodeInline>TransformOrigin</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SelectAdvancedPopoverExample)" ShowCode="false">
                <SelectAdvancedPopoverExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keyboard Navigation">
                <Description>
                    Use <CodeInline>Space</CodeInline> to open, <CodeInline>Escape</CodeInline> to close, and arrows to move.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectKeyboardNavigationExample)">
                <SelectKeyboardNavigationExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Playground">
                <Description>
                    Explore variants, density, margin, and sizing in one place.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(SelectPlaygroundExample)">
                <SelectPlaygroundExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
