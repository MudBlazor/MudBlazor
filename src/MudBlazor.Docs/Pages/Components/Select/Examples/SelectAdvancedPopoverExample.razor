@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="string" Label="Left anchored"
                   AnchorOrigin="Origin.CenterLeft"
                   TransformOrigin="Origin.CenterRight"
                   Variant="Variant.Outlined">
            @foreach (var item in _options)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="string" Label="Center anchored"
                   AnchorOrigin="Origin.CenterCenter"
                   TransformOrigin="Origin.CenterCenter"
                   Variant="Variant.Outlined">
            @foreach (var item in _options)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudSelect T="string" Label="Bottom anchored"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopRight"
                   Variant="Variant.Outlined">
            @foreach (var item in _options)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    private readonly string[] _options = { "Small", "Medium", "Large" };
}
