@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Framework"
                   @bind-Value="_framework"
                   Clearable="true"
                   Placeholder="Pick one"
                   HelperText="String values"
                   AdornmentIcon="@Icons.Material.Filled.ViewQuilt"
                   AdornmentColor="Color.Primary">
            @foreach (var item in _frameworks)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="Priority" Label="Priority"
                   @bind-Value="_priority"
                   HelperText="Enum values"
                   Dense="true"
                   AdornmentIcon="@Icons.Material.Filled.Flag"
                   AdornmentColor="Color.Secondary">
            @foreach (var item in Enum.GetValues<Priority>())
            {
                <MudSelectItem T="Priority" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudChip T="string">Framework: @(_framework ?? "None")</MudChip>
            <MudChip T="string" Color="Color.Secondary">Priority: @_priority</MudChip>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private string _framework;
    private Priority _priority = Priority.Medium;

    private readonly string[] _frameworks =
    [
        "Blazor", "MAUI", "React", "Svelte", "Vue"
    ];

    public enum Priority
    {
        Low,
        Medium,
        High,
        Urgent
    }
}
