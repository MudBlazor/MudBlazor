@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Platforms"
                   MultiSelection="true"
                   @bind-Value="_summary"
                   @bind-SelectedValues="_selected"
                   MultiSelectionTextFunc="GetSelectionText"
                   AdornmentIcon="@Icons.Material.Filled.Devices">
            @foreach (var item in _platforms)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSwitch @bind-Value="_detailedText" Color="Color.Primary">Detailed summary</MudSwitch>
        <MudText Typo="Typo.body2" Class="mt-2">@_summary</MudText>
    </MudItem>
</MudGrid>

@code {
    private bool _detailedText;
    private string _summary = "Nothing selected";
    private IEnumerable<string> _selected = new HashSet<string> { "Web" };

    private readonly string[] _platforms =
    [
        "Desktop", "Mobile", "TV", "Wearable", "Web"
    ];

    private string GetSelectionText(List<string> selectedValues)
    {
        if (selectedValues.Count == 0)
        {
            return "Nothing selected";
        }

        return _detailedText
            ? $"Selected: {string.Join(", ", selectedValues)}"
            : $"{selectedValues.Count} platform{(selectedValues.Count == 1 ? "" : "s")}";
    }
}
