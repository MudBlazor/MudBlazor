@namespace MudBlazor.Docs.Examples

<MudPaper Class="pa-4">
    <MudText Typo="Typo.subtitle2" Class="mb-2">
        Selected: @(_package?.DisplayName ?? "None")
    </MudText>

    <MudSelect T="Package" @bind-Value="_package"
               ToStringFunc="package => package?.DisplayName"
               Label="Package"
               Variant="Variant.Outlined"
               Clearable="true">
        @foreach (var item in _packages)
        {
            <MudSelectItem T="Package" Value="@item" />
        }
    </MudSelect>
</MudPaper>

@code {
    private readonly Package[] _packages =
    [
        new("Starter", "1.0"),
        new("Core", "1.2"),
        new("Pro", "2.0"),
        new("Enterprise", "2.1")
    ];

    private Package _package = new("Core", "1.2");

    public record Package(string Name, string Version)
    {
        public string DisplayName => $"{Name} {Version}";
    }
}
