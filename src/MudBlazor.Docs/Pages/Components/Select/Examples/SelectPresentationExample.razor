@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="Status" @bind-Value="_status" Label="With templates" Variant="Variant.Outlined">
            @foreach (var option in _options)
            {
                <MudSelectItem T="Status" Value="@option.Value">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@option.Icon" Color="@option.Color" />
                        <MudText>@option.Label</MudText>
                    </MudStack>
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="Status" @bind-Value="_status" Label="Without templates" Variant="Variant.Outlined">
            @foreach (var option in _options)
            {
                <MudSelectItem T="Status" Value="@option.Value" />
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    private Status _status = Status.Ready;

    private readonly StatusOption[] _options =
    [
        new(Status.Ready, "Ready", Icons.Material.Filled.CheckCircle, Color.Success),
        new(Status.InProgress, "In progress", Icons.Material.Filled.Sync, Color.Info),
        new(Status.Blocked, "Blocked", Icons.Material.Filled.Block, Color.Error)
    ];

    public enum Status
    {
        Ready,
        InProgress,
        Blocked
    }

    public record StatusOption(Status Value, string Label, string Icon, Color Color);
}
