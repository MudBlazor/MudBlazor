@namespace MudBlazor.Docs.Examples

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <MudSelect T="int" Label="Priority (int)"
                   Required="true"
                   Clearable="true"
                   HelperText="Non-nullable values"
                   Variant="Variant.Outlined">
            @foreach (var item in _priorities)
            {
                <MudSelectItem T="int" Value="@item" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="int?" Label="Priority (int?)"
                   Required="true"
                   Clearable="true"
                   HelperText="Nullable values for Required + Clearable"
                   Variant="Variant.Outlined">
            @foreach (var item in _priorities)
            {
                <MudSelectItem T="int?" Value="@item" />
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    private readonly int[] _priorities = { 1, 2, 3, 4, 5 };
}
