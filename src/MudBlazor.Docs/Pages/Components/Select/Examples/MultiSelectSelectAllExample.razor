@namespace MudBlazor.Docs.Examples

<MudPaper Class="pa-4">
    <MudSelect T="string" Label="Services"
               MultiSelection="true"
               SelectAll="true"
               SelectAllText="Select all services"
               @bind-Value="_summary"
               @bind-SelectedValues="_selected"
               MultiSelectionTextFunc="GetSelectionText"
               AdornmentIcon="@Icons.Material.Filled.Dns">
        @foreach (var item in _services)
        {
            <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@code {
    private string _summary = "Nothing selected";
    private IEnumerable<string> _selected = new HashSet<string> { "Auth" };

    private readonly string[] _services =
    [
        "API", "Auth", "Cache", "Notifications", "Search", "Storage"
    ];

    private string GetSelectionText(List<string> selectedValues)
        => $"{selectedValues.Count} service{(selectedValues.Count == 1 ? "" : "s")} selected";
}
