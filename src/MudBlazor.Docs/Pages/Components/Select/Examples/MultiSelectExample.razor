@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Topics"
                   MultiSelection="true"
                   @bind-Value="_summary"
                   @bind-SelectedValues="_selected"
                   Clearable="true"
                   AdornmentIcon="@Icons.Material.Filled.Label"
                   AdornmentColor="Color.Primary">
            @foreach (var topic in _topics)
            {
                <MudSelectItem T="string" Value="@topic">@topic</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudText Typo="Typo.subtitle2">Summary</MudText>
        <MudText Typo="Typo.body2">@_summary</MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-3">Selected</MudText>
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            @foreach (var item in _selected)
            {
                <MudChip T="string">@item</MudChip>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private string _summary = "Nothing selected";
    private IEnumerable<string> _selected = new HashSet<string> { "Forms" };

    private readonly string[] _topics =
    [
        "Charts", "Data Grid", "Forms", "Layout", "Navigation",
        "Notifications", "Pickers", "Tables", "Theming"
    ];
}
