@namespace MudBlazor.Docs.Examples

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Navigate with keys" HelperText="Press Space to open">
            @foreach (var item in _coffees)
            {
                <MudSelectItem T="string" Value="@item" />
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Multi-select with keys"
                   MultiSelection="true"
                   HelperText="Use arrows and Enter to select"
                   @bind-SelectedValues="_selected"
                   @bind-Value="_summary">
            @foreach (var item in _options)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@code {
    private string _summary = "Nothing selected";
    private IEnumerable<string> _selected = new HashSet<string> { "Alpha" };

    private readonly string[] _coffees = { "Espresso", "Latte", "Cappuccino", "Mocha" };

    private readonly string[] _options =
    [
        "Alpha", "Bravo", "Charlie", "Delta",
        "Echo", "Foxtrot", "Gamma", "Hotel",
        "India", "Juliet", "Kilo", "Lima"
    ];
}
