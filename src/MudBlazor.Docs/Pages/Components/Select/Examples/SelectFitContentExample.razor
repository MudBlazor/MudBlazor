@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Region"
                   @bind-Value="_region"
                   FullWidth="_fullWidth"
                   FitContent="_fitContent"
                   Variant="Variant.Outlined"
                   Clearable="true">
            @foreach (var item in _regions)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Region (with adornment)"
                   @bind-Value="_region"
                   FullWidth="_fullWidth"
                   FitContent="_fitContent"
                   Variant="Variant.Outlined"
                   Adornment="Adornment.Start"
                   AdornmentIcon="@Icons.Material.Filled.LocationOn">
            @foreach (var item in _regions)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudStack Row="true" Spacing="2" Class="align-center">
            <MudSwitch @bind-Value="_fullWidth" Color="Color.Primary">Full Width</MudSwitch>
            <MudSwitch @bind-Value="_fitContent" Color="Color.Primary">Fit Content</MudSwitch>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private bool _fullWidth;
    private bool _fitContent;
    private string _region;

    private readonly string[] _regions =
    [
        "North", "South", "East", "West", "Central"
    ];
}
