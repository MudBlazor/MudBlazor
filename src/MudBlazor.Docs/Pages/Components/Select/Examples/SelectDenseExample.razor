@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" Label="Coffee"
                   @bind-Value="_coffee"
                   Dense="_dense"
                   Variant="_variant"
                   Clearable="true"
                   AdornmentIcon="@Icons.Material.Filled.Coffee"
                   AdornmentColor="Color.Primary">
            @foreach (var item in _coffees)
            {
                <MudSelectItem T="string" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="Variant" Label="Variant" Dense="true" @bind-Value="_variant">
            @foreach (var item in Enum.GetValues<Variant>())
            {
                <MudSelectItem T="Variant" Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch @bind-Value="_dense" Color="Color.Primary" Class="mt-2">Dense</MudSwitch>
    </MudItem>
</MudGrid>

@code {
    private string _coffee;
    private bool _dense;
    private Variant _variant = Variant.Outlined;

    private readonly string[] _coffees =
    [
        "Espresso", "Cappuccino", "Latte", "Mocha", "Americano"
    ];
}
