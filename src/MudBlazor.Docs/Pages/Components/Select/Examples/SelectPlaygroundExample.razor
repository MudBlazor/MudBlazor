@namespace MudBlazor.Docs.Examples

<MudGrid>
    <MudItem xs="12" md="6">
        <MudSelect T="string" Label="Playground"
                   @bind-Value="_value"
                   Variant="_variant"
                   Margin="_margin"
                   Dense="_dense"
                   FitContent="_fitContent"
                   FullWidth="_fullWidth"
                   Disabled="_disabled"
                   ReadOnly="_readOnly"
                   Clearable="_clearable"
                   Placeholder="@(_placeholder ? "Pick a state" : null)"
                   HelperText="@(_helperText ? "Helper text" : null)"
                   HelperTextOnFocus="_helperTextOnFocus">
            @foreach (var state in _states)
            {
                <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudStack Spacing="1">
            <MudSelect T="Variant" Label="Variant" Dense="true" @bind-Value="_variant">
                @foreach (var item in Enum.GetValues<Variant>())
                {
                    <MudSelectItem T="Variant" Value="@item">@item</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Margin" Label="Margin" Dense="true" @bind-Value="_margin">
                @foreach (var item in Enum.GetValues<Margin>())
                {
                    <MudSelectItem T="Margin" Value="@item">@item</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch @bind-Value="_dense" Color="Color.Primary">Dense</MudSwitch>
            <MudSwitch @bind-Value="_fitContent" Color="Color.Primary">Fit Content</MudSwitch>
            <MudSwitch @bind-Value="_fullWidth" Color="Color.Primary">Full Width</MudSwitch>
            <MudSwitch @bind-Value="_clearable" Color="Color.Primary">Clearable</MudSwitch>
            <MudSwitch @bind-Value="_readOnly" Color="Color.Primary">Read Only</MudSwitch>
            <MudSwitch @bind-Value="_disabled" Color="Color.Primary">Disabled</MudSwitch>
            <MudSwitch @bind-Value="_placeholder" Color="Color.Primary">Placeholder</MudSwitch>
            <MudSwitch @bind-Value="_helperText" Color="Color.Primary">Helper Text</MudSwitch>
            <MudSwitch @bind-Value="_helperTextOnFocus" Color="Color.Primary">Helper Text On Focus</MudSwitch>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private string _value;
    private Margin _margin;
    private Variant _variant = Variant.Outlined;
    private bool _dense;
    private bool _fitContent;
    private bool _fullWidth;
    private bool _clearable;
    private bool _readOnly;
    private bool _disabled;
    private bool _placeholder;
    private bool _helperText;
    private bool _helperTextOnFocus;

    private readonly string[] _states =
    [
        "Alabama", "Alaska", "Arizona", "Arkansas", "California",
        "Colorado", "Connecticut", "Delaware", "Florida", "Georgia",
        "Hawaii", "Idaho", "Illinois", "Indiana", "Iowa", "Kansas",
        "Kentucky", "Louisiana", "Maine", "Maryland", "Massachusetts",
        "Michigan", "Minnesota", "Mississippi", "Missouri", "Montana",
        "Nebraska", "Nevada", "New Hampshire", "New Jersey", "New Mexico",
        "New York", "North Carolina", "North Dakota", "Ohio", "Oklahoma",
        "Oregon", "Pennsylvania", "Rhode Island", "South Carolina", "South Dakota",
        "Tennessee", "Texas", "Utah", "Vermont", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming"
    ];
}
