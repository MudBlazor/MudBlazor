@namespace MudBlazor.Docs.Examples

<MudGrid Class="pa-4">
    <MudItem xs="12" sm="6">
        <MudSelect T="Release" Label="Releases"
                   MultiSelection="true"
                   @bind-SelectedValues="_selected"
                   ToStringFunc="release => release.Label"
                   Comparer="_releaseComparer">
            @foreach (var item in _releases)
            {
                <MudSelectItem T="Release" Value="@item">@item.Label</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudText Typo="Typo.subtitle2">Selected releases</MudText>
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            @foreach (var item in _selected)
            {
                <MudChip T="string">@item.Label</MudChip>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private IEnumerable<Release> _selected = new HashSet<Release>
    {
        new(1, "v7.0")
    };

    private readonly Release[] _releases =
    [
        new(1, "v7.0"),
        new(2, "v6.2"),
        new(3, "v6.1"),
        new(4, "v6.0")
    ];

    private readonly IEqualityComparer<Release> _releaseComparer = new ReleaseComparer();

    public record Release(int Id, string Label);

    private class ReleaseComparer : IEqualityComparer<Release>
    {
        public bool Equals(Release x, Release y) => x?.Id == y?.Id;
        public int GetHashCode(Release obj) => obj?.Id.GetHashCode() ?? 0;
    }
}
