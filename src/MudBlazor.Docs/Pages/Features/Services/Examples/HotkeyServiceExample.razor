@namespace MudBlazor.Docs.Examples

@using MudBlazor.Hotkey
@using MudBlazor.Utilities
@inject IGlobalHotkeyService HotkeyService
@inject ISnackbar SnackbarService

<MudStack Row="true">
    <MudSelect Label="Key" @bind-Value="_selectedKey" Style="width: 200px;">
        @foreach (var key in Enum.GetValues<JsKey>())
        {
            <MudSelectItem Value="@key">@Enum.GetName(typeof(JsKey), key)</MudSelectItem>
        }
    </MudSelect>
    <MudSelect Label="Modifier" @bind-SelectedValues="_selectedKeyModifiers" MultiSelection="true" Style="min-width: 200px;">
        @foreach (var keyModifier in Enum.GetValues<JsKeyModifier>())
        {
            <MudSelectItem Value="@keyModifier">@Enum.GetName(typeof(JsKeyModifier), keyModifier)</MudSelectItem>
        }
    </MudSelect>
    <MudButton OnClick="@RegisterAsync" Variant="Variant.Outlined" Color="Color.Success">Register</MudButton>
    <MudButton OnClick="@UnregisterAsync" Variant="Variant.Outlined" Color="Color.Error">Unregister</MudButton>
    <MudButton OnClick="@UnregisterAllAsync" Variant="Variant.Outlined" Color="Color.Info">Unregister all</MudButton>
</MudStack>

@code {
    private const string AssemblyName = "MudBlazor.Docs";
    private const string JsInvokableIdentifier = "HotkeySnackbar";
    private JsKey _selectedKey = JsKey.KeyA;
    private IEnumerable<JsKeyModifier> _selectedKeyModifiers = [JsKeyModifier.Control];

    private async Task RegisterAsync()
    {
        await HotkeyService.RegisterHotkeyAsync(AssemblyName, JsInvokableIdentifier, _selectedKey, _selectedKeyModifiers);
        SnackbarService.Add("Hotkey registered", Severity.Success);
    }

    private async Task UnregisterAsync()
    {
        await HotkeyService.UnregisterHotkeyAsync(AssemblyName, JsInvokableIdentifier, _selectedKey, _selectedKeyModifiers);
        SnackbarService.Add("Hotkey unregistered");
    }

    private async Task UnregisterAllAsync()
    {
        await HotkeyService.UnregisterAllHotkeysAsync();
        SnackbarService.Add("All hotkeys unregistered");
    }
}
