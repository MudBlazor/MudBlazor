@namespace MudBlazor.Docs.Examples

@using MudBlazor.Interop
@using MudBlazor.Services
@inject IScrollListenerFactory ScrollListenerFactory
@inject IResizeObserverFactory ResizeObserverFactory
@implements IDisposable
@implements IAsyncDisposable

<!--suppress CssUnresolvedCustomProperty -->
<style>
    #wrapper {
        width: 50%;
    }

    #scroll {
        height: 20rem;
        width: 100%;
        padding: 16px;
        background-color: var(--mud-palette-background);
        overflow-y: scroll;
        scrollbar-width: none;
    }

    #scrollbar {
        position: relative;
        width: 1rem;
        background-color: var(--mud-palette-background);
    }

    #cursor {
        position: absolute;
        top: @(Convert.ToInt32(_scrollBarTop))px;
        left: 0;
        width: 100%;
        height: 3px;
        background-color: var(--mud-palette-text-primary);
    }
</style>

<MudStack id="wrapper" Row="true">
    <div @ref="_scrollContainerRef" id="scroll" Class="d-flex flex-column gap-4 rounded">
        @for (var i = 0; i < 100; i++)
        {
            <MudPaper Class="pa-8" Style="@($"background-color: {ColorPalette[i % ColorPalette.Length]};")" Outlined="true"/>
        }
    </div>
    <div @ref="_scrollBarRef" id="scrollbar">
        <div id="cursor"></div>
    </div>
</MudStack>


@code {

    private static readonly string[] ColorPalette =
    [
        Colors.Blue.Accent3, Colors.Teal.Accent3, Colors.Amber.Accent3, Colors.Orange.Accent3, Colors.Red.Accent3,
        Colors.DeepPurple.Accent3, Colors.Green.Accent3, Colors.LightBlue.Accent3, Colors.Teal.Lighten1, Colors.Amber.Lighten1,
        Colors.Orange.Lighten1, Colors.Red.Lighten1, Colors.DeepPurple.Lighten1, Colors.Green.Lighten1, Colors.LightBlue.Lighten1,
        Colors.Amber.Darken2, Colors.Orange.Darken2, Colors.Red.Darken2, Colors.DeepPurple.Darken2, Colors.Gray.Darken2
    ];

    private IResizeObserver _resizeObserver;
    private IScrollListener _scrollListenerRect;
    private ElementReference _scrollContainerRef;
    private ElementReference _scrollBarRef;
    private double _scrollContainerHeight;
    private double _scrollContainerScrollTop;
    private double _scrollBarHeight;
    private double _scrollBarTop => _scrollContainerScrollTop / Math.Max(_scrollContainerHeight, 1) * _scrollBarHeight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            _resizeObserver = ResizeObserverFactory.Create();
            _resizeObserver.OnResized += ResizeObserverOnResized;
            _scrollContainerHeight = (await _resizeObserver.Observe(_scrollContainerRef))!.Height;
            _scrollBarHeight = (await _resizeObserver.Observe(_scrollBarRef))!.Height;

            _scrollListenerRect = ScrollListenerFactory.Create("#scroll");
            _scrollListenerRect.OnScroll += ScrollListenerRectOnScroll;
        }
    }

    public void Dispose()
    {
        _scrollListenerRect?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        if (_resizeObserver != null) await _resizeObserver.DisposeAsync();
    }

    private void ResizeObserverOnResized(IDictionary<ElementReference, BoundingClientRect> changes)
    {
        _scrollContainerHeight = changes[_scrollContainerRef].Height;
        _scrollBarHeight = changes[_scrollBarRef].Height;
        StateHasChanged();
    }

    private void ScrollListenerRectOnScroll(object sender, ScrollEventArgs e)
    {
        _scrollContainerScrollTop = e.ScrollTop;
        StateHasChanged();
    }
}
