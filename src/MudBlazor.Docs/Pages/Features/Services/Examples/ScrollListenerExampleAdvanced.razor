@namespace MudBlazor.Docs.Examples

@inject IScrollListenerFactory ScrollListenerFactory
@inject IScrollManager ScrollManager
@implements IDisposable

<!--suppress CssUnresolvedCustomProperty -->
<style>
    #wrapper {
        width: 50%;
        height: 100%;
    }    

    #scroll {
        padding: 16px;
        overflow-y: scroll;
        scrollbar-width: none;
    }

    .slider-container {
        display: flex;
        justify-content: center;
        min-width: 15%;
    }

    input[type=range][orient=vertical] {
        -webkit-appearance: none; 
        writing-mode: vertical-lr;
        direction: rtl;
        appearance: slider-vertical;
        width: 16px;
        vertical-align: bottom;
        height: 20rem;
        outline: none;
        border-radius: var(--mud-palette-borderradius);
        accent-color: var(--mud-palette-primary);       
    }
</style>

<MudStack id="wrapper" Row="true" AlignItems="AlignItems.Center" Spacing="0">
    <MudPaper id="scroll" Height="20rem" Width="100%" Class="d-flex flex-column gap-4">
        @for (var i = 0; i < 100; i++)
        {
            <MudPaper Class="pa-8" Style="@($"background-color: {ColorPalette[i % ColorPalette.Length]};")" Outlined="true"/>
        }
    </MudPaper>
    <div class="slider-container">
        <div>
            <input type="range"
                orient="vertical"
                min="0"
                max="100"
                step="1"
                value="@_scrollBarValue"
                @oninput="HandleSliderInput"
                class="mud-slider-input"
                aria-valuenow="@_scrollBarValue"
                aria-valuemin="0"
                aria-valuemax="100"
                role="slider" />
        </div>
    </div>
</MudStack>

@code {    
    private const string ScrollId = "#scroll";

    private static readonly string[] ColorPalette =
    [
        Colors.Blue.Accent3, Colors.Teal.Accent3, Colors.Amber.Accent3, Colors.Orange.Accent3, Colors.Red.Accent3,
        Colors.DeepPurple.Accent3, Colors.Green.Accent3, Colors.LightBlue.Accent3, Colors.Teal.Lighten1, Colors.Amber.Lighten1,
        Colors.Orange.Lighten1, Colors.Red.Lighten1, Colors.DeepPurple.Lighten1, Colors.Green.Lighten1, Colors.LightBlue.Lighten1,
        Colors.Amber.Darken2, Colors.Orange.Darken2, Colors.Red.Darken2, Colors.DeepPurple.Darken2, Colors.Gray.Darken2
    ];

    private IScrollListener _scrollListenerRect;
    private double _scrollBarValue = 100;
    private double _scrollHeight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            _scrollListenerRect = ScrollListenerFactory.Create(ScrollId, 10, true);
            _scrollListenerRect.OnScroll += ScrollListenerRectOnScroll;
        }
    }

    public void Dispose()
    {
        _scrollListenerRect?.Dispose();
    }

    private void HandleSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
        {
            _scrollBarValue = value;
            OnScrollBarValueChanged();
        }
    }

    private void ScrollListenerRectOnScroll(object sender, ScrollEventArgs e)
    {
        _scrollBarValue = 100 - e.ScrollTop / e.ScrollHeight * 100;
        _scrollHeight = e.ScrollHeight;
        StateHasChanged();
    }

    private void OnScrollBarValueChanged()
    {
        var scrollTo = (100 - _scrollBarValue) / 100 * _scrollHeight;
        ScrollManager.ScrollToAsync(ScrollId, 0, Convert.ToInt32(scrollTo), ScrollBehavior.Smooth);
    }
}
