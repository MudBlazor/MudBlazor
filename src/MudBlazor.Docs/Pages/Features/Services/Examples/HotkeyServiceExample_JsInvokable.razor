@inject ISnackbar Snackbar

@namespace MudBlazor.Docs.Examples

@code
{
    #nullable enable
    private static ISnackbar? SnackbarStatic { get; set; }

    protected override void OnInitialized()
    {
        SnackbarStatic = Snackbar;
        base.OnInitialized();
    }

    [JSInvokable("HotkeySnackbar")]
    public static void ShowSnackbar(int keyCode, int[] modifiers)
    {
        if (SnackbarStatic == null) throw new InvalidOperationException($"{nameof(SnackbarStatic)} is null");
        SnackbarStatic.Add($"Key with code '{keyCode}' and {modifiers.Length} modifiers pressed", Severity.Info);
    }
}
