@page "/"

<MudThemeProvider Theme="@_customTheme" IsDarkMode="@_isDarkMode" />

<style>
    .test-viewer-drawer {
        overflow: hidden;
    }

    .test-viewer-drawer-inner {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 4px;
    }

    .test-viewer-sidebar-header {
        padding: 0 16px 0 16px;
        display: flex;
        align-items: center;
    }

    .test-viewer-results {
        flex: 1;
        overflow: auto;
        scrollbar-width: none;
    }

    .test-viewer-results::-webkit-scrollbar {
        display: none;
    }

    .test-viewer-result-row {
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 12px;
        text-align: start;
    }

    .test-viewer-entry-name {
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .test-viewer-entry-category {
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: end;
    }

    .test-viewer-show-all {
        padding: 10px 12px 6px 12px;
    }

    .test-viewer-entry {
        justify-content: flex-start;
        border-radius: var(--mud-default-borderradius);
        text-transform: none;
    }

    .test-viewer-entry:hover {
        background: var(--mud-palette-action-default-hover);
    }

    .test-viewer-entry.test-viewer-entry-selected {
        background: var(--mud-palette-primary-hover);
        color: var(--mud-palette-primary);
    }

    .test-viewer-main {
        padding: 0 16px 16px 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        height: 100vh;
    }

    .test-viewer-header {
        padding: 16px 4px 0 4px;
    }

    .test-viewer-surface {
        flex: 1;
        overflow: auto;
    }

    .test-viewer-title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

    .test-viewer-path {
        font-family: monospace;
        opacity: 0.6;
    }
</style>

<MudLayout>
    <MudRTLProvider RightToLeft="_rightToLeft">
        <MudDrawer Open="@_drawerOpen" Overlay="false" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never" Breakpoint="Breakpoint.Sm" Class="test-viewer-drawer">
            <div class="test-viewer-drawer-inner">
                <div class="test-viewer-sidebar-header">
                    <MudText Class="test-viewer-title">MudBlazor Test Viewer</MudText>
                    <MudSpacer />
                    <MudTooltip Text="@ThemeLabel">
                        <MudIconButton Icon="@ThemeIcon" OnClick="ToggleTheme" aria-label="@ThemeLabel" />
                    </MudTooltip>
                    <MudTooltip Text="@(_rightToLeft ? "Left-to-right" : "Right-to-left")">
                        <MudIconButton Icon="@(_rightToLeft ? @Icons.Material.Filled.FormatTextdirectionLToR : @Icons.Material.Filled.FormatTextdirectionRToL)" OnClick="() => _rightToLeft = !_rightToLeft" aria-label="@(_rightToLeft ? "Left-to-right" : "Right-to-left")" Edge="Edge.End" />
                    </MudTooltip>
                </div>

                <div class="test-viewer-search">
                    <MudTextField T="string" @bind-Value="SearchText" Immediate="true" DebounceInterval="150"
                                  Placeholder="Search tests…" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </div>

                <div class="test-viewer-results">
                    <MudVirtualize Items="@_filteredEntries" Enabled="true" Context="entry">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" FullWidth="true"
                                   Class="@GetEntryClass(entry)" OnClick="() => Select(entry.Type)">
                            <div class="test-viewer-result-row">
                                <MudText Typo="Typo.body2" Class="test-viewer-entry-name">@entry.DisplayName</MudText>
                                @if (!string.IsNullOrWhiteSpace(entry.Category))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary test-viewer-entry-category">@entry.Category</MudText>
                                }
                            </div>
                        </MudButton>
                    </MudVirtualize>

                    @if (_remainingResultsCount > 0)
                    {
                        <div class="test-viewer-show-all">
                            <MudLink Href="#" OnClick="ShowAllResults" Typo="Typo.caption">
                                Show all results (@_remainingResultsCount more)
                            </MudLink>
                        </div>
                    }
                </div>
            </div>
        </MudDrawer>

        <MudMainContent Class="test-viewer-main">
            <div class="test-viewer-header">
                @if (_selectedType is null)
                {
                    <MudText Typo="Typo.h6">No test selected</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Use the search to quickly find a test component.</MudText>
                }
                else
                {
                    <div class="test-viewer-title-row">
                        <MudText Typo="Typo.h6">@GetTitleForDisplay(_selectedType)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary test-viewer-path">@GetFilePathForDisplay(_selectedType)</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetDescriptionForDisplay(_selectedType)</MudText>
                }
            </div>

            <div class="test-viewer-surface">
                @if (_selectedType is not null)
                {
                    @* Prevent double popovers! *@
                    <CascadingValue Name="UsePopoverProvider" Value="false" IsFixed="true">
                        @TestComponent()
                    </CascadingValue>
                }
            </div>
        </MudMainContent>
    </MudRTLProvider>
</MudLayout>
