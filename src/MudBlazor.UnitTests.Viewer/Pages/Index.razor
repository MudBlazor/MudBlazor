@page "/"
@using System.Reflection
@inject NavigationManager NavManager
@implements IDisposable

<MudThemeProvider Theme="@_customTheme" IsDarkMode="@_isDarkMode" />

<MudLayout>
    <MudRTLProvider RightToLeft="_rightToLeft">
        <MudDrawer Open="@_drawerOpen" Overlay="false" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Never" Breakpoint="Breakpoint.Sm" Class="test-viewer-drawer">
            <div class="test-viewer-drawer-inner">
                <div class="test-viewer-sidebar-header">
                    <MudText Class="test-viewer-title">MudBlazor Test Viewer</MudText>
                    <MudSpacer />
                    <MudTooltip Text="@ThemeLabel">
                        <MudIconButton Icon="@ThemeIcon" OnClick="ToggleTheme" aria-label="@ThemeLabel" />
                    </MudTooltip>
                    <MudTooltip Text="@(_rightToLeft ? "Left-to-right" : "Right-to-left")">
                        <MudIconButton Icon="@(_rightToLeft ? @Icons.Material.Filled.FormatTextdirectionLToR : @Icons.Material.Filled.FormatTextdirectionRToL)" OnClick="() => _rightToLeft = !_rightToLeft" aria-label="@(_rightToLeft ? "Left-to-right" : "Right-to-left")" Edge="Edge.End" />
                    </MudTooltip>
                </div>

                <div class="test-viewer-search">
                    <MudTextField T="string" @bind-Value="SearchText" Immediate="true" DebounceInterval="150"
                                  Placeholder="Search tests…" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </div>

                <div class="test-viewer-results">
                    <MudVirtualize Items="@_filteredEntries" Enabled="true" Context="entry">
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" FullWidth="true"
                                   Class="@GetEntryClass(entry)" OnClick="() => Select(entry.Type)">
                            <div class="test-viewer-result-row">
                                <MudText Typo="Typo.body2" Class="test-viewer-entry-name">@entry.DisplayName</MudText>
                                @if (!string.IsNullOrWhiteSpace(entry.Category))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary test-viewer-entry-category">@entry.Category</MudText>
                                }
                            </div>
                        </MudButton>
                    </MudVirtualize>

                    @if (_remainingResultsCount > 0)
                    {
                        <div class="test-viewer-show-all">
                            <MudLink Href="#" OnClick="ShowAllResults" Typo="Typo.caption">
                                Show all results (@_remainingResultsCount more)
                            </MudLink>
                        </div>
                    }
                </div>
            </div>
        </MudDrawer>

        <MudMainContent Class="test-viewer-main">
            <div class="test-viewer-header">
                @if (_selectedType is null)
                {
                    <MudText Typo="Typo.h6">No test selected</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Use the search to quickly find a test component.</MudText>
                }
                else
                {
                    <div class="test-viewer-title-row">
                        <MudText Typo="Typo.h6">@GetTitleForDisplay(_selectedType)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary test-viewer-path">@GetFilePathForDisplay(_selectedType)</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetDescriptionForDisplay(_selectedType)</MudText>
                }
            </div>

            <div class="test-viewer-surface">
                @if (_selectedType is not null)
                {
                    @* Prevent double popovers! *@
                    <CascadingValue Name="UsePopoverProvider" Value="false" IsFixed="true">
                        @TestComponent()
                    </CascadingValue>
                }
            </div>
        </MudMainContent>
    </MudRTLProvider>
</MudLayout>
<style>
    .test-viewer-drawer {
        overflow: hidden;
    }

    .test-viewer-drawer-inner {
        height: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 4px;
    }

    .test-viewer-sidebar-header {
        padding: 0 16px 0 16px;
        display: flex;
        align-items: center;
    }

    .test-viewer-results {
        flex: 1;
        overflow: auto;
        scrollbar-width: none;
    }

    .test-viewer-results::-webkit-scrollbar {
        display: none;
    }

    .test-viewer-result-row {
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
        gap: 12px;
        text-align: start;
    }

    .test-viewer-entry-name {
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .test-viewer-entry-category {
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: end;
    }

    .test-viewer-show-all {
        padding: 10px 12px 6px 12px;
    }

    .test-viewer-entry {
        justify-content: flex-start;
        border-radius: var(--mud-default-borderradius);
        text-transform: none;
    }

    .test-viewer-entry:hover {
        background: var(--mud-palette-action-default-hover);
    }

    .test-viewer-entry.test-viewer-entry-selected {
        background: var(--mud-palette-primary-hover);
        color: var(--mud-palette-primary);
    }

    .test-viewer-main {
        padding: 0 16px 16px 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        height: 100vh;
    }

    .test-viewer-header {
        padding: 16px 4px 0 4px;
    }

    .test-viewer-surface {
        flex: 1;
        overflow: auto;
    }

    .test-viewer-title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
    }

    .test-viewer-path {
        font-family: monospace;
        opacity: 0.6;
    }
</style>

@code {

    private bool _rightToLeft;
    private Type? _selectedType;
    private bool _drawerOpen = true;
    private string _searchText = string.Empty;
    private TestEntry[] _entries = [];
    private TestEntry[] _filteredEntries = [];
    private Type[] _availableComponentTypes = [];
    private Dictionary<Type, TestEntry> _entryByType = [];
    private int _remainingResultsCount;
    private bool _showAllResults;
    private CancellationTokenSource? _searchCts;
    private bool _isDarkMode;
    private readonly MudTheme _customTheme = new()
    {
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "340px",
            DrawerWidthRight = "340px"
        }
    };

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private string ThemeIcon => _isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;

    private string ThemeLabel => _isDarkMode ? "Light mode" : "Dark mode";

    private string SearchText
    {
        get => _searchText;
        set
        {
            value ??= string.Empty;

            if (string.Equals(_searchText, value, StringComparison.Ordinal))
            {
                return;
            }

            _searchText = value;
            _showAllResults = false;
            StartSearch();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _availableComponentTypes = GetTestComponentTypes().ToArray();

        _entries = _availableComponentTypes
            .Select(CreateEntry)
            .OrderBy(x => x.Name)
            .ToArray();

        _entryByType = _entries.ToDictionary(x => x.Type, x => x);
        StartSearch();

        ParseQueryString();
        NavManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ParseQueryString();
        StateHasChanged();
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private void ParseQueryString()
    {
        var uri = new Uri(NavManager.Uri);
        var query = uri.Query;

        if (string.IsNullOrEmpty(query))
            return;

        if (query.StartsWith('?'))
            query = query.Substring(1);

        var queryParams = query.Split('&');

        foreach (var param in queryParams)
        {
            var parts = param.Split('=');
            if (parts.Length == 2)
            {
                var key = parts[0];
                var value = Uri.UnescapeDataString(parts[1]);

                if (string.Equals(key, "component", StringComparison.OrdinalIgnoreCase))
                {
                    var componentType = _availableComponentTypes.FirstOrDefault(t =>
                        t.Name.Equals(value, StringComparison.OrdinalIgnoreCase));

                    if (componentType != null)
                    {
                        _selectedType = componentType;
                        StateHasChanged();
                        break;
                    }
                }
            }
        }
    }

    private void Select(Type componentType)
    {
        if (componentType is null)
        {
            return;
        }

        _selectedType = componentType;
        UpdateQueryString(componentType);
    }

    private void UpdateQueryString(Type componentType)
    {
        if (componentType == null) return;

        var uri = new Uri(NavManager.Uri);
        var baseUrl = uri.GetLeftPart(UriPartial.Path);

        // Create the new query string
        var newUrl = $"{baseUrl}?component={componentType.Name}";

        // Update URL without navigation (false parameter)
        NavManager.NavigateTo(newUrl, false);
    }

    private RenderFragment TestComponent() => builder =>
    {
        if (_selectedType is null)
        {
            return;
        }

        builder.OpenComponent(0, _selectedType);
        builder.CloseComponent();
    };

    private static IEnumerable<Type> GetTestComponentTypes()
    {
        var types = typeof(Program).Assembly.GetTypes()
            .Where(type => type.Name.Contains("Test"))
            .Where(type => !type.Name.StartsWith("<"))
            .Where(type => type.GetInterfaces().Contains(typeof(IComponent)))
            .OrderBy(type => type.Name);

        foreach (var type in types)
        {
            yield return type;
        }
    }


    private TestEntry CreateEntry(Type type)
    {
        var category = type.Namespace?.Split('.').LastOrDefault() ?? string.Empty;
        var description = GetDescriptionOrNull(type);
        var filePath = GetFilePath(type);
        return new TestEntry(type, type.Name, GetDisplayName(type.Name), category, description, filePath);
    }

    private static string GetFilePath(Type type)
    {
        var ns = type.Namespace ?? string.Empty;
        var match = "MudBlazor.UnitTests.";
        var path = ns.StartsWith(match) ? ns.Substring(match.Length).Replace('.', '/') : ns.Replace('.', '/');
        return $"{path}/{type.Name}.razor";
    }

    private static string GetDisplayName(string typeName)
    {
        return typeName.EndsWith("Test", StringComparison.Ordinal)
            ? typeName.Substring(0, typeName.Length - 4)
            : typeName;
    }

    private static string? GetDescriptionOrNull(Type type)
    {
        var field = type.GetField("__description__", BindingFlags.Public | BindingFlags.Static | BindingFlags.GetField);
        if (field is null || field.FieldType != typeof(string))
        {
            return null;
        }

        return (string?)field.GetValue(null);
    }

    private string GetDescriptionForDisplay(Type type)
    {
        if (_entryByType.TryGetValue(type, out var entry) && !string.IsNullOrWhiteSpace(entry.Description))
        {
            return entry.Description;
        }

        return "No description provided (add public static string __description__).";
    }

    private string GetFilePathForDisplay(Type type)
    {
        if (_entryByType.TryGetValue(type, out var entry))
        {
            return entry.FilePath;
        }

        return string.Empty;
    }

    private string GetTitleForDisplay(Type type)
    {
        if (_entryByType.TryGetValue(type, out var entry))
        {
            return entry.DisplayName;
        }

        return GetDisplayName(type.Name);
    }

    private void StartSearch()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        _ = RecomputeFilteredEntriesAsync(_searchCts.Token);
    }

    private async Task RecomputeFilteredEntriesAsync(CancellationToken token)
    {
        try
        {
            _remainingResultsCount = 0;

            if (_entries.Length == 0)
            {
                _filteredEntries = [];
                await InvokeAsync(StateHasChanged);
                return;
            }

            token.ThrowIfCancellationRequested();

            var query = _searchText.Trim();

            if (query.Length == 0)
            {
                _filteredEntries = _entries;
                await InvokeAsync(StateHasChanged);
                return;
            }

            const int threshold = 35;
            const int defaultLimit = 20;
            var showAllResults = _showAllResults;

            var top = new List<(TestEntry Entry, int Score)>(defaultLimit);
            List<(TestEntry Entry, int Score)>? all = showAllResults ? new List<(TestEntry Entry, int Score)>() : null;
            var totalMatchCount = 0;

            for (var i = 0; i < _entries.Length; i++)
            {
                token.ThrowIfCancellationRequested();
                var entry = _entries[i];
                var score = GetSearchScore(query, entry);
                if (score < threshold)
                {
                    if (i % 25 == 0)
                    {
                        await Task.Yield();
                    }
                    continue;
                }

                totalMatchCount++;

                if (all is not null)
                {
                    all.Add((entry, score));
                }
                else
                {
                    InsertTopK(top, (entry, score), defaultLimit);
                }

                if (i % 25 == 0)
                {
                    await Task.Yield();
                }
            }

            token.ThrowIfCancellationRequested();

            IReadOnlyList<(TestEntry Entry, int Score)> final = all ?? top;
            var filteredEntries = final
                .OrderByDescending(x => x.Score)
                .ThenBy(x => x.Entry.Name)
                .Select(x => x.Entry)
                .ToArray();

            if (!showAllResults)
            {
                filteredEntries = filteredEntries.Take(defaultLimit).ToArray();
                _remainingResultsCount = Math.Max(0, totalMatchCount - filteredEntries.Length);
            }

            _filteredEntries = filteredEntries;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Ignore; newer search already started.
        }
    }

    private static void InsertTopK(List<(TestEntry Entry, int Score)> list, (TestEntry Entry, int Score) candidate, int k)
    {
        if (list.Count == 0)
        {
            list.Add(candidate);
            return;
        }

        var inserted = false;
        for (var i = 0; i < list.Count; i++)
        {
            if (candidate.Score > list[i].Score)
            {
                list.Insert(i, candidate);
                inserted = true;
                break;
            }
        }

        if (!inserted)
        {
            if (list.Count < k)
            {
                list.Add(candidate);
            }
        }

        if (list.Count > k)
        {
            list.RemoveAt(list.Count - 1);
        }
    }

    private void ShowAllResults(MouseEventArgs args)
    {
        _showAllResults = true;
        StartSearch();
    }

    private int GetSearchScore(string query, TestEntry entry)
    {
        var q = query.ToLowerInvariant();
        // Name relevance should dominate because category text is broad and can otherwise outrank intended test names.
        var nameScore = SearchScore(entry.Name.ToLowerInvariant(), q);
        var categoryScore = string.IsNullOrWhiteSpace(entry.Category) ? 0 : SearchScore(entry.Category.ToLowerInvariant(), q);

        return (int)Math.Round(nameScore * 0.93 + categoryScore * 0.07);
    }

    // ── Search algorithm ─────────────────────────────────────────────────────
    // Mirrors SearchService.ComputeScore in MudBlazor.Docs so both surfaces
    // use the same scoring logic.

    private static ReadOnlySpan<char> SearchTokenSeparators => " -.,_/<>()";

    // Stack-allocation budget for Levenshtein rows and Range arrays.
    private const int SearchStackAllocLimit = 64;

    // Maximum token count stored on the stack per query/target string.
    // Tokens beyond this count are silently ignored, which is fine for
    // typical test-name inputs that rarely exceed a handful of words.
    private const int SearchMaxQueryTokens = 16;
    private const int SearchMaxTargetTokens = 64;

    private static int SearchScore(ReadOnlySpan<char> target, ReadOnlySpan<char> query)
    {
        if (target.IsEmpty || query.IsEmpty)
            return 0;
        if (target.SequenceEqual(query))
            return 100;

        var best = 0;

        if (target.StartsWith(query))
            best = Math.Max(best, SearchPrefixScore(target.Length, query.Length));

        if (target.IndexOf(query) >= 0)
            best = Math.Max(best, 70);

        Span<Range> qRanges = stackalloc Range[SearchMaxQueryTokens];
        Span<Range> tRanges = stackalloc Range[SearchMaxTargetTokens];
        var qCount = query.SplitAny(qRanges, SearchTokenSeparators, StringSplitOptions.RemoveEmptyEntries);
        var tCount = target.SplitAny(tRanges, SearchTokenSeparators, StringSplitOptions.RemoveEmptyEntries);

        if (qCount > 0 && tCount > 0)
            best = Math.Max(best, SearchTokenSetScore(query, qRanges[..qCount], target, tRanges[..tCount]));

        if (qCount > 1)
        {
            Span<char> concat = stackalloc char[SearchStackAllocLimit];
            var concatLen = SearchBuildConcat(query, qRanges[..qCount], concat);
            if (concatLen > 0)
                best = Math.Max(best, SearchSinglePairScore(concat[..concatLen], target));
        }

        return best;
    }

    private static int SearchPrefixScore(int targetLen, int queryLen) =>
        Math.Max(65, 100 - (targetLen - queryLen) * 3);

    private static int SearchTokenSetScore(
        ReadOnlySpan<char> queryStr, ReadOnlySpan<Range> qRanges,
        ReadOnlySpan<char> targetStr, ReadOnlySpan<Range> tRanges)
    {
        var totalScore = 0;
        var totalLen = 0;

        foreach (var qr in qRanges)
        {
            var qt = queryStr[qr];
            if (qt.IsEmpty)
                continue;

            var best = 0;
            foreach (var tr in tRanges)
            {
                var tt = targetStr[tr];
                if (tt.IsEmpty)
                    continue;

                var s = SearchTokenPairScore(qt, tt);
                if (s > best)
                    best = s;
            }

            if (best == 0)
                return 0;

            totalScore += best * qt.Length;
            totalLen += qt.Length;
        }

        if (totalLen == 0)
            return 0;

        var avg = totalScore / totalLen;
        var coverage = Math.Min(1.0, (double)qRanges.Length / tRanges.Length);
        return (int)(avg * (0.85 + 0.15 * coverage));
    }

    private static int SearchTokenPairScore(ReadOnlySpan<char> qt, ReadOnlySpan<char> tt)
    {
        if (tt.SequenceEqual(qt))
            return 100;

        if (tt.StartsWith(qt))
            return Math.Max(50, qt.Length * 100 / tt.Length);

        var maxLen = Math.Max(qt.Length, tt.Length);
        var maxDist = maxLen <= 3 ? 0 : maxLen <= 5 ? 1 : maxLen <= 8 ? 2 : 3;

        if (maxDist > 0)
        {
            var dist = SearchEditDistance(qt, tt);
            if (dist <= maxDist)
                return (maxLen - dist) * 100 / maxLen;
        }

        return 0;
    }

    private static int SearchSinglePairScore(ReadOnlySpan<char> a, ReadOnlySpan<char> b)
    {
        if (a.SequenceEqual(b))
            return 100;
        if (b.StartsWith(a))
            return SearchPrefixScore(b.Length, a.Length);

        var maxLen = Math.Max(a.Length, b.Length);
        var maxDist = maxLen <= 5 ? 1 : maxLen <= 8 ? 2 : 3;
        var dist = SearchEditDistance(a, b);
        if (dist <= maxDist)
            return (maxLen - dist) * 100 / maxLen;

        return 0;
    }

    private static int SearchBuildConcat(ReadOnlySpan<char> source, ReadOnlySpan<Range> ranges, Span<char> dest)
    {
        var pos = 0;
        foreach (var r in ranges)
        {
            var tok = source[r];
            if (pos + tok.Length > dest.Length)
                return 0;
            tok.CopyTo(dest[pos..]);
            pos += tok.Length;
        }
        return pos;
    }

    private static int SearchEditDistance(ReadOnlySpan<char> a, ReadOnlySpan<char> b)
    {
        if (a.IsEmpty) return b.Length;
        if (b.IsEmpty) return a.Length;

        var n = b.Length + 1;
        Span<int> prev = n <= SearchStackAllocLimit ? stackalloc int[n] : new int[n];
        Span<int> curr = n <= SearchStackAllocLimit ? stackalloc int[n] : new int[n];

        for (var j = 0; j < n; j++)
            prev[j] = j;

        for (var i = 0; i < a.Length; i++)
        {
            curr[0] = i + 1;
            for (var j = 0; j < b.Length; j++)
            {
                var cost = a[i] == b[j] ? 0 : 1;
                curr[j + 1] = Math.Min(
                    Math.Min(curr[j] + 1, prev[j + 1] + 1),
                    prev[j] + cost);

                if (i > 0 && j > 0 && a[i] == b[j - 1] && a[i - 1] == b[j])
                    curr[j + 1] = Math.Min(curr[j + 1], prev[j - 1] + 1);
            }

            var tmp = prev;
            prev = curr;
            curr = tmp;
        }

        return prev[b.Length];
    }

    private string GetEntryClass(TestEntry entry)
    {
        if (_selectedType == entry.Type)
        {
            return "test-viewer-entry test-viewer-entry-selected";
        }

        return "test-viewer-entry";
    }

    private sealed record TestEntry(Type Type, string Name, string DisplayName, string Category, string? Description, string FilePath);
}
