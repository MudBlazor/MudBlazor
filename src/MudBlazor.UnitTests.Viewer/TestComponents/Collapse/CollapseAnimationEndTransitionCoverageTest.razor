<MudButton id="toggle" OnClick="Toggle">Toggle</MudButton>

<MudCollapse Expanded="_expanded" OnAnimationEnd="OnAnimationEnd">
    <div>content</div>
</MudCollapse>

<div id="expanded">@_expanded</div>
<div id="animation_end_count">@_animationEndCount</div>

@code {
    private bool _expanded = true;
    private int _animationEndCount;

    private void Toggle()
    {
        _expanded = !_expanded;
    }

    private void OnAnimationEnd()
    {
        _animationEndCount++;
    }
}
