<MudPopoverProvider />

<MudSelect @bind-Value="_value" Strict="true" FullWidth="_fullWidth">
    <MudSelectItem T="int" Value="1"/>
    <MudSelectItem T="int" Value="2"/>
    <MudSelectItem T="int" Value="3"/>
</MudSelect>

<MudSwitch @bind-Value="_fullWidth" Class="mt-4" Color="Color.Primary">Full Width</MudSwitch>

@code {
    public static string __description__ = "Don't show initial value which is not in list because of Strict=true.";

    private bool _fullWidth = true;
    private int _value = 17;
}
