<MudPopoverProvider />

<div>
    <MudSelect T="string" Variant="Variant.Text" @bind-Value="_fruit" Dense 
               SelectedValuesChanged="@(() => FruitChanged(null))" FitContent="_fitContent">
        <MudSelectItem Value="@("Apple")">Apple</MudSelectItem>
        <MudSelectItem Value="@("Orange")">Orange</MudSelectItem>
    </MudSelect>
</div>

<MudSwitch @bind-Value="_fitContent" Class="mt-4" Color="Color.Primary">Fit Content</MudSwitch>

@code{
    private string _fruit = "Apple";
    private bool _fitContent;

    public int ChangeCount { get; private set; }

    private void FruitChanged(IEnumerable<string>? fruits)
    {
        ChangeCount++;
    }
}
