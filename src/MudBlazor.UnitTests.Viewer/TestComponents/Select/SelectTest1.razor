<MudPopoverProvider />

<MudSelect @bind-Value="_value" PopoverClass="select-popover-class" @onfocus="Focused" OnBlur="Blurred" FullWidth="_fullWidth">
    <MudSelectItem Value="@("1")"/>
    <MudSelectItem Value="@("2")"/>
    <MudSelectItem Value="@("3")"/>
    <MudSelectItem Value="@("4")" Disabled="true"/>
</MudSelect>

<MudSwitch @bind-Value="@_focused" />
<MudSwitch @bind-Value="_fullWidth" Class="mt-4" Color="Color.Primary">Full Width</MudSwitch>

@code {
    public static string __description__ = "Click should open the Menu and selecting a value should update the bindable value.";

    private bool _fullWidth = true;
    private string? _value = null;
    private bool _focused;

    private void Focused()
    {
	    _focused = true;
    }

    private void Blurred()
    {
	    _focused = false;
    }
}
