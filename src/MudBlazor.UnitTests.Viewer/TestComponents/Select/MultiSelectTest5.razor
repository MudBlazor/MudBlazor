@if (_posts is not null)
{
    <MudSelect Label="Roles" T="string" SelectedValues="_selectedValues" MultiSelection="true" FullWidth="_fullWidth"
               RelativeWidth="@(_adaptive ? DropdownWidth.Adaptive : DropdownWidth.Relative)">
        @foreach (var role in _posts)
        {
            <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
        }
    </MudSelect>
}

<MudSwitch @bind-Value="_fullWidth" Class="mt-4" Color="Color.Primary">Full Width</MudSwitch>
<MudSwitch @bind-Value="_adaptive" Class="mt-4" Color="Color.Primary">Adaptive Content</MudSwitch>

@code {
    private bool _fullWidth = true;
    private bool _adaptive; 
    
    private readonly IEnumerable<string> _selectedValues = new HashSet<string>
    { 
        "Programista", "test"
    };

    private HashSet<string>? _posts;

    protected override void OnInitialized()
    {
        _posts = ["Programista", "Programista 2", "test", "Technik", "Tester", "Tester tester"];

        base.OnInitialized();
    }
}
