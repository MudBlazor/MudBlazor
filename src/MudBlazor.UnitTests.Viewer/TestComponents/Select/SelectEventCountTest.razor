<MudPopoverProvider />

<MudSelect T="string" ValueChanged="ValueChanged" SelectedValuesChanged="ValuesChanged" MultiSelection="MultiSelection" ShrinkToContent="_shinkToContent">
    <MudSelectItem T="string" Value="@("1")" />
    <MudSelectItem T="string" Value="@("2")" />
    <MudSelectItem T="string" Value="@("3")" />
    <MudSelectItem T="string" Value="@("4")" Disabled="true" />
</MudSelect>

<MudSwitch @bind-Value="_shinkToContent" Class="mt-4" Color="Color.Primary">Fit Content</MudSwitch>

@code {
    private bool _shinkToContent;

    [Parameter]
    public bool MultiSelection { get; set; }

    public int ValueChangeCount { get; set; }

    public int ValuesChangeCount { get; set; }

    private void ValueChanged()
    {
        ValueChangeCount++;
    }

    private void ValuesChanged()
    {
        ValuesChangeCount++;
    }
}
