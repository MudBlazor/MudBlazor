<MudPopoverProvider />

Value: @_selected
<br />
<MudSelect @bind-Value="@_selected" ShrinkToContent="_shinkToContent">
    @foreach (MyEnum item in Enum.GetValues(typeof(MyEnum)))
    {
        <MudSelectItem Value="@item">@item</MudSelectItem>
    }
</MudSelect>

<MudSwitch @bind-Value="_shinkToContent" Class="mt-4" Color="Color.Primary">Fit Content</MudSwitch>

@code {
    public static string __description__ = "Initial Text should be the enum's default value.";

    private bool _shinkToContent;
    private MyEnum _selected;

    public enum MyEnum
    {
        First,
        Second,
    }
}
