@* Regression coverage for issue #13232: class type T in MultiSelection. *@
<MudList T="Item" SelectedValues="SelectedValues" SelectedValuesChanged="OnSelectedValuesChanged" SelectionMode="Mode" ReadOnly="ReadOnly">
    @foreach (var item in Items)
    {
        <MudListItem Text="@item.Name" Value="@(ProvideValue ? item : null)" Disabled="@item.Disabled" />
    }
    @if (IncludeNestedParent)
    {
        @* Group header: it expands rather than selects, so it must not require a Value. *@
        <MudListItem Text="Group">
            <NestedList>
                <MudListItem Text="Nested child" Value="@(ProvideValue ? _nestedChild : null)" />
            </NestedList>
        </MudListItem>
    }
</MudList>

<p class="selected-count">@(SelectedValues?.Count ?? 0)</p>
<p class="changed-count">@_changedCount</p>

@code {
    private int _changedCount;
    private readonly Item _nestedChild = new() { Name = "Nested child" };

    [Parameter]
    public bool ProvideValue { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool IncludeNestedParent { get; set; }

    [Parameter]
    public SelectionMode Mode { get; set; } = SelectionMode.MultiSelection;

    [Parameter]
    public List<Item> Items { get; set; } =
    [
        new() { Name = "Milk" },
        new() { Name = "Sparkling Water" }
    ];

    public IReadOnlyCollection<Item> SelectedValues { get; set; } = [];

    private void OnSelectedValuesChanged(IReadOnlyCollection<Item>? values)
    {
        SelectedValues = values ?? [];
        _changedCount++;
    }

    public class Item
    {
        public string Name { get; set; } = string.Empty;
        public bool Disabled { get; set; }
    }
}
