<p class="selected-values">
    @(string.Join(", ", (SelectedValues ?? Array.Empty<string>()).OrderBy(x => x)))
</p>

@code {
    [Parameter]
    public IReadOnlyCollection<string>? SelectedValues { get; set; }
}