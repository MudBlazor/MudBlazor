<MudList T="string" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection">
    <MudListSubheader>
        Select your favourite drinks:
    </MudListSubheader>
    <MudListItem Value='"Milk"'>Milk</MudListItem>
    <MudListItem Value='"Carbonated H²O"'>Sparkling Water</MudListItem>
    <MudListItem Value='"Teas"'>
        <ChildContent>Teas</ChildContent>
        <NestedList>
            <MudListItem Value='"Earl Grey"'>English Tea</MudListItem>
            <MudListItem Value='"Matcha"'>Japanese Tea</MudListItem>
            <MudListItem Value='"Wu Long Cha"'>Chinese Tea</MudListItem>
        </NestedList>
    </MudListItem>
    <MudListItem Value='"Coffees"'>
        <ChildContent>Coffees</ChildContent>
        <NestedList>
            <MudListItem Value='"Irish Coffee"'>Irish Coffee</MudListItem>
            <MudListItem Value='"Double Espresso"'>Double Espresso</MudListItem>
            <MudListItem Value='"Cafe Latte"'>Cafe Latte</MudListItem>
        </NestedList>
    </MudListItem>
    <MudListItem Value='"Juices"'>
        <ChildContent>Juices</ChildContent>
        <NestedList>
            <MudListItem Value='"Apple Juice"' Disabled="true">Apple Juice</MudListItem>
            <MudListItem Value='"Orange Juice"' Disabled="true">Orange Juice</MudListItem>
        </NestedList>
    </MudListItem>
</MudList>

<p class="selected-values">
    @(string.Join(", ", (SelectedValues ?? Array.Empty<string>()).OrderBy(x => x)))
</p>

@code {
    [Parameter]
    public IReadOnlyCollection<string>? SelectedValues { get; set; }
}
