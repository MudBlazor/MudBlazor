<MudList T="string" Color="Color" @bind-SelectedValue="_selectedValue">
    <MudListSubheader>
        Your drink:
        <MudChip Color="Color.Secondary">
            @(_selectedValue ?? "You are dry")
        </MudChip>
    </MudListSubheader>
    <MudListItem Value='"Sparkling Water"'>Sparkling Water</MudListItem>
    <MudListItem Value='"Teas"'>
        <ChildContent>Teas</ChildContent>
        <NestedList>
            <MudListItem Value='"Earl Grey"'>Earl Grey</MudListItem>
            <MudListItem Value='"Matcha"'>Matcha</MudListItem>
            <MudListItem Value="@("Pu'er")">Pu'er</MudListItem>
        </NestedList>
    </MudListItem>
    <MudListItem Value='"Coffees"'>
        <ChildContent>Coffees</ChildContent>
        <NestedList>
            <MudListItem Value='"Irish Coffee"'>Irish Coffee</MudListItem>
            <MudListItem Value='"Double Espresso"'>Double Espresso</MudListItem>
            <MudListItem Value='"Cafe Latte"'>Cafe Latte</MudListItem>
        </NestedList>
    </MudListItem>
</MudList>

@code {
    public static string __description__ = "Sparkling Water should be selected initially.";

    private string? _selectedValue = "Sparkling Water";

    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    public void SetSelectedValue(string value)
    {
        _selectedValue = value;
        StateHasChanged();
    }
}