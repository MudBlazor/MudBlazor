<MudPopoverProvider />

<MudDataGrid T="Model" Items="_clients" Dense="Dense" Filterable="true" ShowMenuIcon="true" ColumnsPanelReordering="true" Hideable="true">
    <Columns>
        <PropertyColumn Property="x => x.Username" Title="Username" />
        <PropertyColumn Property="x => x.HwId" Title="HWID" />
        <TemplateColumn T="Model" Title="Status">
            <CellTemplate>
                <MudChip Color="Color.Error" Size="Size.Small">Offline</MudChip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch Class="ml-n3" @bind-Value="Dense" Color="Color.Primary" Label="Dense" />
</div>

@code {
    [Parameter]
    public bool Dense { get; set; }

    private readonly List<Model> _clients =
    [
        new() { Username = "user123", HwId = "000-000-000-000", HiddenInformation = "Not good Grid info for user123" },
        new() { Username = "joedoe", HwId = "111-000-111-000", HiddenInformation = "Not good Grid info for joedoe" }
    ];

    public class Model
    {
        public string Username { get; set; } = string.Empty;

        public string HwId { get; set; } = string.Empty;

        public string HiddenInformation { get; set; } = string.Empty;
    }
}
