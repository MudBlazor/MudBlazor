<MudPopoverProvider/>

<MudDataGrid @ref="dataGrid" T="Model" Items="@_items" Dense ColumnResizeMode="ResizeMode.Column" Hideable>
    <ToolBarContent>
        <MudButton Class="mr-2" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => dataGrid.OrderColumnsAsync(["Column1", "Column2", "Column3"]))">Order 1 2 3</MudButton>
        <MudButton Class="mr-2" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => dataGrid.OrderColumnsAsync(["Column3", "Column2", "Column1"]))">Order 3 2 1</MudButton>
        <MudButton Class="mr-2" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => dataGrid.OrderColumnsAsync(["Column1", "Column3", "Column5"]))">Order 1 3 5</MudButton>
        <MudButton Class="mr-2" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => dataGrid.OrderColumnsAsync(["Column5", "Column4", "Column3", "Column2", "Column1"]))">Order 5 4 3 2 1</MudButton>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Column1"/>
        <PropertyColumn Property="x => x.Column2"/>
        <PropertyColumn Property="x => x.Column3"/>
        <PropertyColumn Property="x => x.Column4"/>
        <PropertyColumn Property="x => x.Column5"/>
    </Columns>
</MudDataGrid>

@code {
    public static string __description__ = "Tests if the columns can be ordered programmatically in the MudDataGrid component.";
    
    private MudDataGrid<Model> dataGrid = new();
    private IEnumerable<Model> _items = new List<Model>();

    public record Model(
        string Column1,
        string Column2,
        string Column3,
        string Column4,
        string Column5);
}
