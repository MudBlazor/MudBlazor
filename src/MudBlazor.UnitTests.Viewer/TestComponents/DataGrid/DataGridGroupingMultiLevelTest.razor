@using System.Collections.Generic
@inject HttpClient httpClient

<MudDataGrid @ref="@dataGrid"
Items=@_states
Hover 
Height="500px" 
FixedHeader
Groupable
GroupExpanded="false"
GroupClass="@(_customizeGroupStyle ? "pa-4" : null)"
GroupStyle="@(_customizeGroupStyle ? "background-color: var(--mud-palette-background-grey);" : null)"
GroupClassFunc="@(_customizeGroupStyle ? GroupClassFunc : null)"
GroupStyleFunc="@(_customizeGroupStyle ? GroupStyleFunc : null)">
    <ToolBarContent>
        <MudText Typo="Typo.h6">US States Information<sub style="color: var(--mud-palette-warning);font-size: smaller;">2025</sub></MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.State" Title="State" Groupable="false" />
        <PropertyColumn Property="x => x.Counties" Groupable="false" />
        <PropertyColumn Property="x => x.Population" Groupable="false" />
        <PropertyColumn Property="x => x.PrimaryIndustry" Title="Primary Industry"GroupBy="_groupBy1">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">Primary Industry: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">Primary Industry: @context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Region" Title="Region" />
        <PropertyColumn Property="x => x.Climate" Title="Climate">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">Climate: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">Climate: @context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.YearInducted" Title="Year Inducted" GroupBy="x => x.YearInducted">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">Year Inducted: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">Year Inducted: @context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch T="bool" @bind-Value="_customizeGroupTemplate" Color="@Color.Primary">Customize Group Template</MudSwitch>
    <MudSwitch T="bool" Value="@_customizeGroupBy" Color="@Color.Primary" ValueChanged="@CustomizeByGroupChanged">Customize Group By</MudSwitch>
    <MudSwitch T="bool" @bind-Value="_customizeGroupStyle" Color="@Color.Primary">Customize Group Style</MudSwitch>
    <MudButton OnClick="@ExpandAllGroups" Color="@Color.Primary">Expand All</MudButton>
    <MudButton OnClick="@CollapseAllGroups" Color="@Color.Primary">Collapse All</MudButton>
</div>

@code {
#nullable enable
    public static string __description__ = "Multi Level Grouping within DataGrid";
    private IEnumerable<USState> _states = [];
    private MudDataGrid<USState>? dataGrid;
    private bool _customizeGroupTemplate;
    private static bool _customizeGroupBy;
    
    Func<USState, object> _groupBy1 = x =>
    {
        if (_customizeGroupBy)
            return x.PrimaryIndustry.Equals("Healthcare") ? "HealthCare" : "Other";
        return x.State;
    };

    private string GroupClassFunc(GroupDefinition<USState> item)
    {
        var key = item.Grouping.Key.ToString();
        return key == "HealthCare" || key == "Other"
            ? "mud-theme-warning"
            : string.Empty;
    }

    private string GroupStyleFunc(GroupDefinition<USState> item)
    {
        var key = item.Grouping.Key.ToString();
        return key == "HealthCare" 
            ? "border-left: 4px solid var(--mud-palette-primary);" 
            : "border-left: 4px solid var(--mud-palette-secondary);";
    }

    bool _customizeGroupStyle;

    protected override void OnInitialized()
    {
        _states = GetAllStates();
    }

    void ExpandAllGroups()
    {
        dataGrid?.ExpandAllGroups();
    }

    void CollapseAllGroups()
    {
        dataGrid?.CollapseAllGroups();
    }

    void CustomizeByGroupChanged(bool isChecked)
    {
        _customizeGroupBy = isChecked;
        dataGrid?.GroupItems();
    }

