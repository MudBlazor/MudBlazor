﻿﻿﻿﻿@using System.Net.Http.Json
@using MudBlazor.Examples.Data.Models
@using System.Collections.Generic
@inject HttpClient httpClient
#nullable enable

<MudDataGrid @ref="@dataGrid"
Items=@Elements
Hover 
Height="500px" 
FixedHeader
Groupable
GroupExpanded="false"
GroupClass="@(_customizeGroupStyle ? "pa-4" : null)"
GroupStyle="@(_customizeGroupStyle ? "background-color: var(--mud-palette-background-grey);" : null)"
GroupClassFunc="@(_customizeGroupStyle ? GroupClassFunc : null)"
GroupStyleFunc="@(_customizeGroupStyle ? GroupStyleFunc : null)">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Periodic Elements</MudText>
        <MudSpacer />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" Filterable="false" Groupable="false" />
        <PropertyColumn Property="x => x.Sign" />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Position" Title="Position">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">Position: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">Position: @context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
        <PropertyColumn Property="x => x.Group" Title="Category" Grouping GroupBy="@_groupBy1">
            <GroupTemplate>
                @if (_customizeGroupTemplate)
                {
                    <span style="font-weight:bold">Group: @context.Grouping.Key <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">total @context.Grouping.Count()</MudChip></span>
                }
                else
                {
                    <span style="font-weight:bold">Category: @context.Grouping.Key</span>
                }
            </GroupTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>

<div class="d-flex flex-wrap mt-4">
    <MudSwitch T="bool" @bind-Value="_customizeGroupTemplate" Color="@Color.Primary">Customize Group Template</MudSwitch>
    <MudSwitch T="bool" Value="@_customizeGroupBy" Color="@Color.Primary" ValueChanged="@CustomizeByGroupChanged">Customize Group By</MudSwitch>
    <MudSwitch T="bool" @bind-Value="_customizeGroupStyle" Color="@Color.Primary">Customize Group Style</MudSwitch>
    <MudButton OnClick="@ExpandAllGroups" Color="@Color.Primary">Expand All</MudButton>
    <MudButton OnClick="@CollapseAllGroups" Color="@Color.Primary">Collapse All</MudButton>
</div>

@code {
    public static string __description__ = "Multi Level Grouping within DataGrid";
    IEnumerable<Element> Elements = new List<Element>();
    MudDataGrid<Element>? dataGrid;
    bool _customizeGroupTemplate;
    static bool _customizeGroupBy;
    static string[] _nonmetals = new string[] { "H", "He","N", "O", "F", "Ne", "Cl", "Ar", "Kr", "Xe", "Rn", "Br", "C", "P", "Se", "Se", "I" };
    Func<Element, object> _groupBy1 = x => 
    {
        if (_customizeGroupBy)
            return _nonmetals.Contains(x.Sign) ? "Nonmetal" : "Metal";
        return x.Group ?? string.Empty;
    };

    private string GroupClassFunc(GroupDefinition<Element> item)
    {
        var key = item.Grouping.Key.ToString();
        return key == "Nonmetal" || key == "Other"
            ? "mud-theme-warning"
            : string.Empty;
    }

    private string GroupStyleFunc(GroupDefinition<Element> item)
    {
        var key = item.Grouping.Key.ToString();
        return key == "Metal" 
            ? "border-left: 4px solid var(--mud-palette-primary);" 
            : "border-left: 4px solid var(--mud-palette-secondary);";
    }

    bool _customizeGroupStyle;

    protected override async Task OnInitializedAsync()
    {
        var elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
        Elements = elements ?? new List<Element>();
    }

    void ExpandAllGroups()
    {
        dataGrid?.ExpandAllGroups();
    }

    void CollapseAllGroups()
    {
        dataGrid?.CollapseAllGroups();
    }

    void CustomizeByGroupChanged(bool isChecked)
    {
        _customizeGroupBy = isChecked;
        dataGrid?.GroupItems();
    }
}
