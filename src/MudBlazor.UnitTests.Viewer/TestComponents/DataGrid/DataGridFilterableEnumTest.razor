<MudPopoverProvider />

<MudDataGrid Items="@_items" Filterable="true">
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.Status" Title="Status" />
    </Columns>
</MudDataGrid>

@code {
    private readonly IEnumerable<Item> _items = new List<Item>
    {
        new("Alice", ItemStatus.Active),
        new("Bob", ItemStatus.Inactive),
        new("Charlie", ItemStatus.Active),
        new("Diana", ItemStatus.Pending),
        new("Eve", ItemStatus.Inactive),
        new("Frank", ItemStatus.Pending)
    };

    public class Item
    {
        public string Name { get; set; }
        public ItemStatus Status { get; set; }

        public Item(string name, ItemStatus status)
        {
            Name = name;
            Status = status;
        }
    }

    public enum ItemStatus
    {
        Active,
        Inactive,
        Pending
    }
}
