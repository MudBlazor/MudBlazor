@using Microsoft.AspNetCore.Components.Web

<MudPopoverProvider />

<MudMenu Label="Full Menu Width" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" ActivationEvent="@MouseEvent.MouseOver" HoverDelay="@HoverDelay">
    <MudMenuItem Class="test-class">1</MudMenuItem>
    <MudMenuItem Href="https://www.test.com">2</MudMenuItem>
    <MudMenuItem Href="https://www.test.com" Target="_blank">3</MudMenuItem>
</MudMenu>

@code {
    [Parameter]
    public int? HoverDelay { get; set; }
}
