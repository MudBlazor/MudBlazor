<MudToggleGroup @bind-Value="_value" T="string" Color="Color.Primary" Disabled="true">
    <MudToggleItem T="string" Value='"Enabled 1"'>Enabled Item 1</MudToggleItem>
    <MudToggleItem T="string" Value='"Enabled 2"'>Enabled Item 2</MudToggleItem>
    <MudToggleItem T="string" Value='"Disabled"' Disabled="true">Disabled Item</MudToggleItem>
</MudToggleGroup>

<MudToggleGroup @bind-Value="_value" T="string" Color="Color.Primary">
    <MudToggleItem T="string" Value='"Enabled 1"'>Enabled Item 1</MudToggleItem>
    <MudToggleItem T="string" Value='"Enabled 2"'>Enabled Item 2</MudToggleItem>
    <MudToggleItem T="string" Value='"Disabled"' Disabled="true">Disabled Item</MudToggleItem>
</MudToggleGroup>

@code {
    public static string __description__ = "It should be possible to disable whole toggle groups and/or toggle items";
    private string? _value;
}
