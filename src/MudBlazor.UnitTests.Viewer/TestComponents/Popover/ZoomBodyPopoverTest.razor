<MudPopoverProvider />

<style>
    body {
        zoom: 0.6;
    }

    .zoom-popover-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 700px;
        margin-bottom: 700px;
    }

    .zoom-popover-select {
        width: 300px;
    }
</style>

<MudStack Spacing="2">
    <MudText Typo="Typo.h6">Popover with body zoom</MudText>
    <MudText Typo="Typo.body2">
        Scroll to the select, open it, and verify that the dropdown remains aligned with the field when the body uses zoom: 0.6.
    </MudText>
</MudStack>

<div class="zoom-popover-wrapper">
    <div class="zoom-popover-select">
        <MudSelect T="string"
                   Label="Fruit"
                   Variant="Variant.Outlined"
                   @bind-Value="_value"
                   AdornmentIcon="@Icons.Material.Filled.LocalFlorist">
            <MudSelectItem Value="@("Apple")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFlorist" Class="mr-2" />
                    Apple
                </div>
            </MudSelectItem>
            <MudSelectItem Value="@("Home")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-2" />
                    Home
                </div>
            </MudSelectItem>
            <MudSelectItem Value="@("Star")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                    Star
                </div>
            </MudSelectItem>
            <MudSelectItem Value="@("Settings")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                    Settings
                </div>
            </MudSelectItem>
            <MudSelectItem Value="@("Favorite")">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="mr-2" />
                    Favorite
                </div>
            </MudSelectItem>
        </MudSelect>
    </div>
</div>

@code {
    public static string __description__ = "After scrolling, the MudSelect dropdown should stay aligned with its field when body zoom is set to 0.6.";

    private string? _value;
}
