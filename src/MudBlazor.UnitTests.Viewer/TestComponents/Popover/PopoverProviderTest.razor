<CascadingValue Value="ProviderEnabled" Name="UsePopoverProvider">
    @if (ShowProvider)
    {
        <MudPopoverProvider />
    }
</CascadingValue>

<div class="popoverparent">
    <MudPopover Open="true">
        <MudText id="my-content">Popover content</MudText>
    </MudPopover>
</div>

@if (ShowSecondPopover)
{
    <div class="popoverparent">
        <MudPopover Open="true">Second popover</MudPopover>
    </div>
}

@code {
    [Parameter]
    public bool ProviderEnabled { get; set; } = true;

    [Parameter]
    public bool ShowProvider { get; set; } = true;

    [Parameter]
    public bool ShowSecondPopover { get; set; }
}
