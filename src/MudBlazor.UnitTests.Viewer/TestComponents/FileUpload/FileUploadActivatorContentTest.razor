<MudText>File Upload with Activator Content</MudText>
<MudFileUpload T="IReadOnlyList<IBrowserFile>"
@ref="@_fileUpload"
AppendMultipleFiles
DragandDrop="true"
tabindex="-1"
@bind-Dragging="@_dragging"
@bind-Dragging:after="@ClearDragClass">
    <CustomContent>
        <MudPaper Height="300px"
        Outlined="true"
        @onclick="@context.OpenFilePickerAsync"
        @ondragenter="@SetDragClass"
        Class="@_dragClass">
            <MudText Typo="Typo.h6">
                Drag and drop files here or click
            </MudText>
            @foreach (var file in context.GetFilenames())
            {
                <MudChip T="string"
                Color="Color.Dark"
                Text="@file"
                tabindex="-1" />
            }
            <MudToolBar Gutters="@false"
            Class="relative d-flex justify-end gap-4 z-11">
                <MudButton Color="Color.Primary"
                OnClick="@context.OpenFilePickerAsync"
                Variant="Variant.Filled">
                    Open file picker
                </MudButton>
                <MudButton Color="Color.Error"
                Disabled="@(!context.GetFilenames().Any())"
                OnClick="@context.ClearAsync"
                Variant="Variant.Filled">
                    Clear
                </MudButton>
            </MudToolBar>
        </MudPaper>
    </CustomContent>
    <SelectedTemplate />
</MudFileUpload>

@code {



    #nullable enable
    public static string __description__ = "A test for using components inside CustomContent that don't activate.";
    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 mud-width-full mud-height-full";
    private string _dragClass = DefaultDragClass;

    private bool _dragging = false;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;

    private void SetDragClass()
    {
        _dragClass = $"{DefaultDragClass} mud-border-primary";
        _dragging = true;
    }

    private void ClearDragClass()
    {
        if (!_dragging)
        {
            _dragClass = DefaultDragClass;
        }
    }
}