<MudRadioGroup @bind-Value="@_option">
    <MudRadio Value="@("1")" Dense="true" Label="Dense" />
    <MudRadio Value="@("2")" Size="Size.Small" Label="Small" />
    <MudRadio Value="@("3")" Label="Default" />
    <MudRadio Value="@("4")" Size="Size.Medium" Label="Medium" />
    <MudRadio Value="@("5")" Size="Size.Large" Label="Large" />
</MudRadioGroup>

<MudButton OnClick="OnClick" />

@code {
    public static string __description__ = "RadioGroup should be resettable";

    private string? _option;

    private void OnClick() => _option = null;
}
