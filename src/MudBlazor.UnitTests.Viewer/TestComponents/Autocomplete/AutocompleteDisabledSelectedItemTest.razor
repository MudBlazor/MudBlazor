<MudPopoverProvider />

<MudAutocomplete T="string" SearchFunc="@SearchAsync" ItemDisabledFunc="@ItemDisabledFunc"
                 @bind-Value="@Value" Strict="false" DebounceInterval="0" />

@code {
    // The selected value is an item that is disabled, so the highlighted row is a disabled row.
    public string? Value { get; set; } = "carrot";

    public Func<string, bool> ItemDisabledFunc { get; set; } = x => x == "carrot";

    private readonly string[] _fruits = ["apple", "banana", "carrot", "cherry"];

    public Task<IEnumerable<string>> SearchAsync(string? text, CancellationToken token)
    {
        var all = _fruits.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(text))
        {
            all = all.Where(x => x.Contains(text, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(all);
    }
}
