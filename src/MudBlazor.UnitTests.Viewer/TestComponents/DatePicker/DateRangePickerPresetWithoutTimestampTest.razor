<MudDateRangePicker @ref="PickerReference" PickerVariant="PickerVariant.Static" @bind-DateRange="DateRange" />

@code {
    public static string __description__ = "DateTime range without a timestamp";

    [Parameter]
    public DateRange<DateTime?>? DateRange { get; set; } = new DateRange<DateTime?>(DateTime.Now.AddMonths(-1).Date, DateTime.Now.Date);

    public MudDateRangePicker<DateTime?>? PickerReference;
}