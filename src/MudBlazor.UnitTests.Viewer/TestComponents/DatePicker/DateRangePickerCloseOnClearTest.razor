<MudPopoverProvider/>

<MudDateRangePicker TValue="DateTime?" id="picker" @ref="_picker" Label="With action buttons" @bind-DateRange="DateRange">
    <PickerActions>
        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync(CloseOnClear))">Clear</MudButton>
    </PickerActions>
</MudDateRangePicker>

@code {
    private MudDateRangePicker<DateTime?> _picker = null!;

    [Parameter]
    public DateRange<DateTime?>? DateRange { get; set; }

    [Parameter]
    public bool CloseOnClear { get; set; }
}