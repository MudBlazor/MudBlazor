@* Issue #8600: Nested steppers with different orientation *@
@* Outer (horizontal) should not force inner (vertical) to render as horizontal *@
<MudStepper Color="Color.Primary" Variant="Variant.Filled" Vertical="false" NonLinear="true">
    <MudStep Title="General Info">
        <MudText>Parent Step 1 Content</MudText>
    </MudStep>
    <MudStep Title="Detailed Configuration">
        <MudStepper Color="Color.Secondary" Variant="Variant.Text" Vertical="true">
            <MudStep Title="Sub-Step A">
                <MudText>Details for A...</MudText>
            </MudStep>
            <MudStep Title="Sub-Step B">
                <MudText>Details for B...</MudText>
            </MudStep>
        </MudStepper>
    </MudStep>
    <MudStep Title="Finalize">
        <MudText>Parent Step 3 Content</MudText>
    </MudStep>
</MudStepper>
