<MudPopoverProvider />

<MudForm>
    <MudSelect T="string"
               Label="Select"
               @bind-Value="Value">
        <MudSelectItem Value='"Alpha"'>Alpha</MudSelectItem>
        <MudSelectItem Value='"Beta"'>Beta</MudSelectItem>
    </MudSelect>
</MudForm>

<MudButton id="set-select-value"
           OnClick="@(() => SetValue("Alpha"))">
    Set select value
</MudButton>

@code {
    public static string __description__ = "Sets a select value from the parent after render to verify touched state remains unchanged until user interaction.";

    public string? Value { get; private set; }

    public void SetValue(string? value)
    {
        Value = value;
        StateHasChanged();
    }
}
