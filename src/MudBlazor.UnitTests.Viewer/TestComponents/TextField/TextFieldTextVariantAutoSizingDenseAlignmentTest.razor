<p>Reproduction for <MudLink Href="https://github.com/MudBlazor/MudBlazor/issues/11480" Target="_blank">issue #11480</MudLink>.</p>
<p>Bottom underline should align for <code>Variant.Text</code> in every row when comparing <code>Sizing.Fixed</code> vs <code>Sizing.Auto</code>.</p>

<div style="display:grid; grid-template-columns: 240px minmax(0,1fr) minmax(0,1fr); gap: 12px; align-items:start;">
    <MudText Typo="Typo.subtitle2">Case</MudText>
    <MudText Typo="Typo.subtitle2">Sizing.Fixed</MudText>
    <MudText Typo="Typo.subtitle2">Sizing.Auto</MudText>

    <MudText Typo="Typo.body2">Margin.None, no label</MudText>
    <MudTextField T="string" Margin="Margin.None" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.None" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.None, with label</MudText>
    <MudTextField T="string" Margin="Margin.None" Label="None fixed label" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.None" Label="None auto label" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, no label</MudText>
    <MudTextField T="string" Margin="Margin.Dense" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, with label</MudText>
    <MudTextField T="string" Margin="Margin.Dense" Label="Dense fixed label" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" Label="Dense auto label" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, placeholder</MudText>
    <MudTextField T="string" Margin="Margin.Dense" Placeholder="Dense fixed placeholder" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" Placeholder="Dense auto placeholder" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, helper text</MudText>
    <MudTextField T="string" Margin="Margin.Dense" HelperText="Dense fixed helper" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" HelperText="Dense auto helper" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, disabled</MudText>
    <MudTextField T="string" Margin="Margin.Dense" Disabled="true" Label="Dense fixed disabled" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" Disabled="true" Label="Dense auto disabled" Variant="Variant.Text" Sizing="InputSizing.Auto" />

    <MudText Typo="Typo.body2">Margin.Dense, multiline baseline</MudText>
    <MudTextField T="string" Margin="Margin.Dense" Lines="2" Label="Dense fixed lines=2" Variant="Variant.Text" Sizing="InputSizing.Fixed" />
    <MudTextField T="string" Margin="Margin.Dense" Lines="2" Label="Dense auto lines=2" Variant="Variant.Text" Sizing="InputSizing.Auto" />
</div>

@code {
    public static string __description__ = "Issue #11480 regression matrix: Variant.Text underline alignment comparing Sizing.Fixed vs Sizing.Auto with dense and non-dense permutations.";
}
