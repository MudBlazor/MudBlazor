<div Style="margin-top:50px">
    Filled without Sizing
    <MudTextField T="string" Label="example" Variant="Variant.Filled"/>
</div>

<div Style="margin-top:50px">
    Filled with Sizing=Auto
    <MudTextField T="string" Label="example" Variant="Variant.Filled" Sizing="InputSizing.Auto"/>
</div>

<div Style="margin-top:50px">
    Filled , Dense without Sizing
    <MudTextField T="string" Label="example" Margin="Margin.Dense" Variant="Variant.Filled"/>
</div>

<div Style="margin-top:50px">
    Filled , Dense with Sizing=Auto
    <MudTextField T="string" Label="example" Margin="Margin.Dense" Variant="Variant.Filled" Sizing="InputSizing.Auto"/>
</div>

<div Style="margin-top:50px">
    Auto sizing with MaxLines test
    <MudTextField T="string" MaxLines="5" Label="example" Variant="Variant.Filled" Sizing="InputSizing.Auto"/>
</div>

<div Style="margin-top:50px">
    Outlined without Sizing
    <MudTextField T="string" Label="example" Variant="Variant.Outlined"/>
</div>

<div Style="margin-top:50px">
    Outlined with Sizing=Auto
    <MudTextField T="string" Label="example" Variant="Variant.Outlined" Sizing="InputSizing.Auto"/>
</div>

<div Style="margin-top:50px">
    Outlined , Dense without Sizing
    <MudTextField T="string" Label="example" Margin="Margin.Dense" Variant="Variant.Outlined"/>
</div>

<div Style="margin-top:50px">
    Outlined , Dense with Sizing=Auto
    <MudTextField T="string" Label="example" Margin="Margin.Dense" Variant="Variant.Outlined" Sizing="InputSizing.Auto"/>
