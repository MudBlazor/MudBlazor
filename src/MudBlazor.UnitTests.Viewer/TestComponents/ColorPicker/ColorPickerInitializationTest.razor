@using MudBlazor.Utilities

<MudPopoverProvider />

<MudColorPicker @ref="_picker"
                @bind-Value="_value"
                ColorPickerMode="@ColorPickerMode"
                PickerVariant="@PickerVariant" />

@code {
    private MudColorPicker _picker = null!;
    private MudColor? _value;

    [Parameter]
    public MudColor? InitialValue { get; set; }

    [Parameter]
    public MudColor? PseudoAsyncValue { get; set; }

    [Parameter]
    public MudColor? AsyncValue { get; set; }

    [Parameter]
    public int DelayMs { get; set; } = 10;

    [Parameter]
    public ColorPickerMode ColorPickerMode { get; set; } = ColorPickerMode.RGB;

    [Parameter]
    public PickerVariant PickerVariant { get; set; } = PickerVariant.Static;

    public MudColor? Value => _value;

    public Task OpenPicker()
    {
        return InvokeAsync(async () => await _picker.OpenAsync());
    }

    protected override async Task OnInitializedAsync()
    {
        _value = InitialValue;

        if (PseudoAsyncValue is not null)
        {
            _value = PseudoAsyncValue;
        }

        if (AsyncValue is not null)
        {
            await Task.Delay(DelayMs);
            _value = AsyncValue;
        }
    }
}
