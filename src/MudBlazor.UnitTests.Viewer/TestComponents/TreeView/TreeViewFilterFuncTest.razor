<MudTreeView @ref="_treeView" Items="@Items" FilterFunc="MatchesName">
    <ItemTemplate>
        <MudTreeViewItem @bind-Expanded="@context.Expanded" Items="@context.Children" Value="@context.Value"
                         Icon="@context.Icon" Text="@context.Text" Visible="@context.Visible" />
    </ItemTemplate>
</MudTreeView>

@code {
    [Parameter]
    public string SearchPhrase { get; set; }

    private MudTreeView<string> _treeView;

    public List<TreeItemData> Items { get; set; } = new();

    public class TreeItemData : TreeItemData<string>
    {
        public TreeItemData(string title) : base(title)
        {
            Text = title;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Items.Add(new TreeItemData("Trash"));
        Items.Add(new TreeItemData("Categories")
        {
            Children = new()
            {
                new TreeItemData("Social"),
            }
        });

        _treeView.Filter();
    }

    private bool MatchesName(TreeItemData<string> item) => item.Text.Contains(SearchPhrase, StringComparison.OrdinalIgnoreCase);
}
