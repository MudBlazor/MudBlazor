<MudChipSet T="int" SelectionMode="SelectionMode.MultiSelection" CheckMark @bind-SelectedValues="_selectedValues">
    <MudChip Variant="Variant.Outlined" Color="Color.Success" Value="1">Set1 Chip1</MudChip>
    <MudChip Variant="Variant.Outlined" Color="Color.Error" Value="2">Set1 Chip2</MudChip>
</MudChipSet>

<MudChipSet T="int" SelectionMode="SelectionMode.MultiSelection" CheckMark @bind-SelectedValues="_selectedValues">
    <MudChip Variant="Variant.Outlined" Color="Color.Success" Value="1">Set2 Chip1</MudChip>
    <MudChip Variant="Variant.Outlined" Color="Color.Error" Value="2">Set2 Chip2</MudChip>
</MudChipSet>

<br />
<p class="set">
    Selection: @(string.Join(", ", _selectedValues.OrderBy(x => x)))
</p>

@code {
    public static string __description__ = "The chipsets should mirror their respective selections";

    private IReadOnlyCollection<int> _selectedValues = [ 1 ];
}
