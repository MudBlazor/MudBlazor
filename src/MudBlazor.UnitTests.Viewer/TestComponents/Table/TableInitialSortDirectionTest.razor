<MudTable Items="@_examples" T="string">
    <HeaderContent>
        <MudTh><MudTableSortLabel InitialSortDirection="SortDirection.Descending" SortBy="new Func<string, object>(x=>x)">#</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nr">@context</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private readonly IEnumerable<string> _examples = new List<string> { "B", "A", "C" };
}
