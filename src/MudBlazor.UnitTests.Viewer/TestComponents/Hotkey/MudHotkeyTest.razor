@using MudBlazor.Utilities

<MudHotkey @ref="_hotkey" Key="SelectedKey" KeyModifiers="_selectedKeyModifiers" OnHotkeyPressed="OnHotKey" HideChildContentOnRepress="HideChildContentOnRepress" Disabled="Disabled">
    <div id="hotkey-child">
        Child Content
    </div>
</MudHotkey>

@code {
    private MudHotkey _hotkey = null!;
    private const JsKey SelectedKey = JsKey.KeyA;
    private readonly IEnumerable<JsKeyModifier> _selectedKeyModifiers = [JsKeyModifier.Control];

    public int PressedCount { get; private set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool HideChildContentOnRepress { get; set; }

    private void OnHotKey()
    {
        PressedCount++;
    }

    public void Dispose()
    {
        _hotkey.Dispose();
    }
}
