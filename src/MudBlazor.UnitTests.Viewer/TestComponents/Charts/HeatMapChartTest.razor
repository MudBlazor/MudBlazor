
<MudGrid>
    <MudItem xs="2" Class="d-flex align-center">
        <MudRadioGroup T="ShowLegendPosition" Value="_showLegendPosition" ValueChanged="@((ShowLegendPosition value) => ShowLegendPositionChanged(value))" Class="d-flex flex-column align-center justify-center">

            <!-- Top Radio -->
            <MudItem xs="12" Class="d-flex justify-center align-center">
                <MudRadio Color="Color.Primary" Value="ShowLegendPosition.Top" Dense>Top</MudRadio>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-center py-2">
                <MudGrid Class="align-center justify-center">
                    <!-- Left Radio -->
                    <MudItem xs="4" Class="d-flex align-center justify-center">
                        <MudRadio Color="Color.Primary" Value="ShowLegendPosition.Left" Dense>Left</MudRadio>
                    </MudItem>

                    <!-- Center Badge -->
                    <MudItem xs="4" Class="d-flex align-center justify-center">
                        <MudBadge Origin="@_anchorOrigin" Color="Color.Primary" Dot="true" Overlap Elevation="4" BadgeClass="ma-2">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-6">
                                <MudText Align="Align.Center">Heat Map</MudText>
                            </MudPaper>
                        </MudBadge>
                    </MudItem>

                    <!-- Right Radio -->
                    <MudItem xs="4" Class="d-flex align-center justify-center">
                        <MudRadio Color="Color.Primary" Value="ShowLegendPosition.Right" Dense>Right</MudRadio>
                    </MudItem>
                </MudGrid>
            </MudItem>

            <!-- Bottom Radio -->
            <MudItem xs="12" Class="d-flex justify-center align-center">
                <MudRadio Color="Color.Primary" Value="ShowLegendPosition.Bottom" Dense>Bottom</MudRadio>
            </MudItem>

        </MudRadioGroup>
    </MudItem>
    <MudItem xs="10">
        <MudChart ChartType="ChartType.HeatMap" ChartSeries="@Series" XAxisLabels="@XAxisLabels" ChartOptions="@options"></MudChart>
    </MudItem>
</MudGrid>
<MudGrid>
    <MudItem xs="2">
        <MudButton OnClick="@RandomizeData" Variant="Variant.Filled">Randomize Data</MudButton>
    </MudItem>
    <MudItem xs="2">
        <MudCheckBox T="bool" Value="@_enableGradient" ValueChanged="@((bool value) => SwapGradient())" Color="Color.Primary">
            Smooth Gradient
        </MudCheckBox>
    </MudItem>
    <MudItem xs="3">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudText Class="pr-1">YAxis Labels Left</MudText>
            <MudSwitch T="bool" Value="@(_YAxisLabelPosition == YAxisLabelPosition.Left ? false : true)" ValueChanged="SwapYaxisLabel" Color="Color.Primary">
                Right
            </MudSwitch>
        </MudStack>
    </MudItem>
    <MudItem xs="3">
        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudText Class="pr-1">XAxis Labels Top</MudText>
            <MudSwitch T="bool" Value="@(_XAxisLabelPosition == XAxisLabelPosition.Top ? false : true)" ValueChanged="SwapXaxisLabel" Color="Color.Primary">
                Bottom
            </MudSwitch>
        </MudStack>
    </MudItem>
    <MudItem xs="2"></MudItem>
    <MudItem xs="2">
        <MudNumericField Label="Number of Colors Used" Value="_colorCount" ValueChanged="@((int value) => ColorCountChanged(value))" Min="1" Max="5" Step="1" />
    </MudItem>
    <MudItem xs="2">
        <MudCheckBox T="bool" Value="@_legendVisible" ValueChanged="@((bool value) => SwapLegendVisible(value))" Color="Color.Primary">
            Show Legend
        </MudCheckBox>
    </MudItem>
    <MudItem xs="2">
        <MudCheckBox T="bool" Value="@_showValueLabels" ValueChanged="@((bool value) => SwapValueLabels())" Color="Color.Primary">
            Show Values
        </MudCheckBox>
    </MudItem>
   <MudItem xs="6"></MudItem>
</MudGrid>

@code {
    public static string __description__ = "HeatMap Demo";
    private ChartOptions options = new ChartOptions();
    private Random random = new Random();
    private List<ChartSeries> Series = new List<ChartSeries>();
    private XAxisLabelPosition _XAxisLabelPosition = XAxisLabelPosition.Bottom;
    private YAxisLabelPosition _YAxisLabelPosition = YAxisLabelPosition.Left;
    private bool _enableGradient = false;
    private bool _showValueLabels = true;
    private bool _legendVisible = true;
    private ShowLegendPosition _showLegendPosition = ShowLegendPosition.Top;
    private Origin _anchorOrigin = Origin.TopCenter;
    private int _colorCount = 5;
    private string[] _colors = ["#007AFF", "#5AC8FA", "#34C759", "#FFCC00", "#FF9500", "#FF3B30"];

    protected override void OnInitialized()
    {
        Series = HeatMapSeries;
        BuildOptions();
    }

    private void ColorCountChanged(int value)
    {
        _colorCount = value;
        BuildOptions();
        StateHasChanged();
    }

    private void ShowLegendPositionChanged(ShowLegendPosition value)
    {
        _showLegendPosition = value;
        switch (value)
        {
            case ShowLegendPosition.Top:
                _anchorOrigin = Origin.TopCenter;
                break;
            case ShowLegendPosition.Left:
                _anchorOrigin = Origin.CenterLeft;
                break;
            case ShowLegendPosition.Right:
                _anchorOrigin = Origin.CenterRight;
                break;
            case ShowLegendPosition.Bottom:
                _anchorOrigin = Origin.BottomCenter;
                break;
            default:
                break;
        }
        BuildOptions();
        StateHasChanged();
    }

    private void SwapValueLabels()
    {
        _showValueLabels = !_showValueLabels;
        BuildOptions();
        StateHasChanged();
    }

    private void SwapLegendVisible(bool value)
    {
        _legendVisible = value;
        BuildOptions();
        StateHasChanged();
    }

    private void BuildOptions()
    {
        options = new ChartOptions();
        options.XAxisLabelPosition = _XAxisLabelPosition;
        options.YAxisLabelPosition = _YAxisLabelPosition;
        options.EnableSmoothGradient = _enableGradient;
        options.ChartPalette = _colors.Take(_colorCount).ToArray();
        options.ShowLabels = _showValueLabels;
        options.ShowLegend = _legendVisible;
        options.ShowLegendPosition = _showLegendPosition;
    }

    public List<ChartSeries> HeatMapSeries = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Mo", Data = new double[] { 90, 79, 72, 69, 62, 62, 55, 65, 70 } },
        new ChartSeries() { Name = "Te", Data = new double[] { 35, 41, 35, 51, 49, 62, 69, 91, 148 } },
        new ChartSeries() { Name = "We", Data = new double[] { 22, 90, 62, 32, 05, 42, 63, 43, 155 } },
        new ChartSeries() { Name = "Th", Data = new double[] { 35, 41, 35, 51, 49, 62, 69, 91, 148 } },
        new ChartSeries() { Name = "Fr", Data = new double[] { 22, 90, 62, 32, 05, 42, 63, 43, 155 } },
        new ChartSeries() { Name = "Sa", Data = new double[] { 35, 41, 35, 51, 49, 62, 69, 91, 148 } },
        new ChartSeries() { Name = "Su", Data = new double[] { 22, 90, 62, 32, 05, 42, 63, 43, 155 } },
    };

    public string[] XAxisLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep" };

    public void SwapXaxisLabel()
    {
        _XAxisLabelPosition =
            _XAxisLabelPosition == XAxisLabelPosition.Top ?
                XAxisLabelPosition.Bottom :
                XAxisLabelPosition.Top;
        BuildOptions();
        StateHasChanged();
    }

    public void SwapYaxisLabel()
    {
        _YAxisLabelPosition =
            _YAxisLabelPosition == YAxisLabelPosition.Left ?
                YAxisLabelPosition.Right :
                YAxisLabelPosition.Left;
        BuildOptions();
        StateHasChanged();
    }

    private void SwapGradient()
    {
        _enableGradient = !_enableGradient;
        BuildOptions();
        StateHasChanged();
    }

    private void RandomizeData()
    {
        var new_series = new List<ChartSeries>();
        string[] days = { "Mo", "Te", "We", "Th", "Fr", "Sa", "Su" };
        int dataPoints = 9;

        foreach (var day in days)
        {
            var data = new double[dataPoints];
            for (int i = 0; i < dataPoints; i++)
            {
                data[i] = random.NextDouble() * 100;
            }
            new_series.Add(new ChartSeries() { Name = day, Data = data });
        }

        Series = new_series;
        StateHasChanged();
    }

}
