@using MudBlazor.Components.Chart
<div>
    <MudBlazor.Components.Chart.MudChart ChartType="ChartType.Bar" ChartSeries="@_series" @bind-SelectedIndex="_index" ChartOptions="@_options" Width="100%" Height="350px"></MudBlazor.Components.Chart.MudChart>
</div>
<MudText Typo="Typo.h6">Selected portion of the chart: @_index</MudText>

@code {
    private int _index = -1; //default value cannot be 0 -> first selectedindex is 0.

    private readonly List<ChartDataSet> _series =
    [
        new() { Label = "United States", Data = [40, 20, 25, 27, 46, 60, 48, 80, 15] },
        new() { Label = "Germany", Data = [19, 24, 35, 13, 28, 15, 13, 16, 31] },
        new() { Label = "Sweden", Data = [8, 6, 11, 13, 4, 16, 10, 16, 18] }
    ];

    private readonly BarChartOptions _options = new()
    {
        XAxisLabelRotation = 0,
        XAxisLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"]
    };
}

