@using MudBlazor
@using MudBlazor.Components.Chart

<MudStack Spacing="2">
    <MudSelect Justify="Justify.Start" T="Justify" Label="Justify Type" @bind-Value="_selectedJustify" Dense="true">
        @foreach (Justify justify in Enum.GetValues(typeof(Justify)))
        {
            <MudSelectItem Value="justify">@justify</MudSelectItem>
        }
    </MudSelect>
    <MudSlider @bind-Value="_spacingRatio" Min="0" Max="1" Step="0.02">Spacing: @_spacingRatio.ToString("F2")</MudSlider>

    <MudBlazor.Components.Chart.MudChart ChartType="ChartType.Bar"
              ChartSeries="@_series"
              @bind-SelectedIndex="_index"
              ChartOptions="@(new BarChartOptions() { XAxisLabels = _labels, Justify = _selectedJustify, SpacingRatio = _spacingRatio })"
              Width="100%"
              Height="350px" />

    <MudText Typo="Typo.h6">Selected portion of the chart: @_index</MudText>
</MudStack>

@code {
    private int _index = -1;
    private double _spacingRatio = 1;
    private Justify _selectedJustify = Justify.FlexStart;

    private readonly List<ChartDataSet> _series =
    [
        new() { Label = "United States", Data = [40, 20, 25, 27, 46, 60, 48, 80, 15] },
        new() { Label = "Germany", Data = [19, 24, 35, 13, 28, 15, 13, 16, 31] },
        new() { Label = "Sweden", Data = [8, 6, 11, 13, 4, 16, 10, 16, 18] }
    ];

    private string[] _labels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"];
}
