<MudPaper Height="800px" Style="overflow:hidden; position:relative;">
    <MudDrawerContainer Class="mud-width-full">
        <MudDrawer @bind-Open="@_openLeft" Elevation="0" Variant="@DrawerVariant.Persistent" Anchor="Anchor.Left" Color="Color.Error">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">My App</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudDrawer @bind-Open="@_openRight" Elevation="0" Variant="@DrawerVariant.Persistent" Anchor="Anchor.Right" Color="Color.Error">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">My App</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudDrawer @bind-Open="@_openTop" Elevation="0" Variant="@DrawerVariant.Persistent" Anchor="Anchor.Top" Color="Color.Error" Height="30%">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">My App</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudDrawer @bind-Open="@_openBottom" Elevation="0" Variant="@DrawerVariant.Persistent" Anchor="Anchor.Bottom" Color="Color.Error" Height="300px">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">My App</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <div class="d-flex justify-center align-center mud-width-full mud-height-full absolute">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawerLeft">Toggle Left</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawerRight">Toggle Right</MudButton>
        </div>
        <div class="d-flex justify-center align-center mud-width-full absolute" style="top:0">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawerTop">Toggle Top</MudButton>
        </div>
        <div class="d-flex justify-center align-center mud-width-full absolute" style="bottom:0">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawerBottom">Toggle Bottom</MudButton>
        </div>
    </MudDrawerContainer>
</MudPaper>

@code {
    private bool _openTop = false;
    private bool _openBottom = false;
    private bool _openRight = false;
    private bool _openLeft = false;

    private void ToggleDrawerTop()
    {
        _openTop = !_openTop;
    }

    private void ToggleDrawerBottom()
    {
        _openBottom = !_openBottom;
    }

    private void ToggleDrawerRight()
    {
        if (_openLeft == true)
            _openLeft = !_openLeft;

        _openRight = !_openRight;
    }

    private void ToggleDrawerLeft()
    {
        if (_openRight == true)
            _openRight = !_openRight;

        _openLeft = !_openLeft;
    }
}
