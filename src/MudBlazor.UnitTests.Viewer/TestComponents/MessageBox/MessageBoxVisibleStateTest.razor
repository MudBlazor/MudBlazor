<MudButton Class="open-message-box" OnClick="OpenMessageBox">Show Message Box</MudButton>
<MudButton Class="close-message-box" OnClick="CloseMessageBox">Hide Message Box</MudButton>

<MudMessageBox @bind-Visible="_visible" Title="Confirm Action" Message="Are you sure you want to proceed?" />

@code {
    private bool _visible;

    private void OpenMessageBox() => _visible = true;

    private void CloseMessageBox() => _visible = false;
}
