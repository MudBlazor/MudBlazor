<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>$(PrimaryTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Ships the combined ICU data (icudt.dat). Required: the culture demos runtime-switch to both CJK
         (zh-CN/zh-Hans) and non-CJK/non-EFIGS (fa-IR, pt-BR) locales. Do NOT set this false to "save size":
         a single ICU shard breaks those demos, and shipping both shards (CJK + no_CJK) is larger than the
         combined file. See DatePickerInternationalizationExample / TurkeyTestExample / SelectUsageExample. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <_AggressiveAttributeTrimming>false</_AggressiveAttributeTrimming>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MudBlazor.Docs\MudBlazor.Docs.csproj" />
  </ItemGroup>

</Project>
